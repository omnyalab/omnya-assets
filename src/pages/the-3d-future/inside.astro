        <p class="snote">Everyone in the club sees it. I look at every post and write to you privately with what works and what I'd change.</p>`)
      const f = $('[data-fimg]'), err = $('[data-ferr]'), cap = $('[data-fcap]')
      f.addEventListener('change', () => { const x = f.files && f.files[0]; if (!x) return; err.textContent = 'Getting your photo ready…'; err.className = 'ferr ok'
        shrink(x).then(r => { st.img = r.data; st.w = r.w; st.h = r.h; st.cap = cap.value; two() }).catch(() => { err.className = 'ferr'; err.textContent = 'That photo did not open, try a JPG or PNG' }) })
      $('[data-fback]').addEventListener('click', () => { st.cap = cap.value; one() })
