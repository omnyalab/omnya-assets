---
// Studio: how we work, told with our own pictures.
// 1. opening: two studios, one team, the globe (drag it)
// 3. from model to image: one frame, four stages (pinned and scrubbed on desktop,
//    self-running on touch, a still grid with reduced motion)
// 4. what we make, 5. timings (dark), 6. made with AI, 7. kit, 8. websites line
// 9. the closing card shared by every page
// Animations: src/scripts/studio.ts. Images: public/studio (each with a _mobile copy).
import Base from '../layouts/Base.astro';
import Duo from '../components/Duo.astro';
import Arrow from '../components/Arrow.astro';
import EndCta from '../components/EndCta.astro';
import { pad, type Still } from '../lib/data';
import { srcset } from '../lib/media';
import { kit } from '../lib/kit';
import { contact } from '../lib/contact';
import { t, langFromPath, localize } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const S = T.studio;

const still = (name: string, w: number, h: number, dir = 'studio'): Still => ({
  src: `/${dir}/${name}.webp`,
  mobile: `/${dir}/${name}_mobile.webp`,
  w,
  h,
  orientation: w >= h ? 'horizontal' : 'vertical',
});



// From the plan to the final image (2/11): Burtville's living room, the designer's plan, our 3D, the final photo.
// Portrait pictures on desktop (4:5 cards), landscape on phones (16:10). The plan: scripts/plan-burtville.py
const steps = [
  { p: '/studio/plan_burt_living_p.webp', l: '/studio/plan_burt_living.webp' },
  { p: '/learn/burt_living_white_mobile.webp', l: '/learn/burt_living_white.webp' },
  { p: '/learn/burt_living_real_mobile.webp', l: '/learn/burt_living_real.webp' },
];
const files = kit(lang);
// The three playbooks sit on the table next to the portfolio, as books; they lead to Learn
const L = T.learn;
const books = L.books.map((b) => ({
  id: b.id,
  name: `${b.a} ${b.b}`,
  price: b.price,
  cover: { src: `/studio/book_${b.id}_${lang}.webp`, mobile: `/studio/book_${b.id}_${lang}_mobile.webp`, w: 900, h: 1200 },
}));
const webMail = `mailto:${contact.email}?subject=${encodeURIComponent(S.webSubject)}`;
---

<Base page="studio" title={S.title} description={S.description}>
  <!-- 1. Opening (2/11): two studios, one team, the globe between Venice and Dubai -->
  <section class="st-intro st-globe wrap">
    <Duo as="h1" size="h1" class="st-intro__title" a={S.introA} b={S.introB} intro />
    <div class="st-globe__box" data-globe>
      <div class="st-globe__ball">
        <canvas aria-label={S.globeAlt}></canvas>
        <span class="st-globe__pin" data-pin="venice">{T.venice}</span>
        <span class="st-globe__pin" data-pin="dubai">{T.dubai}</span>
      </div>
    </div>
    <p class="st-intro__txt t-sub" data-fade>{S.introLine}</p>
  </section>

  <!-- 3. From your model to the final image (C): three pictures of the same room, the step on each -->
  <section class="sc-steps wrap" aria-labelledby="steps-title">
    <h2 class="t-h2 sc-title" id="steps-title" data-split>{S.stagesA}{' '}<span class="mute">{S.stagesB}</span></h2>
    <ol class="sc-steps__row">
      {
        steps.map((st, i) => (
          <li class="sc-step" data-fade>
            <picture>
              <source media="(min-width: 900px)" data-srcset={st.p} />
              <img data-src={st.l} width="1600" height="1000" alt={S.stepsAlt[i]} decoding="async" />
            </picture>
            <span class="sc-step__tag"><span class="sc-step__n">{pad(i + 1)}</span> {S.stepsC[i]}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 4. What we make, then how long it takes (C): big words, one line each, the timings in one band -->
  <section class="sc-make wrap" aria-labelledby="make-title" data-times>
    <h2 class="t-h2 sc-title" id="make-title" data-split>{S.makeA}</h2>
    <ul class="sc-make__list">
      {
        S.makeList.map((m) => (
          <li class="sc-make__row" data-fade>
            <span class="sc-make__name">{m.name}</span>
            <span class="sc-make__text">{m.text}</span>
          </li>
        ))
      }
    </ul>
    <ul class="times__list sc-times pfig" data-play aria-label={`${S.timeA} ${S.timeB}`}>
      {
        S.timings.map((tm) => (
          <li class="sc-times__item">
            <span class="sc-times__n pfig__n">
              <span class="sr-only">{tm.n.join('–')}</span>
              <span aria-hidden="true">{tm.n.map((d, i) => (<>{i > 0 && '–'}<span data-count={d}>{d}</span></>))}</span>
            </span>
            <span class="sc-times__l pfig__l">{tm.label.replace('*', '')}</span>
          </li>
        ))
      }
    </ul>
    <a href={localize('/pricing', lang)} class="btn btn--fill sc-make__btn" data-fade>{S.seePrices} <Arrow /></a>
  </section>

  <!-- 7. Kit -->
  <section class="kit wrap" id="kit" aria-labelledby="kit-title">
    <div class="kit__copy">
      <h2 class="t-h2 kit__title" id="kit-title" data-split>{S.kitA}{' '}<span class="mute">{S.kitB}</span></h2>
      <p class="t-sub kit__text" data-fade>{S.kitText}</p>
      <a class="btn btn--fill kit__btn" href={`${localize('/learn', lang)}#books`} data-fade>{L.heroBooks} <Arrow /></a>
    </div>
    <ul class="kit__cards" data-kit data-load-group data-hbar>
      {
        files.map((f) => (
          <li class:list={['kit__item', { 'kit__item--tall': f.cover.h > f.cover.w }]} style={`--ar: ${f.cover.w} / ${f.cover.h}`}>
            <span class="kit__chip kit__chip--free" aria-hidden="true">{T.kit.free}</span>
            <a class="kit__card" href={f.href} download={f.file} tabindex="-1" aria-hidden="true">
              <img data-src={f.cover.mobile} data-srcset={srcset(f.cover as Still)} sizes="(min-width: 900px) 30vw, 70vw" width={f.cover.w} height={f.cover.h} alt="" decoding="async" />
            </a>
            <div class="kit__meta">
              <span class="kit__name">{f.name}</span>
              <a class="kit__dl u" href={f.href} download={f.file}>{S.download}<span class="sr-only"> {f.name}, PDF, {f.size}</span> <Arrow /></a>
            </div>
          </li>
        ))
      }
      {
        books.map((b) => (
          <li class="kit__item kit__item--tall kit__item--book" style={`--ar: ${b.cover.w} / ${b.cover.h}`}>
            <span class="kit__chip" aria-hidden="true">{b.price}</span>
            <a class="kit__card" href={`${localize('/learn', lang)}#books`} tabindex="-1" aria-hidden="true">
              <img data-src={b.cover.mobile} data-srcset={`${b.cover.mobile} 540w, ${b.cover.src} 900w`} sizes="(min-width: 900px) 19vw, 70vw" width={b.cover.w} height={b.cover.h} alt="" decoding="async" />
            </a>
            <div class="kit__meta">
              <span class="kit__name">{b.name}</span>
              <a class="kit__dl kit__dl--buy u" href={`${localize('/learn', lang)}#books`}>{L.get}<span class="sr-only"> {b.name}, {b.price}</span> <Arrow /></a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 9. The standard closing card -->
  <EndCta />
</Base>
