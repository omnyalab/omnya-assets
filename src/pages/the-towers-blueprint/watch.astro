<script is:inline>
const q = new URLSearchParams(location.search), v = q.get('btn') || 'b1'
if (v === 'b2' || v === 'b4') document.body.classList.add('withprice')
if (v === 'b3' || v === 'b4') document.body.classList.add('yellow')
let end; try { end = +localStorage.getItem('omnya_end') } catch (e) {}
if (!end || end < Date.now() - 864e5) { end = Date.now() + 15 * 60e3; try { localStorage.setItem('omnya_end', end) } catch (e) {} }
const pad = n => String(n).padStart(2, '0')
function tick() {
  const ms = Math.max(0, end - Date.now()), h = Math.floor(ms / 36e5), m = Math.floor(ms / 6e4) % 60, s = Math.floor(ms / 1e3) % 60
  document.querySelector('[data-h]').textContent = pad(h); document.querySelector('[data-m]').textContent = pad(m); document.querySelector('[data-s]').textContent = pad(s)
  document.querySelector('[data-t2]').innerHTML = `${pad(h)}<i>:</i>${pad(m)}<i>:</i>${pad(s)}`
  document.querySelector('[data-t3]').textContent = `${pad(h)}:${pad(m)}:${pad(s)}`
}
tick(); setInterval(tick, 1000)
const bar = document.querySelector('.bar'), top0 = document.querySelector('[data-t2]')
new IntersectionObserver(([e]) => bar.classList.toggle('show', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(top0)
const vsl = document.querySelector('[data-vsl]'), vv = vsl.querySelector('video')
vsl.querySelector('[data-unm]').addEventListener('click', () => { vv.muted = false; vv.currentTime = 0; vv.play(); vsl.classList.add('on') })
const reels = [...document.querySelectorAll('.reel')]; let ri = 1
setInterval(() => { if (innerWidth < 820) return; reels[ri].classList.remove('on'); ri = (ri + 1) % reels.length; reels[ri].classList.add('on'); document.querySelectorAll('[data-dots] i').forEach((d, i) => d.classList.toggle('on', i === ri)) }, 3000)
const P = { full: ['€5.99', '-79%', 'The Full Guide'], scene: ['€17.99', '', 'Full Guide + 3D scene'], all: ['€59', '-75%', 'Everything we teach'] }
document.querySelectorAll('.opt').forEach(o => o.addEventListener('click', () => {
  const k = o.dataset.o
  document.querySelectorAll('.opt').forEach(x => x.classList.toggle('on', x === o))
  document.querySelectorAll('.pane').forEach(p => p.classList.toggle('on', p.dataset.p === k))
  document.querySelector('[data-pr]').textContent = P[k][0]
  document.querySelector('[data-pay]').innerHTML = k === 'full' ? `Pay ${P[k][0]} · Get ${P[k][2]}` : `Pay ${P[k][0]}<small>Get ${P[k][2]}</small>`
}))
const io = new IntersectionObserver(es => es.forEach(e => {
  if (!e.isIntersecting) return; io.unobserve(e.target)
  const el = e.target, to = +el.dataset.count, suf = el.dataset.suf, t0 = performance.now()
  const f = t => { const k = Math.min(1, (t - t0) / 1400), n = Math.round(to * (1 - Math.pow(1 - k, 3))); el.textContent = n.toLocaleString('en-US') + suf; if (k < 1) requestAnimationFrame(f) }
  requestAnimationFrame(f)
}), { threshold: .6 })
document.querySelectorAll('[data-count]').forEach(el => io.observe(el))

// the player: pause, seek, time, sound, full screen
const fmt = t => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}`
vsl.classList.add('muted')
vv.addEventListener('loadedmetadata', () => { document.querySelector('[data-dur]').textContent = fmt(vv.duration) })
vv.addEventListener('timeupdate', () => { const k = vv.duration ? vv.currentTime / vv.duration : 0; document.querySelector('[data-fill]').style.width = (k * 100) + '%'; document.querySelector('[data-knob]').style.left = (k * 100) + '%'; document.querySelector('[data-tt]').textContent = fmt(vv.currentTime) })
const toggle = () => { if (vv.paused) { vv.play() } else { vv.pause() } }
vv.addEventListener('play', () => vsl.classList.remove('paused')); vv.addEventListener('pause', () => vsl.classList.add('paused'))
vv.addEventListener('click', () => { if (vsl.classList.contains('on')) toggle() })
document.querySelector('[data-pp]').addEventListener('click', toggle)
document.querySelector('[data-mu]').addEventListener('click', () => { vv.muted = !vv.muted; vsl.classList.toggle('muted', vv.muted) })
document.querySelector('[data-fs]').addEventListener('click', () => { if (vv.requestFullscreen) vv.requestFullscreen(); else if (vv.webkitEnterFullscreen) vv.webkitEnterFullscreen() })
const sk = document.querySelector('[data-sk]')
const seekTo = e => { const r = sk.getBoundingClientRect(), x = (e.touches ? e.touches[0].clientX : e.clientX) - r.left; if (vv.duration) vv.currentTime = Math.max(0, Math.min(1, x / r.width)) * vv.duration }
sk.addEventListener('pointerdown', e => { seekTo(e); sk.setPointerCapture(e.pointerId); sk.onpointermove = seekTo; sk.onpointerup = () => { sk.onpointermove = null } })
// unmuting goes through the same state
vsl.querySelector('[data-unm]').addEventListener('click', () => { vsl.classList.remove('muted'); vv.loop = false })
// carousel dots follow the scroll
const tr = document.querySelector('.track'), dots = [...document.querySelectorAll('[data-dots] i')]
tr.addEventListener('scroll', () => { const n = reels.length, k = Math.round(tr.scrollLeft / Math.max(1, tr.scrollWidth - tr.clientWidth) * (n - 1)); dots.forEach((d, i) => d.classList.toggle('on', i === k)) }, { passive: true })
dots.forEach((d, i) => d.addEventListener('click', () => { if (innerWidth < 820) reels[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }) }))

// the site: who just left their email (OptIn keeps it for this tab only), the real Stripe Checkout, the link as a fallback
const LINK = {'full': 'https://buy.stripe.com/28E00i2Kp4g04lEbmB8so0E', 'scene': 'https://buy.stripe.com/7sY3cu2KpbIsaK2duJ8so0H', 'all': 'https://buy.stripe.com/5kQcN4bgVbIs6tMeyN8so0C'}, PID = {'full': 'full-towers', 'scene': 'full-towers-scene', 'all': 'everything'}
let who = {}; try { who = JSON.parse(sessionStorage.getItem('omnya-watch') || '{}') } catch (e) {}
const em = document.querySelector('[data-em]'), cn = document.querySelector('[data-cn]')
if (who.email) { em.value = who.email; document.querySelector('[data-emw]').classList.add('have') }
let cur = 'full', ec = null, busy = false
const ecBox = document.querySelector('[data-ec]'), right = document.querySelector('.right')
function payLink() { const e = em.value.trim(); location.href = LINK[cur] + (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e) ? '?prefilled_email=' + encodeURIComponent(e) : '') }
document.querySelector('[data-pay]').addEventListener('click', payLink)
function loadStripe() { return window.Stripe ? Promise.resolve() : new Promise((ok, no) => { const sc = document.createElement('script'); sc.src = 'https://js.stripe.com/endive/stripe.js'; sc.onload = ok; sc.onerror = no; document.head.appendChild(sc) }) }
// 13/11 (Nico): the Stripe fields inside OUR checkout, black and blue like the board, our own Pay button
const LOOK = { theme: 'night', inputs: 'condensed', labels: 'above', variables: { colorPrimary: '#0a84ff', colorBackground: '#0b1224', colorText: '#ffffff', colorTextSecondary: '#c9d2e3', colorTextPlaceholder: '#6b7385', colorDanger: '#ff6b6b', fontFamily: 'Inter, system-ui, sans-serif', fontSizeBase: '16px', borderRadius: '10px', spacingUnit: '4px' },
  rules: { '.Input': { border: '1px solid #2b3550', boxShadow: 'none' }, '.Input:focus': { border: '1px solid #0a84ff', boxShadow: '0 0 0 3px #0a84ff40' }, '.Label': { color: '#e6ebf5', fontWeight: '500', fontSize: '14px' } } }
const payBtn = document.querySelector('[data-pay]'), perr = document.querySelector('[data-perr]')
let actions = null, pel = null
payBtn.removeEventListener('click', payLink)
payBtn.addEventListener('click', async () => {
  if (!actions) return payLink()
  const e = em.value.trim(); perr.textContent = ''
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e)) { document.querySelector('[data-emw]').classList.remove('have'); perr.textContent = 'Write your email so we can send you the guide'; em.focus(); return }
  payBtn.disabled = true
  try {
    const n = cn.value.trim()
    if (n.length < 2) { payBtn.disabled = false; perr.textContent = 'Write the name on your card'; cn.focus(); return }
    const u = await actions.updateEmail(e); if (u && u.type === 'error') throw u.error
    const nm = await actions.updateIndividualName(n); if (nm && nm.type === 'error') throw nm.error
    const r = await actions.confirm(); if (r && r.type === 'error') throw r.error
  } catch (x) { perr.textContent = (x && x.message) || 'Payment did not go through, try again' }
  payBtn.disabled = false
})
let again = false
async function mount() {
  if (busy) { again = true; return } busy = true
  try {
    if (pel) { try { pel.destroy() } catch (e) {} pel = null }
    actions = null; ecBox.className = 'ec load'
    const r = await fetch('/api/embed-checkout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ p: PID[cur], card: true }) })
    if (!r.ok) throw new Error('no session')
    const d = await r.json(); await loadStripe()
    const st = window.Stripe(d.pk)
    let co = st.initCheckoutElementsSdk({ clientSecret: d.cs, elementsOptions: { appearance: LOOK, fonts: [{ cssSrc: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap' }] } })
    if (co && co.then) co = await co
    const res = await co.loadActions(); if (res.type !== 'success') throw new Error('no actions')
    pel = co.createPaymentElement({ layout: 'tabs', wallets: { link: 'never' } })
    const cbr = document.querySelector('[data-cbr]'); pel.on('change', ev => cbr.classList.toggle('off', !ev.empty)); ecBox.className = 'ec'; pel.mount(ecBox)
    actions = res.actions; right.classList.add('live')
  } catch (e) { console.warn('[checkout]', e); ecBox.className = 'ec'; right.classList.remove('live'); actions = null }
  busy = false; if (again) { again = false; mount() }
}
// 13/11 (Nico): the price and the clock appear at 33.5 s, when the video says the price (muted pass or with sound)
{ let rv = false; const reveal = () => { if (rv) return; rv = true; document.body.classList.add('rv') }
  document.querySelectorAll('a[href="#offer"]').forEach(x => x.addEventListener('click', e => { if (!rv) { e.preventDefault(); reveal(); requestAnimationFrame(() => document.querySelector('#offer').scrollIntoView({ behavior: 'smooth' })) } }))
  vv.addEventListener('timeupdate', () => { if (vv.currentTime >= 33.5) reveal() }); vv.addEventListener('ended', reveal)
  setInterval(() => { const m = document.querySelector('[data-m]'), s2 = document.querySelector('[data-s]'), t = document.querySelector('.rvt'); if (m && s2 && t) t.textContent = m.textContent + ':' + s2.textContent }, 500) }
document.querySelectorAll('.opt').forEach(o => o.addEventListener('click', () => { cur = o.dataset.o; if (right.classList.contains('live') || ecBox.classList.contains('load') || busy) mount() }))
const offerIo = new IntersectionObserver(([e]) => { if (e.isIntersecting) { offerIo.disconnect(); mount() } }, { rootMargin: '600px 0px' })
offerIo.observe(document.querySelector('#offer'))
</script>
