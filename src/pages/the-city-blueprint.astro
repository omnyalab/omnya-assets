---
// /the-city-blueprint (5/11/2026, Omnya City reel): the funnel for "I'm giving every follower a free house".
// Built like /3d-to-film and /the-tower-blueprint (Montserrat, Apple blue, black, no site header), with bigger
// buttons on the first screen (Nico: "fai bene i pulsanti") and a sticky bar on phones.
// Free blueprint first (3 real prompts), the Full one right under it at €5.99 (written in the page, 10/11: the launch price and its switch are gone),
// then the five steps, who it is for, questions and the last call.
// Images are renders of the real city (public/city) and frames of the reel; the PDFs are built in
// ~/Desktop/Omnya City Blueprint (free/build_free.py, full/build_full.py).
import Base from '../layouts/Base.astro';
import { goHref } from '../lib/learn';

const free = goHref('free-city', 'en');
const full = goHref('full-city', 'en');
// 10/11 (Nico): the free PDF only after the email, like the other funnels. This page has no /sent page,
// so after the email the card goes away and the page opens on the Full guide (#full).
import OptIn from '../components/OptIn.astro';
---

<Base page="learn" header={false} footer={false} title="How to build a 3D city that goes viral with AI" description="Steal our city method: the free blueprint with the three real prompts behind Omnya City, and the Full Blueprint with every prompt and every file." og="/city/og.jpg">
<div class="x3">
<OptIn slug="the-city-blueprint" free="free-city" word="City" noClose watch="/the-city-blueprint/watch" after="#full" cover="/learn/ct_cover_free.webp" hero="/learn/ct_hero.webp" heroMobile="/learn/ct_hero_mobile.webp" />

<section class="x3-hero" id="top">
  <picture class="x3-hero__bg"><source media="(max-width:899px)" srcset="/learn/ct_hero_mobile.webp"><img src="/learn/ct_hero.webp" width="2000" height="1117" alt="Omnya City downtown: villas on two lots, palms, a red supercar outside" fetchpriority="high"></picture>
  <div class="x3-in">
    <div>
      <p class="x3-kick">Free blueprint</p>
      <h1 class="x3-T">Steal our<br><span class="x3-box">city</span><br>method</h1>
      <p class="x3-lead"><b>The 3D city behind our free house reel, built by Claude from three prompts.</b> Grab them free.</p>
      <div class="ct-ctas">
        <a class="ct-free" href={free} target="_blank" rel="noopener"><span><b>Grab the free blueprint</b><small>PDF · the 3 prompts behind the city</small></span><i>↓</i></a>
        <a class="ct-full" href="#full">Get the Full one<em>€5.99</em></a>
      </div>
      <p class="ct-proof"><span>No SketchUp</span><span>No Blender</span><span>Runs on a phone</span></p>
    </div>
    <img class="x3-hero__cover" src="/learn/ct_cover_free.webp" width="700" height="1244" alt="The free blueprint cover">
  </div>
</section>

<section class="x3-deal" id="full">
  <div class="x3-deal__glow" aria-hidden="true"></div>
  <div class="x3-in">
    <div class="x3-card">
      <div class="x3-card__book"><div class="x3-card__halo" aria-hidden="true"></div><img src="/learn/ct_book.webp" width="600" height="700" alt="The Full City Blueprint, the book" loading="lazy"></div>
      <div class="x3-card__body">
        <p class="x3-kick">Everything you get</p>
        <h2 class="x3-T">How to build a 3D city<br><span class="x3-box">that goes viral</span></h2>
        <ul class="x3-vs">
          <li><i></i><div><b>The Full Blueprint</b><span>nine chapters, from the first prompt to the live map</span></div><em>Included</em></li>
          <li><i></i><div><b>Every prompt, word for word</b><span>the city, the houses, the reel, the site</span></div><em>Included</em></li>
          <li><i></i><div><b>The fast way</b><span>a prompt that hands the whole PDF to Claude Code</span></div><em>Included</em></li>
          <li><i></i><div><b>The DM machine</b><span>ManyChat flow, one-time links, the reserve code</span></div><em>Included</em></li>
          <li><i></i><div><b>The money</b><span>the offers under every house, and how to adapt it to your brand</span></div><em>Included</em></li>
        </ul>
        <div class="x3-pay">
          <div class="x3-pay__price"><b>€5.99</b><s>€29</s></div>
          <a class="x3-cta" href={full}><span>Get the Full Blueprint</span><i>→</i></a>
        </div>
        <p class="x3-pay__note">These prices are only available on this page. The PDF arrives by email right after payment. Something wrong with your files? <a href="mailto:info@omnyalab.com">Write us</a> and we fix it.</p>
      </div>
    </div>
  </div>
</section>

<section class="x3-sec" id="free">
  <div class="x3-in x3-free">
    <div>
      <p class="x3-kick">The free blueprint</p>
      <h2 class="x3-T">Five steps<br><span class="x3-box">three prompts</span></h2>
      <ol class="x3-steps">
        <li class="x3-step"><img src="/learn/ct_city.webp" alt="" loading="lazy"><div><b><i>01</i>The city in code</b><span>Claude Code writes the whole town in three.js: villas downtown, trailers and shacks in the suburbs. It starts from prompt 1.</span></div></li>
        <li class="x3-step"><img src="/learn/ct_cozy.webp" alt="" loading="lazy"><div><b><i>02</i>Make it cozy</b><span>Our frame next to the reel we were matching, and one question: what's the difference? Windows, chimneys, one sun.</span></div></li>
        <li class="x3-step"><img src="/learn/ct_username.webp" alt="" loading="lazy"><div><b><i>03</i>Your username, your house</b><span>The name becomes the seed: same name, same house, no two alike. Prompt 2.</span></div></li>
        <li class="x3-step"><img src="/learn/ct_reel.webp" alt="" loading="lazy"><div><b><i>04</i>The reel</b><span>Rendered frame by frame from the browser, every move on the word, never a still scene. Prompt 3.</span></div></li>
        <li class="x3-step"><img src="/learn/ct_downtown.webp" alt="" loading="lazy"><div><b><i>05</i>The comment becomes a house</b><span>ManyChat sends a one-time link, the house appears on the map, the offers sit under it.</span></div></li>
      </ol>
      <div class="ct-ctas"><a class="ct-free" href={free} target="_blank" rel="noopener"><span><b>Steal the 3 prompts</b><small>Free PDF, made for your phone</small></span><i>↓</i></a></div>
    </div>
    <img class="x3-free__cover" src="/learn/ct_cover_free.webp" width="700" height="1244" alt="The free blueprint cover" loading="lazy">
  </div>
</section>

<section class="x3-sec">
  <div class="x3-in x3-two">
    <div>
      <p class="x3-kick">It's for you if</p>
      <h2 class="x3-T">You want comments<br><span class="x3-box">not likes</span></h2>
      <ul class="x3-ticks">
        <li>You sell homes, plots, rooms or a place, and you want people to claim a piece of it.</li>
        <li>You want a reel where every comment is a follower and every follower a name on your map.</li>
        <li>You already use Claude and want the whole method, code and DMs included, in one place.</li>
      </ul>
    </div>
    <div>
      <p class="x3-kick">Questions</p>
      <h2 class="x3-T">Before<br><span class="x3-box">you start</span></h2>
      <div class="x3-faq">
        <details><summary>Do I need to know how to code?</summary><p>No. Claude Code writes every file. You read the result in the browser and correct it in plain words, like we did.</p></details>
        <details><summary>What tools does it use?</summary><p>Claude Code for the city, the reel page and the site, ElevenLabs for the voice, ManyChat for the comments and the DMs, Vercel and Upstash for the live map, all on free or starter plans.</p></details>
        <details><summary>Will it work on phones?</summary><p>Yes. Most people open it from the DM, so the city draws half the detail on phones and stays the same city on every device.</p></details>
        <details><summary>When do I get the Full one?</summary><p>Right after payment, on the next page.</p></details>
        <details><summary>Can you build it for my brand?</summary><p>Yes. Write to us with your project and we tell you the price before we start.</p></details>
      </div>
    </div>
  </div>
</section>

<section class="x3-sec x3-end">
  <div class="x3-in">
    <p class="x3-kick">Your followers want a house</p>
    <h2 class="x3-T">Build<br><span class="x3-box">your city</span></h2>
    <div class="x3-ctas"><a class="x3-btn x3-btn--blue" href={full}>Get the Full Blueprint →</a><a class="x3-btn x3-btn--line" href={free} target="_blank" rel="noopener">Start with the free one</a></div>
    <p class="x3-small">Or see what we build, <a href="/demo/choose-your-floor/" data-astro-reload>try the free demo</a>.</p>
  </div>
</section>

<p class="x3-foot">OMNYA LAB</p>
<nav class="ct-bar" aria-label="Get the blueprint" data-bar><a class="a" href={free} target="_blank" rel="noopener">Free blueprint ↓</a><a class="b" href="#full">Full €5.99</a></nav>
</div>
<script is:inline>
  // the bar on phones shows once the first buttons are out of sight
  (function () {
    const bar = document.querySelector('[data-bar]'), hero = document.querySelector('.x3-hero .ct-ctas');
    if (!bar || !hero || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(([e]) => bar.classList.toggle('on', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(hero);
  })();
</script>
</Base>

<style is:global>
@font-face{font-family:Montserrat;src:url(/fonts/montserrat-latin.woff2) format("woff2");font-weight:500 900;font-display:swap}
.x3{--bg:#05070a;--bg2:#0d1117;--ink:#fff;--mute:rgba(255,255,255,.66);--line:rgba(255,255,255,.14);--blue:#2997ff;--blue2:#0071e3;background:var(--bg);color:var(--ink);font-family:Montserrat,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;overflow:hidden}
:where(.x3) *{box-sizing:border-box}
:where(.x3) img,:where(.x3) video{display:block;max-width:100%;height:auto}
:where(.x3) a{color:inherit}
.x3-in{max-width:1180px;margin:0 auto;padding:0 max(16px,4vw)}

/* strap */
.x3-strap{position:relative;z-index:20;display:block;text-decoration:none;background:var(--blue);color:#fff;text-align:center;font-weight:800;font-size:13px;letter-spacing:.18em;text-transform:uppercase;padding:13px 16px}
.x3-strap a{text-decoration:none}

/* big titles, the cover language */
.x3-T{margin:0;font-weight:900;text-transform:uppercase;line-height:.92;letter-spacing:-.01em;text-wrap:balance}
.x3-T .x3-box{display:inline-block;white-space:nowrap;font-size:.72em;margin-top:.16em;border:.075em solid #fff;padding:.1em .32em .04em;font-weight:700;letter-spacing:.14em;text-indent:.14em;line-height:1}
.x3-T .b{color:var(--blue)}
.x3-kick{margin:0 0 14px;font-weight:800;font-size:clamp(14px,1.3vw,17px);letter-spacing:.2em;text-transform:uppercase;color:var(--blue)}
.x3-lead{margin:22px 0 0;font-weight:500;font-size:clamp(17px,1.5vw,20px);line-height:1.5;color:var(--mute);max-width:620px}
.x3-lead b{color:#fff;font-weight:700}

/* buttons */
.x3-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.x3-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:58px;padding:0 28px;border-radius:999px;font-weight:800;font-size:16px;letter-spacing:.06em;text-transform:uppercase;text-decoration:none}
.x3-btn--blue{background:var(--blue);color:#fff;box-shadow:0 18px 40px -18px rgba(41,151,255,.9)}
.x3-btn--white{background:#fff;color:#05070a}
.x3-btn--line{border:2px solid rgba(255,255,255,.5);color:#fff}
.x3-small{margin:14px 0 0;font-weight:600;font-size:14px;color:var(--mute)}
.x3-small a{color:#fff}

/* hero */
.x3-hero{position:relative;min-height:min(92vh,900px);display:flex;align-items:flex-end;overflow:hidden}
.x3-hero__bg,.x3-hero__bg img{position:absolute;inset:0;width:100%;height:100%}
.x3-hero__bg img{object-fit:cover;object-position:55% 50%}
.x3-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,7,10,.82) 0%,rgba(5,7,10,.45) 45%,rgba(5,7,10,0) 70%),linear-gradient(180deg,rgba(5,7,10,.6) 0%,rgba(5,7,10,0) 30%,rgba(5,7,10,0) 60%,rgba(5,7,10,.9) 88%,var(--bg) 100%)}
@media (max-width:899px){.x3-hero::after{background:linear-gradient(180deg,rgba(5,7,10,.55) 0%,rgba(5,7,10,.1) 25%,rgba(5,7,10,.35) 45%,rgba(5,7,10,.92) 75%,var(--bg) 100%)}}
.x3-hero .x3-in{position:relative;z-index:2;width:100%;padding-top:120px;padding-bottom:64px;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end}
.x3-hero .x3-kick{display:inline-block;background:var(--blue);color:#fff;padding:8px 14px;border-radius:999px;margin-bottom:20px}
.x3-hero .x3-T{font-size:clamp(58px,7.2vw,112px)}
.x3-hero__cover{width:230px;transform:rotate(3deg);border-radius:6px;box-shadow:0 40px 80px -20px rgba(0,0,0,.9),0 0 0 1px rgba(255,255,255,.08)}
.labels{position:absolute;z-index:2;top:22%;left:0;right:0;display:flex;justify-content:space-between;padding:0 max(16px,4vw);pointer-events:none}
.labels span{background:rgba(5,7,10,.6);backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:999px;padding:8px 16px;font-weight:700;font-size:13px;letter-spacing:.14em;text-transform:uppercase}

/* sections */
.x3-sec{padding:clamp(72px,10vw,130px) 0;border-top:1px solid var(--line)}
.x3-sec .x3-T{font-size:clamp(40px,5.4vw,78px)}
.sec--blue{background:var(--blue2)}
.sec--blue .x3-kick{color:#fff;opacity:.8}

/* pairs */
.x3-pairs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:48px}
.x3-pair{margin:0}
.x3-pair__ab{position:relative;aspect-ratio:4/5;border-radius:18px;overflow:hidden;background:#111}
.x3-pair__ab img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.x3-pair__ab img+img{clip-path:inset(0 0 0 50%)}
.x3-pair__ab::after{content:"";position:absolute;top:0;bottom:0;left:50%;width:3px;margin-left:-1.5px;background:#fff}
.x3-tag{position:absolute;z-index:2;bottom:14px;background:rgba(5,7,10,.65);backdrop-filter:blur(8px);border-radius:999px;padding:6px 12px;font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase}
.x3-tag--a{left:14px}.x3-tag--b{right:14px}
.x3-pair figcaption{margin-top:12px;font-weight:700;font-size:15px;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}

/* free block */
.x3-free{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:clamp(32px,6vw,90px);align-items:center}
.x3-free__cover{width:100%;max-width:360px;border-radius:8px;box-shadow:0 50px 90px -30px rgba(0,0,0,.95),0 0 0 1px rgba(255,255,255,.08);transform:rotate(-2deg)}
.x3-steps{list-style:none;margin:40px 0 0;padding:0;display:grid;gap:14px}
.x3-step{display:grid;grid-template-columns:120px 1fr;gap:18px;align-items:center;background:var(--bg2);border:1px solid var(--line);border-radius:18px;padding:12px}
.x3-step img{width:120px;height:90px;object-fit:cover;border-radius:10px}
.x3-step b{display:block;font-weight:800;font-size:17px;text-transform:uppercase;letter-spacing:.02em}
.x3-step b i{font-style:normal;color:var(--blue);margin-right:8px}
.x3-step span{display:block;margin-top:6px;font-weight:500;font-size:15px;line-height:1.45;color:var(--mute)}

/* offer */
.offer{display:grid;grid-template-columns:420px minmax(0,1fr);gap:clamp(32px,6vw,90px);align-items:center}
.book{position:relative;width:100%;max-width:420px;perspective:1600px}
.book__f{position:relative;transform:rotateY(-18deg) rotateX(2deg);transform-style:preserve-3d;border-radius:4px 8px 8px 4px;box-shadow:30px 50px 80px -20px rgba(0,0,0,.95)}
.book__f img{border-radius:4px 8px 8px 4px}
.book__f::before{content:"";position:absolute;top:1%;bottom:1%;right:-18px;width:20px;background:repeating-linear-gradient(90deg,#f1efe9 0 2px,#d9d5cc 2px 3px);transform:rotateY(70deg);transform-origin:left;border-radius:0 3px 3px 0}
.stack{list-style:none;margin:32px 0 0;padding:0;border-top:1px solid rgba(255,255,255,.3)}
.stack li{display:grid;grid-template-columns:28px 1fr;gap:12px;padding:16px 0;border-bottom:1px solid rgba(255,255,255,.3)}
.stack li::before{content:"✓";font-weight:900;font-size:18px}
.stack b{display:block;font-weight:800;font-size:17px;text-transform:uppercase;letter-spacing:.02em}
.stack span{display:block;margin-top:4px;font-weight:500;font-size:15px;opacity:.82}
.price{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-top:30px}
.price b{font-weight:900;font-size:clamp(52px,6vw,72px);letter-spacing:-.02em;line-height:1}
.price s{font-weight:700;font-size:26px;opacity:.6}
.price i{font-style:normal;background:#fff;color:var(--blue2);font-weight:900;font-size:15px;letter-spacing:.08em;padding:7px 12px;border-radius:999px}
.x3-deal{margin:10px 0 0;font-weight:700;font-size:15px;letter-spacing:.02em}

/* for you, faq */
.x3-two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,6vw,90px)}
.x3-ticks{list-style:none;margin:36px 0 0;padding:0}
.x3-ticks li{position:relative;padding:18px 0 18px 40px;border-bottom:1px solid var(--line);font-weight:600;font-size:18px;line-height:1.4}
.x3-ticks li::before{content:"";position:absolute;left:0;top:22px;width:22px;height:22px;border-radius:50%;background:var(--blue)}
.x3-faq{margin-top:36px}
.x3-faq details{border-bottom:1px solid var(--line)}
.x3-faq summary{cursor:pointer;list-style:none;padding:20px 40px 20px 0;position:relative;font-weight:800;font-size:17px;text-transform:uppercase;letter-spacing:.02em}
.x3-faq summary::-webkit-details-marker{display:none}
.x3-faq summary::after{content:"+";position:absolute;right:4px;top:14px;font-size:28px;color:var(--blue)}
.x3-faq details[open] summary::after{content:"−"}
.x3-faq p{margin:0 0 22px;font-weight:500;font-size:16px;line-height:1.55;color:var(--mute)}

/* offer card, funnel style */
.x3-deal{position:relative;padding:clamp(56px,6vw,90px) 0 clamp(80px,10vw,130px);overflow:hidden}
.x3-deal__glow{position:absolute;inset:0;background:radial-gradient(60% 50% at 25% 40%,rgba(41,151,255,.35),rgba(41,151,255,0) 70%),radial-gradient(40% 40% at 85% 80%,rgba(0,113,227,.28),rgba(0,113,227,0) 70%);pointer-events:none}
.x3-card{position:relative;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(24px,4vw,64px);align-items:center;padding:clamp(28px,4vw,64px);border-radius:36px;background:linear-gradient(155deg,rgba(18,40,78,.92) 0%,rgba(8,14,26,.96) 45%,rgba(5,7,10,.98) 100%);box-shadow:0 60px 120px -40px rgba(41,151,255,.45),inset 0 1px 0 rgba(255,255,255,.12)}
.x3-card::before{content:"";position:absolute;inset:0;border-radius:36px;padding:1.5px;background:linear-gradient(135deg,#2997ff,rgba(41,151,255,.1) 40%,rgba(255,255,255,.05) 70%,#2997ff);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
.x3-card__tab{position:absolute;left:50%;top:0;transform:translate(-50%,-50%);white-space:nowrap;background:linear-gradient(90deg,#0071e3,#2997ff);color:#fff;font-weight:800;font-size:14px;letter-spacing:.14em;text-transform:uppercase;padding:14px 24px;border-radius:999px;box-shadow:0 14px 34px -10px rgba(41,151,255,.9)}
.x3-card__book{position:relative;display:grid;place-items:center}
.x3-card__book img{position:relative;width:100%;max-width:460px;filter:drop-shadow(0 40px 50px rgba(0,0,0,.7))}
.x3-card__halo{position:absolute;width:80%;aspect-ratio:1;border-radius:50%;background:radial-gradient(rgba(41,151,255,.55),rgba(41,151,255,0) 65%);filter:blur(20px)}
.x3-card .x3-T{font-size:clamp(34px,3.8vw,58px)}
.x3-vs{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:10px}
.x3-vs li{display:grid;grid-template-columns:30px 1fr auto;gap:14px;align-items:center;padding:14px 16px;border-radius:16px;background:linear-gradient(90deg,rgba(255,255,255,.07),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.08)}
.x3-vs i{width:30px;height:30px;border-radius:50%;background:#2997ff;display:grid;place-items:center;box-shadow:0 0 18px rgba(41,151,255,.7)}
.x3-vs i::after{content:"";width:12px;height:7px;border-left:3px solid #fff;border-bottom:3px solid #fff;transform:rotate(-45deg) translate(1px,-1px)}
.x3-vs b{display:block;font-weight:800;font-size:16px;text-transform:uppercase;letter-spacing:.02em}
.x3-vs span{display:block;margin-top:3px;font-weight:500;font-size:14px;color:var(--mute)}
.x3-vs em{font-style:normal;font-weight:800;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#2997ff;background:rgba(41,151,255,.12);border:1px solid rgba(41,151,255,.35);padding:6px 10px;border-radius:999px}
.x3-pay{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-top:28px;padding:22px 24px;border-radius:22px;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.1)}
.x3-pay__price{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
