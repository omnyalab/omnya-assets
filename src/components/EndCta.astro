---
// The closing card of every page, before the footer (2/11): the live demo (10/11, it was the free image), a second way on, three works fanned out.
import Duo from './Duo.astro';
import Arrow from './Arrow.astro';
import { projects, slug } from '../lib/data';
import { t, langFromPath, localize, stripLang } from '../i18n';
import { demoHref } from '../lib/contact';

interface Props {
  /** The second button: the price list, or the work on the pricing page. */
  second?: 'pricing' | 'work';
}
const { second = 'pricing' } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
// Three pictures of our work fanned out, different on every page, only from the new projects and never the covers used on the books (2/11).
// Project pages use three more pictures of the same project.
const pic = (id: string, i: number) => projects.find((p) => p.id === id)?.gallery[i]?.mobile;
const sets: Record<string, Array<string | undefined>> = {
  '/': [pic('24_dana', 1), pic('17_the_townhall', 2), pic('25_casa_cresta', 1)],
  '/work': [pic('16_samar', 4), pic('25_casa_cresta', 6), pic('01_penthouse_dubai', 2)],
  '/studio': [pic('05_corfu_resort', 5), pic('17_the_townhall', 3), pic('24_dana', 3)],
  '/pricing': [pic('17_the_townhall', 5), pic('01_penthouse_dubai', 1), pic('05_corfu_resort', 1)],
  '/learn': [pic('05_corfu_resort', 2), pic('25_casa_cresta', 3), pic('24_dana', 5)],
};
const path = stripLang(Astro.url.pathname).replace(/\/$/, '') || '/';
const own = path.startsWith('/work/') ? projects.find((p) => path === `/work/${slug(p)}`) : undefined;
const fan = (own ? [own.gallery[2], own.gallery[3], own.gallery[4]].map((g) => g?.mobile) : sets[path] ?? sets['/'])
  .map((src, i) => src ?? projects[i].cover.mobile);
const link = second === 'work' ? { href: '/work', label: T.work.seeWork } : { href: '/pricing', label: T.work.prices };
---

<section class="wend wrap">
  <div class="wend__card">
    <div class="wend__copy">
      <Duo size="h2" class="wend__title" a={T.work.endA} b={T.work.endB} />
      <div class="wend__btns" data-fade>
        <a class="btn btn--fill" href={demoHref(lang)} data-astro-reload data-sample>{T.cta} <Arrow /></a>
        <a href={localize(link.href, lang)} class="btn">{link.label} <Arrow /></a>
      </div>
    </div>
    <span class="wend__fan" aria-hidden="true">
      {fan.map((src, i) => <img class={`wend__pic wend__pic--${i + 1}`} data-src={src} width="760" height="1000" alt="" decoding="async" />)}
    </span>
  </div>
</section>
