---
// 20/11 (Nico: "every funnel thanks page is black with the colour of its funnel, like the stadium page: black with red"):
// the thanks pages that were still light (Tower, Towers, 3D, City, Miami, the pack and the three playbooks) in the colours
// of their funnel. Same block as the violet one of views/Thanks.astro (Riyadh) and the ones scripts/make-*-ry.py made
// (Build, Stadium, Plane), recoloured here at build time the same way: the accent in place of the violet, and every violet
// tone of the block turned to the hue of the accent at 95% of its lightness (vrot of scripts/make-stadium-ry.py).
// accent = the --blue of that funnel's own watch page. head = keep the "only here" title over the offer card (the
// pages where an offer card still follows it); the pages with the club card hide it, as Riyadh, Build, Stadium, Plane do.
// The club card (components/RiyadhFuture.astro) and the upgrade card keep their own colours. is:inline: only on that page.
// One line more than the Riyadh block: the tick circles of the offer list in the accent (on --ink, now white, the white
// tick disappeared; the Riyadh-like pages have no offer list, these do).
interface Props {
  accent: string;
  head?: boolean;
}
const { accent, head = false } = Astro.props;

// Python's colorsys, so the colours come out the same as the scripts' ones
const rgbToHls = (r: number, g: number, b: number) => {
  const mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mn + mx) / 2;
  if (mx === mn) return [0, l, 0];
  const s = l <= 0.5 ? (mx - mn) / (mx + mn) : (mx - mn) / (2 - mx - mn);
  const rc = (mx - r) / (mx - mn), gc = (mx - g) / (mx - mn), bc = (mx - b) / (mx - mn);
  const h = r === mx ? bc - gc : g === mx ? 2 + rc - bc : 4 + gc - rc;
  return [(((h / 6) % 1) + 1) % 1, l, s];
};
const v = (m1: number, m2: number, h: number) => {
  h = ((h % 1) + 1) % 1;
  return h < 1 / 6 ? m1 + (m2 - m1) * h * 6 : h < 0.5 ? m2 : h < 2 / 3 ? m1 + (m2 - m1) * (2 / 3 - h) * 6 : m1;
};
const hlsToRgb = (h: number, l: number, s: number) => {
  if (s === 0) return [l, l, l];
  const m2 = l <= 0.5 ? l * (1 + s) : l + s - l * s, m1 = 2 * l - m2;
  return [v(m1, m2, h + 1 / 3), v(m1, m2, h), v(m1, m2, h - 1 / 3)];
};
const hex = (x: string) => [1, 3, 5].map((i) => parseInt(x.slice(i, i + 2), 16));
const to = (c: number[]) => '#' + c.map((n) => Math.floor(n * 255).toString(16).padStart(2, '0')).join('');
const HUE = rgbToHls(...(hex(accent).map((n) => n / 255) as [number, number, number]))[0];
const vrot = (x: string) => {
  const [r, g, b] = hex(x).map((n) => n / 255);
  const [h, l, s] = rgbToHls(r, g, b);
  return h >= 0.62 && h <= 0.9 && s > 0.12 ? to(hlsToRgb(HUE, l * 0.95, Math.min(1, s))) : x;
};

// the Riyadh block of views/Thanks.astro, #9d5cff = the accent
const block = `
  :root{--bg:#0b0714;--ink:#ffffff;--mute:#b6a9d4;--mute-lg:#9a8fb8;--line:#2a2240}
  html,body{background:radial-gradient(900px 600px at 50% -8%,#9d5cff33,#0000 70%),#0b0714!important;color:#fff}
  .oto .btn--fill,.oto-dl .btn--fill{background:#9d5cff!important;border-color:#9d5cff!important;color:#fff!important}
  .oto__steps .is-done span,.oto__steps .is-now span{background:#9d5cff!important;color:#fff!important;border-color:#9d5cff!important}
  .hdr .logo__img--dark{filter:invert(1)}
  .hdr::before{background:#0b0714e6!important;border-bottom-color:#2a2240!important}
  .hdr{color:#fff!important}
  .wa-fab{background:#9d5cff!important;color:#fff!important}
  html[data-page='thanks'] .oto-dl{background:linear-gradient(160deg,#ffffff1a,#ffffff08)!important;border:1px solid #ffffff26!important;-webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px);color:#fff!important;box-shadow:0 40px 80px -40px #9d5cffaa,inset 0 1px #ffffff33!important}
  html[data-page='thanks'] .oto-dl *{color:#fff}
  html[data-page='thanks'] .oto-dl .t-sub{color:#fff!important;-webkit-text-fill-color:#fff!important}
  html[data-page='thanks'] .oto-dl .oto-dl__note,html[data-page='thanks'] .oto-dl .oto-dl__note *{color:#b6a9d4!important}
  html[data-page='thanks'] .oto-dl .btn:not(.btn--fill){background:#ffffff14!important;border-color:#ffffff33!important;color:#fff!important}
  html[data-page='thanks'] .oto__down{background:#9d5cff!important}
  ${head ? '' : "html[data-page='thanks'] .oto__head{display:none}"}
  html[data-page='thanks'] .oto__card{background:#140b26!important;border:1px solid #2a2240;box-shadow:0 40px 70px -40px #9d5cff88!important;color:#fff}
  html[data-page='thanks'] .oto__card *{color:#fff}
  html[data-page='thanks'] .oto__card .t-sub,html[data-page='thanks'] .oto__card p{color:#cfc4e6}
  html[data-page='thanks'] .oto__items li::before{background:#9d5cff}
`;
const css = block.replace(/#9d5cff/g, accent).replace(/(#[0-9a-fA-F]{6})([0-9a-fA-F]{2})?\b/g, (_, c, a) => vrot(c) + (a || ''));
---
<style is:inline set:html={css}></style>
