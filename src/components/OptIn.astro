---
// E3 (7/11, chosen by Nico on the board): the card is open as soon as the page loads (Nico: "subito").
// Closing it shows the page; "Download the free blueprint" opens it again.
// Name + email, then the PDF goes by email (api/optin) and the visitor lands on /<page>/sent,
// the upsell. If the email can't be sent, the PDF opens right away instead, so nobody is stuck.
// 10/11 (Nico): the newsletter is its own box and starts empty. The blueprint email needs no box (it is what
// the form is for); "an update now and then" is optional, and only a ticked box puts the person in the
// newsletter (cv v3, api/_lib/newsletter.js). Sending the form marks this browser (localStorage
// omnya-optin-<free>): only then /go/<free> opens the PDF, otherwise it comes back to this card (views/Go.astro).
import '../styles/optin.css';
import '../styles/optin-build.css';
import AllSetOffer from './AllSetOffer.astro';

interface Props {
  slug: string; // the funnel page, e.g. the-tower-blueprint
  free: string; // the free product id, e.g. free-tower
  word: string; // FREE + this word in the box (Tower, Floor, 3D to film)
  small?: boolean; // a long word gets a smaller box
  cover: string; // the free PDF cover
  hero: string;
  heroMobile: string;
  book?: boolean; // 9/11 (Nico, Build page): the cover in book format (1000x1375) instead of the tall 9:16 PDF
  theme?: 'c1'; // 9/11 (Nico): C1 green on the Build page (src/styles/optin-build.css, made by scripts/recolor-build.py)
  fade?: boolean; // 9/11 (Nico, Towers page): the blue fade between the form and the offer, like the green one of the Build page
  noClose?: boolean; // 9/11 (Nico, Build page): no × on the card, and the card never closes (no click outside, no Escape):
  // the card is the whole page; "I'm good with the free one" downloads the free PDF instead of revealing a page
  // 10/11 (Nico): every funnel is noClose now, the free PDF only comes after the email
  landing?: boolean; // 10/11: there is a page behind the card (Tower, Floors, 3D to film, City): whoever already left
  // the email in this browser sees it straight away, with the download links working
  proof?: string; // 10/11 (Nico, G5): one small line of real proof under the send button, a star and a TRUE number, never a
  // review, a rating or a name. Without it the line says how many people asked for a blueprint in four days (371, counted
  // on 9/11); the Tower pages say the views of the tower reel (143,479). Change the number only with a real one.
  after?: string; // 10/11: where "Have a look" goes after the email is sent, when the funnel has no /sent page
  // (the City page: "#full", the card goes away and the page shows the Full guide)
  watch?: string; // 13/11 (Nico): after "Delivered", go to the face-video page (/<slug>/watch) instead of opening the offer here
  allset?: boolean; // 11/11 (Nico, Towers board A): after the form, "You're all set" alone and then the Full offer under it
  // (components/AllSetOffer.astro) instead of the loading steps and the "Have a look" line
  inline?: boolean; // 10/11 (Nico, /fable): the card sits in the page, under something else, instead of covering it: the
  // page scrolls, the card is not a dialog and never moves or shrinks to fit the screen (styles/optin.css, .oi--inline)
}
const { slug, free, word, small, cover, hero, heroMobile, book, noClose, theme, fade, after, landing, inline, allset, watch, proof = '371 people asked for a blueprint in 4 days' } = Astro.props;
const next = after || `/${slug}/sent`;
---

<div class={`oidim${book ? ' oi--book' : ''}${noClose ? ' oi--nox' : ''}${theme ? ' oi--' + theme : ''}${fade ? ' oi--fade' : ''}${inline ? ' oi--inline' : ''}`} data-optin data-slug={slug} data-free={free} data-next={next} data-watch={watch} data-landing={landing ? '' : undefined} style={`--oi-cover:url(${cover});--oi-hero:url(${hero});--oi-hero-m:url(${heroMobile})`} role={inline ? 'group' : 'dialog'} aria-modal={inline ? undefined : 'true'} aria-labelledby="oi-title">
  <div class="oisheet">
    <button type="button" class="oix" data-oi-close aria-label="Close">×</button>
    <div class="oibk" role="img" aria-label="The free blueprint"><div class="oibk__b"><span class="oibk__k"></span><span class="oibk__t"></span><span class="oibk__p"></span><span class="oibk__f"></span></div></div>
    <p class="x3-kick">Where do we send it?</p>
    <h2 class="oist" id="oi-title"><span class="a">Steal our</span><span class="row"><span class="oistamp">Free</span><span class="b" style={small ? 'font-size:.8em' : undefined}>{word}</span></span><span class="c">Method</span></h2>
    <form class="oif" data-oi-form novalidate>
      <label class="oihp" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off" /></label>
      <input name="name" placeholder="Your first name" autocomplete="given-name" required maxlength="60" />
      <input name="email" type="email" placeholder="Your best email" autocomplete="email" required maxlength="120" />
      <label class="oiag oiag--nl"><input type="checkbox" name="nl" /><i>✓</i><span>Also send me an update now and then. No spam, unsubscribe in one click.</span></label>
      <p class="oiag oiag--line">By sending you accept the <a href="/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>.</p>
      <p class="oierr" data-oi-err hidden></p>
      <button class="x3-btn x3-btn--blue">Send me the blueprint →</button>
      <p class="oiproof"><b aria-hidden="true">★</b> {proof}</p>
    </form>
    {/* 10/11 (Nico): the funnel's own small footer, under the card, in the funnel colour: who sells, VAT, privacy, terms, email */}
    <footer class="oiff"><span>Omnya Lab</span><span>VAT IT05578770264</span><a href="/privacy-policy" target="_blank" rel="noopener">Privacy</a><a href="/terms" target="_blank" rel="noopener">Terms</a><a href="mailto:info@omnyalab.com">info@omnyalab.com</a></footer>
  </div>
</div>

<!-- After "Send me the blueprint": the loading steps, then the gentle line about the course (K1, 7/11);
     with `allset` (Towers, 11/11) "You're all set" and the Full offer instead -->
{allset ? (
<div class="oil oil--as" hidden data-oil data-as>
  <AllSetOffer next={next} hero={heroMobile} mail={!!watch} kind={slug === 'the-build-blueprint' ? 'build' : slug === 'the-tower-blueprint' ? 'tower' : 'towers'} />
</div>
) : (
<div class="oil" hidden data-oil>
  <div class="oil__bg"></div>
  <div class="oil__in">
    <div class="oil__top" data-oil-top>
      <p class="oil__k">Free · no payment</p>
      <p class="oil__t">Sending your<br />blueprint</p>
      <div class="oil__bar"><i data-oil-bar></i></div>
      <div class="oil__steps">
        <div class="oil__st" data-st="1"><i>✓</i><span><b>Preparing your blueprint</b><small>the method in five steps</small></span></div>
        <div class="oil__st" data-st="2"><i>✓</i><span><b>Sending it to your inbox</b><small data-oil-em></small></span></div>
        <div class="oil__st" data-st="3"><i>✓</i><span><b>Sent</b><small>check your inbox, and Promotions just in case</small></span></div>
      </div>
    </div>
    <div class="oil__fin" hidden data-oil-fin>
      <div class="oil__ck"><svg viewBox="0 0 40 40"><path d="M10 21l7 7 14-15" /></svg></div>
      <p class="oil__t">You're all set<span data-oil-nm></span></p>
      <p class="oil__p"><b>Your <span style="color:#2997ff">free</span> blueprint</b> is in your inbox.</p>
      <p class="oil__p">If one day you want to implement it faster, <b>the full interactive 3D course</b> is here for <b>€5.99</b>.</p>
      <a class="x3-btn x3-btn--blue" data-oil-go data-astro-reload href={next}>Have a look →</a>
      <button type="button" class="oil__no" data-oil-skip>I'm good with the free one, thanks</button>
    </div>
  </div>
</div>
)}

<script is:inline>
  (function () {
    var box = document.querySelector('[data-optin]');
    if (!box) return;
    var free = box.dataset.free, slug = box.dataset.slug, next = box.dataset.next;
    // this browser already left its email for this blueprint: the download links work, the card stays away
    var FLAG = 'omnya-optin-' + free;
    var done = function () { try { return localStorage.getItem(FLAG) === '1'; } catch (e) { return false; } };
    var form = box.querySelector('[data-oi-form]'), err = box.querySelector('[data-oi-err]');
    if (box.hasAttribute('data-landing') && done()) box.hidden = true;
    var open = function (e) { e.preventDefault(); box.hidden = false; fit(); setTimeout(function () { form.name.focus(); }, 50); };
    var locked = box.classList.contains('oi--nox');
    // 9/11 (Nico, Build page): no site loading screen between the form and the offer, only a clean green fade
    var green = box.classList.contains('oi--c1') || box.classList.contains('oi--fade');
    // 13/11 (Nico): to the video page always with a slow fade (soft), on every funnel, even without `fade`
    var go = function (url, soft) {
      // a place on this same page (the City page, "#full"): the card and the loading screen go away
      if (url.charAt(0) === '#') { oil.hidden = true; box.hidden = true; var el = document.querySelector(url); if (el) el.scrollIntoView(); return; }
      if (!green && !soft) { location.href = url; return; }
      var f = document.createElement('div'); f.className = 'oi-fade' + (box.classList.contains('oi--c1') ? '' : ' oi-fade--blue'); document.body.appendChild(f);
      if (soft) f.style.transition = 'opacity .8s cubic-bezier(.4,0,.2,1)';
      requestAnimationFrame(function () { requestAnimationFrame(function () { f.classList.add('on'); }); });
      setTimeout(function () { location.href = url; }, soft ? 860 : 520);
    };
    var goBtn = document.querySelector('[data-oil-go]');
    if (goBtn) goBtn.addEventListener('click', function (e) { var h = goBtn.getAttribute('href'); if (!green && h.charAt(0) !== '#') return; e.preventDefault(); go(h); });
    var close = function () { if (!locked) box.hidden = true; };
    // 10/11 (Nico): the send button always stays on screen, with or without the cookie bar. On a short screen the
    // card first moves up (less of the book shows above it), and if that is not enough it gets a little smaller.
    var sheet = box.querySelector('.oisheet');
    var fit = function () {
      if (box.hidden || box.classList.contains('oi--inline')) return; // in the page (/fable): nothing to fit
      box.style.paddingTop = ''; sheet.style.zoom = '';
      var cs = getComputedStyle(box), top = parseFloat(cs.paddingTop) || 0, bot = parseFloat(cs.paddingBottom) || 0;
      var room = box.clientHeight, h = sheet.offsetHeight, over = top + h + bot - room;
      if (over <= 0) return;
      var t = Math.max(48, top - over);
      box.style.paddingTop = t + 'px';
      over = t + h + bot - room;
      if (over > 0) sheet.style.zoom = Math.max(0.7, (room - t - bot) / h).toFixed(3);
    };
    fit();
    window.addEventListener('resize', fit); window.addEventListener('load', fit); window.addEventListener('omnya:ocb', fit);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    // one listener on the page: the buttons come after this script in the HTML
    document.addEventListener('click', function (e) { var a = e.target.closest && e.target.closest('a[href^="/go/' + free + '"]'); if (a && !done()) open(e); });
    box.querySelector('[data-oi-close]').addEventListener('click', close);
    box.addEventListener('click', function (e) { if (e.target === box) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !box.hidden) close(); });
    var oil = document.querySelector('[data-oil]');
    var T = function (fn, ms) { return setTimeout(fn, ms); };
    var st = function (n) { return oil.querySelector('[data-st="' + n + '"]'); };
    oil.querySelector('[data-oil-skip]').addEventListener('click', function () { if (locked) { location.href = '/go/' + free; return; } oil.hidden = true; box.hidden = true; });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = form.elements.name.value.trim(), email = form.elements.email.value.trim();
      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { err.textContent = 'Write your name and a real email.'; err.hidden = false; return; }
      err.hidden = true;
      try { localStorage.setItem(FLAG, '1'); } catch (e) {}
      // Meta Lead (8/11): only if the visitor accepted cookies; the same event_id goes to the server (no double count)
      var eid = 'lead_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
      var ads = !!(window.omnyaTrack && window.omnyaTrack('Lead', { content_name: free }, eid));
      var fbp = (document.cookie.match(/(?:^|; )_fbp=([^;]+)/) || [])[1] || '';
      var body = JSON.stringify({ name: name, email: email, free: free, page: slug, company: form.elements.company.value, k: new URLSearchParams(location.search).get('k') || '', cv: 'v3', nl: form.elements.nl.checked, ads: ads, eid: eid, fbp: ads ? fbp : '' });
      var post = function () { return fetch('/api/optin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body }).then(function (r) { return r.ok; }).catch(function () { return false; }); };
      // 11/11 evening (Nico): a failed send no longer throws people straight onto the free PDF (that skipped the whole
      // funnel). One more try after a second and a half; if it still fails the funnel goes on all the same and the
      // /sent page says the blueprint opens there (#nomail), the free PDF stays one tap away ("I'm good with the free one").
      var sent = post().then(function (ok) { return ok || new Promise(function (r) { setTimeout(r, 1500); }).then(post); });
      // 11/11 Towers (AllSetOffer): "You're all set" at once, "Delivered" once the email went, then the offer opens
      var aso = oil.querySelector('[data-aso]');
      if (aso) {
        oil.querySelector('[data-oil-nm]').innerHTML = ', <span></span>';
        oil.querySelector('[data-oil-nm] span').textContent = name.split(' ')[0];
        oil.querySelectorAll('[data-aso-em]').forEach(function (x) { x.textContent = email; });
        oil.hidden = false; aso.classList.add('s1');
        var t0 = Date.now();
        sent.then(function (ok) {
          if (!ok) {
            // the buttons go straight to Stripe (O3), nothing to change there; no email went: the receipt says the blueprint is ready and opens next, not that it was delivered
            var rt = oil.querySelector('[data-aso-rt]'); if (rt) rt.innerHTML = 'Your <u>FREE</u> blueprint is ready';
            var to = oil.querySelector('[data-aso-to]'); if (to) to.textContent = 'It opens on the next page';
            var kb = oil.querySelector('.vk .b'); if (kb) kb.textContent = '✓ FREE blueprint ready';
          }
          T(function () {
            aso.classList.add('sent');
            // 13/11: the face video page takes over after the green receipt; the email stays in this tab only (sessionStorage), for the checkout
            if (box.dataset.watch) { try { sessionStorage.setItem('omnya-watch', JSON.stringify({ name: name, email: email })); } catch (e) {} T(function () { go(box.dataset.watch, true); }, 3000); return; }
            // 11/11 night (Nico, A1): about 4 s of the envelope, then 3 s of "Your FREE blueprint arrived", then the offer
            T(function () { aso.classList.add('s2', 'play'); }, 3000);
            T(function () { aso.classList.add('s3'); }, 4000);
            // O3 (11/11 late): the choices are all here now, so no automatic move to the old /sent page
          }, Math.max(0, 4200 - (Date.now() - t0)));
        });
        return;
      }
      oil.querySelector('[data-oil-em]').textContent = 'to ' + email;
      oil.querySelector('[data-oil-nm]').textContent = ', ' + name.split(' ')[0];
      oil.hidden = false;
      var bar = oil.querySelector('[data-oil-bar]');
      if (bar.animate) bar.animate([{ width: '0%' }, { width: '100%' }], { duration: 7000, easing: 'cubic-bezier(.3,0,.2,1)', fill: 'forwards' }); else bar.style.width = '100%';
      T(function () { st(1).classList.add('is-in'); }, 300); T(function () { st(1).classList.add('is-done'); }, 1900); T(function () { st(1).classList.add('is-out'); }, 2600);
      T(function () { st(2).classList.add('is-in'); }, 2900);
      // "Sent" only once the server said the email went out; if it didn't, the PDF opens right away
      T(function () {
        sent.then(function (ok) {
          if (!ok && next.charAt(0) !== '#') { next = next + '#nomail'; var gb = oil.querySelector('[data-oil-go]'); if (gb) gb.setAttribute('href', next); }
          st(2).classList.add('is-done');
          T(function () { st(2).classList.add('is-out'); }, 700);
          T(function () { st(3).classList.add('is-in'); }, 1000);
          T(function () { st(3).classList.add('is-done'); }, 1900);
          T(function () { oil.querySelector('[data-oil-top]').classList.add('is-gone'); oil.querySelector('[data-oil-fin]').hidden = false; }, 3700);
          T(function () { if (!oil.hidden) go(next); }, 3700 + 15000);
        });
      }, 4700);
    });
  })();
</script>
