          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/city/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/whatsapp.js": {
