---
// 18/11 (Nico, board R1 + C1): the Stadium thanks page (/learn/thanks/full-stadium) in the red of its funnel.
// Made by scripts/make-stadium-ry.py from the Riyadh violet block of views/Thanks.astro. is:inline: only on that page.
---
<style is:inline>
  /* 17/11 (Nico): after paying for the Stadium guide the page is in the colours of that funnel (stadium red, white text) */
  :root{--bg:#130607;--ink:#ffffff;--mute:#cd9c9d;--mute-lg:#b18486;--line:#3c2021}
  html,body{background:radial-gradient(900px 600px at 50% -8%,#ff3b3033,#0000 70%),#130607!important;color:#fff}
  .oto .btn--fill,.oto-dl .btn--fill{background:#ff3b30!important;border-color:#ff3b30!important;color:#fff!important}
  .oto__steps .is-done span,.oto__steps .is-now span{background:#ff3b30!important;color:#fff!important;border-color:#ff3b30!important}
  .hdr .logo__img--dark{filter:invert(1)}
  .hdr::before{background:#130607e6!important;border-bottom-color:#3c2021!important}
  .hdr{color:#fff!important}
  .wa-fab{background:#ff3b30!important;color:#fff!important}
  html[data-page='thanks'] .oto-dl{background:linear-gradient(160deg,#ffffff1a,#ffffff08)!important;border:1px solid #ffffff26!important;-webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px);color:#fff!important;box-shadow:0 40px 80px -40px #ff3b30aa,inset 0 1px #ffffff33!important}
  html[data-page='thanks'] .oto-dl *{color:#fff}
  html[data-page='thanks'] .oto-dl .t-sub{color:#fff!important;-webkit-text-fill-color:#fff!important}
  html[data-page='thanks'] .oto-dl .oto-dl__note,html[data-page='thanks'] .oto-dl .oto-dl__note *{color:#cd9c9d!important}
  html[data-page='thanks'] .oto-dl .btn:not(.btn--fill){background:#ffffff14!important;border-color:#ffffff33!important;color:#fff!important}
  html[data-page='thanks'] .oto__down{background:#ff3b30!important}
  html[data-page='thanks'] .oto__head{display:none}
  html[data-page='thanks'] .oto__card{background:#240a0b!important;border:1px solid #3c2021;box-shadow:0 40px 70px -40px #ff3b3088!important;color:#fff}
  html[data-page='thanks'] .oto__card *{color:#fff}
  html[data-page='thanks'] .oto__card .t-sub,html[data-page='thanks'] .oto__card p{color:#dfb5b6}

</style>
