{
  "crons": [
    {
      "path": "/api/igtick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/drip",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/contract?tick=1",
      "schedule": "7 * * * *"
    }
