  .A .chero .kw { font-style: normal; background: linear-gradient(100deg, #b9ddff 0%, #5aa8ff 52%, #2a74ff 100%); -webkit-background-clip: text; background-clip: text; color: transparent; filter: drop-shadow(0 0 16px rgba(47,123,255,.35)) }
  .A .chs { font: 500 17px/22px var(--f-sf); color: rgba(255,255,255,.92) }
