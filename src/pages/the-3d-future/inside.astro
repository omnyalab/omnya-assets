  const howW = () => `<div class="glass fhow"><span class="k">${ic('spark')}How the feed works</span><ol><li><i>1</i><span>Paste the link of your build, then add a photo of it</span></li><li><i>2</i><span>Everyone in the club sees it, likes it and comments</span></li><li><i>3</i><span>I look at every post and write to you privately with what works and what I'd change</span></li></ol></div>`
  function emptyW() {
