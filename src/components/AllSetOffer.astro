---
// 11/11 (Nico, board "Towers You're all set", A): what comes right after "Send me the blueprint" on the Towers funnel,
// in place of the old loading steps and the "Have a look" line. First "You're all set, <name>" alone, big, with the
// email going out ("Sending to…" with a bar, then "Delivered to…" once api/optin said it went); about 5 seconds later
// it moves up and the Full Towers offer opens under it: the book with the -79% sticker, €5.99 with €29 struck, the
// table free against Full, one button on one line. The button goes to /the-towers-blueprint/sent as before, where the
// scene (+€12) and the pack (€59) are chosen; the €53 upgrade comes after, on /learn/thanks/full-towers.
// OptIn.astro renders this inside .oil when the page passes `allset`, and its script runs the timing
// (classes s1, sent, s2/play, s3 on .aso). -79% is exact: 5.99 is 79.3% off 29.
// 11/11 evening (Nico): the same screen on the Build funnel, green (theme c1, #22d35e like the rest of Build), with the
// Full Build book and its own table; the button goes to /the-build-blueprint/sent (Full €5.99 or the pack €59).
// 11/11 night (Nico, board "Towers inviato", A1 + P1): the free blueprint goes into an envelope that closes and flies off
// ("Sending your FREE blueprint…", about 4 s), then a big green check, "You're all set, <name>" and the green receipt
// "Your FREE blueprint arrived · Delivered to <email>" (3 s); then the title closes, the receipt stays on top, the line
// "Now get every prompt, word for word ↓" and the offer come in, and "No thanks, I'm good with the free one" is in sight.
interface Props {
  next: string; // the /sent page
  hero: string; // the blurred photo behind
  kind?: 'towers' | 'build';
}
const { next, hero, kind = 'towers' } = Astro.props;
const isBuild = kind === 'build';
const bookSrc = isBuild ? '/learn/bd_book_tight.webp' : '/learn/tt_book_tight.webp';
const bookAlt = isBuild ? 'The Full Build Blueprint' : 'The Full Towers Blueprint';
const freeSrc = isBuild ? '/learn/bd_cover_book.webp' : '/learn/tt_cover_book.webp'; // the FREE blueprint's own cover
const ard = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15M5.5 12.5L12 19l6.5-6.5"/></svg>';
const burst = Array.from({ length: 44 }, (_, i) => {
  const r = i % 2 === 0 ? 50 : 43, a = (Math.PI * i) / 22;
  return `${(50 + r * Math.cos(a)).toFixed(1)},${(50 + r * Math.sin(a)).toFixed(1)}`;
}).join(' ');
const ck = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.2 12.4l3.9 3.9 7.7-8.1"/></svg>';
const xx = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.6 7.6l8.8 8.8M16.4 7.6l-8.8 8.8"/></svg>';
const Y = `<i class="aso-ic aso-ic--y">${ck}</i>`, N = `<i class="aso-ic aso-ic--n">${xx}</i>`;
const rows: [string, string, string][] = isBuild ? [
  ['The 5-step method', Y, Y],
  ['Prompts for 9 phases + clips', '<span class="aso-tx aso-tx--d">1</span>', '<span class="aso-tx">All</span>'],
  ['The 3D house code', N, Y],
  ['The hold to build page', N, Y],
  ['Light frames for phones', N, Y],
  ['What to charge the client', N, Y],
] : [
  ['The 5-step method', Y, Y],
  ['Prompts for 6 views + 6 clips', '<span class="aso-tx aso-tx--d">1</span>', '<span class="aso-tx">All</span>'],
  ['The 3D scene code', N, Y],
  ['The choose your view page', N, Y],
  ['Fog + seamless loop', N, Y],
  ['What to charge the client', N, Y],
];
---

<div class={`aso${isBuild ? ' aso--c1' : ''}`} data-aso style={`--aso-hero:url(${hero})`}>
  <div class="aso__bg" aria-hidden="true"></div>
  <div class="aso__sc">
    <div class="aso__in">
      <div class="aso-hi v vA">
        <div class="vA-st" aria-hidden="true"><div class="vA-in">
          <div class="vA-env"><div class="vA-back"></div><img class="vA-pdf" src={freeSrc} alt="" /><div class="vA-flap"></div><div class="vA-front"></div><div class="vA-flap2"></div></div>
          <i class="vA-tr"></i><i class="vA-tr t2"></i><i class="vA-tr t3"></i>
          <div class="vA-ok" set:html={ck} />
        </div></div>
        <p class="vk"><span class="a dots">Sending your <u>FREE</u> blueprint</span><span class="b">✓ FREE blueprint delivered</span></p>
        <p class="aso-hi__t" role="status">You're all set<span data-oil-nm></span></p>
        <div class="vfr">
          <span class="vfr-cv"><img src={freeSrc} alt="The free blueprint" /><em>FREE</em></span>
          <span class="vfr-tx"><b data-aso-rt>Your <u>FREE</u> blueprint arrived</b><small data-aso-to>Delivered to <span data-aso-em></span></small></span>
          <i class="vfr-ck" set:html={ck} />
        </div>
      </div>
      <div class="aso-rev">
        <div class="aso-rev__in">
          <div class="vbr"><p>Now get <b>every prompt</b>, word for word</p><i class="vbr-ar" set:html={ard} /></div>
          <div class="aso-card">
            <div class="aso-deal">
              <div class="aso-bk">
                <img src={bookSrc} alt={bookAlt} width="600" height="825" />
                <div class="aso-stk" aria-hidden="true">
                  <svg viewBox="0 0 100 100"><defs><radialGradient id="aso-g" cx="40%" cy="35%" r="70%"><stop offset="0" stop-color="#fff27a" /><stop offset=".55" stop-color="#ffd60a" /><stop offset="1" stop-color="#ffb000" /></radialGradient></defs><g class="aso-stk__spin"><polygon points={burst} fill="url(#aso-g)" /></g><circle cx="50" cy="50" r="36" fill="none" stroke="#11111130" stroke-width="1" stroke-dasharray="2 3" /></svg>
                  <div class="aso-stk__t"><em>SAVE</em><b>-79%</b><small>ONLY HERE</small></div>
                </div>
              </div>
              <div class="aso-px">
                <p class="aso-px__t">The <span>full</span> guide</p>
                <div class="aso-pr"><span class="aso-pr__new"><sup>€</sup>5.99</span><span class="aso-pr__old"><span class="aso-sr">instead of </span>€29</span></div>
                <span class="aso-sv">You save €23, only here</span>
              </div>
            </div>
            <div class="aso-tb">
              <div class="aso-tb__full" aria-hidden="true"></div>
              <div class="aso-tr aso-th"><span>What you get</span><span class="c">Free</span><span class="c">Full<small>€5.99</small></span></div>
              {rows.map(([a, b, c], i) => <div class="aso-tr" style={`--i:${i}`}><span>{a}</span><span class="c" set:html={b} /><span class="c" set:html={c} /></div>)}
            </div>
            <a class="aso-cta" data-oil-go data-astro-reload href={next}><b>Get the full one · €5.99 →</b></a>
          </div>
          <button type="button" class="aso-no" data-oil-skip>No thanks, I'm good with the free one</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
.oil.oil--as{padding:0;display:block;text-align:left}
.aso{position:absolute;inset:0;overflow:hidden;container-type:inline-size;background:#05070a;font-family:Montserrat,-apple-system,sans-serif;color:#fff;-webkit-font-smoothing:antialiased;
  --ac:41 151 255;--bg1:#1a4fa0aa;--bg2:#0a1a33cc;--acl:#cfe6ff;--acl2:#bcdcff;--card:#0e2447d9;--cta1:#45a6ff;--cta2:#1a7fe8;--yes:#30d158;--no:#ff453a;--gold:#ffd60a;--mute:#ffffffa3;--dim:#ffffff6b;--line:#ffffff1c}
.aso *{box-sizing:border-box}
.aso.aso--c1{--ac:34 211 94;--bg1:#13602eaa;--bg2:#082814cc;--acl:#c8f8d7;--acl2:#bff3cf;--card:#0b3018d9;--cta1:#36dd6e;--cta2:#13a544}
.aso__bg{position:absolute;inset:-30px;background:var(--aso-hero) center 30%/cover;filter:blur(22px) saturate(1.2);opacity:.55;transform:scale(1.1)}
.aso__bg::after{content:"";position:absolute;inset:0;background:radial-gradient(90% 60% at 50% 28%,var(--bg1) 0%,var(--bg2) 45%,#05070af2 80%)}
.aso__sc{position:absolute;inset:0;overflow-x:hidden;overflow-y:auto;-webkit-overflow-scrolling:touch}
.aso__in{position:relative;min-height:100%;display:flex;flex-direction:column;justify-content:center;gap:11px;padding:max(22px,env(safe-area-inset-top)) 16px calc(max(18px,env(safe-area-inset-bottom)) + var(--ocb,0px));max-width:460px;margin:0 auto}
.aso-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

.aso-hi{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px}
.aso-hi__t{margin:4px 0 0;font-weight:900;font-size:34px;line-height:.95;text-transform:uppercase;letter-spacing:-.01em;text-wrap:balance;transition:font-size .9s cubic-bezier(.2,.8,.2,1)}
.aso-hi__t span span{color:var(--yes)}
.aso:not(.s2) .aso-hi__t{font-size:44px}

.aso-rev{display:grid;grid-template-rows:0fr;transition:grid-template-rows .9s cubic-bezier(.2,.8,.2,1)}
.aso-rev__in{min-height:0;overflow:hidden;display:flex;flex-direction:column;gap:10px;margin:0 -12px;padding:0 12px}
.aso.s2 .aso-rev{grid-template-rows:1fr}
.aso.s3 .aso-rev__in{overflow:visible}

.aso-card{position:relative;display:flex;flex-direction:column;gap:11px;padding:14px 10px;border-radius:24px;background:linear-gradient(180deg,var(--card),#060b15e6);border:1px solid rgb(var(--ac) / .33);box-shadow:0 30px 60px -20px #000,0 0 0 1px #ffffff08 inset,0 0 50px -10px rgb(var(--ac) / .33)}
.aso-deal{display:grid;grid-template-columns:110px 1fr;gap:16px;align-items:center}
.aso-bk{position:relative;width:100px}
.aso-bk img{width:100%;height:auto;display:block;transform:rotate(-5deg);filter:drop-shadow(0 22px 26px #000c)}
.aso-px{min-width:0}
.aso-px__t{margin:0;font-weight:900;font-size:21px;line-height:1;text-transform:uppercase;letter-spacing:-.01em}
.aso-px__t span{color:rgb(var(--ac))}
.aso-pr{display:flex;align-items:flex-end;gap:10px;margin-top:10px}
.aso-pr__new{font-size:44px;font-weight:900;line-height:.82;letter-spacing:-.04em;background:linear-gradient(180deg,#fff 30%,var(--acl2));-webkit-background-clip:text;background-clip:text;color:transparent}
.aso-pr__new sup{font-size:.42em;vertical-align:.95em;margin-right:1px}
.aso-pr__old{position:relative;font-size:21px;font-weight:800;color:var(--dim);margin-bottom:3px}
.aso-pr__old::after{content:"";position:absolute;left:-4px;right:-4px;top:52%;height:3px;background:var(--no);border-radius:3px;transform:rotate(-14deg);transform-origin:left center}
.aso-sv{white-space:nowrap;display:inline-flex;margin-top:10px;background:#30d1581f;color:var(--yes);border:1px solid #30d15840;font-size:11px;font-weight:800;padding:5px 10px;border-radius:999px}

.aso-stk{position:absolute;right:-26px;bottom:-22px;width:96px;height:96px;z-index:3;transform:rotate(14deg)}
.aso-stk svg{position:absolute;inset:0;width:100%;height:100%;filter:drop-shadow(0 8px 14px #0009)}
.aso-stk__spin{transform-origin:50% 50%;animation:aso-spin 14s linear infinite}
.aso-stk__t{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#111;text-align:center;line-height:.85}
.aso-stk__t b{font-size:27px;font-weight:900;letter-spacing:-.04em}
.aso-stk__t small{font-size:10px;font-weight:900;letter-spacing:.12em;margin-top:4px}
.aso-stk__t em{font-style:normal;font-size:10.5px;font-weight:800;letter-spacing:.14em;margin-bottom:3px}

.aso-tb{position:relative;border-radius:18px;background:#05070a8c;border:1px solid var(--line);overflow:hidden}
.aso-tb__full{position:absolute;top:0;bottom:0;right:0;width:72px;background:linear-gradient(180deg,rgb(var(--ac) / .25),rgb(var(--ac) / .08));border-left:1.5px solid rgb(var(--ac));box-shadow:inset 0 0 30px rgb(var(--ac) / .19)}
.aso-tr{position:relative;display:grid;grid-template-columns:1fr 46px 72px;align-items:center;min-height:31px}
.aso-tr+.aso-tr{border-top:1px solid #ffffff12}
.aso-tr>span{padding:6px;font-size:11px}
.aso-tr>span:first-child{padding-left:11px;line-height:1.3;color:#ffffffd6;font-weight:600;white-space:nowrap}
.aso-tr .c{text-align:center;font-weight:900;display:flex;justify-content:center}
.aso-th>span{font-size:9px;letter-spacing:.14em;text-transform:uppercase;font-weight:800;color:var(--dim);padding-block:7px}
.aso-th .c{flex-direction:column;align-items:center}
.aso-th .c:last-child{color:#fff}
.aso-th .c:last-child small{display:block;font-size:14px;letter-spacing:-.01em;margin-top:2px}
.aso-ic{display:inline-grid;place-items:center;width:20px;height:20px;border-radius:50%;line-height:0}
.aso-ic svg{width:12px;height:12px;display:block;fill:none;stroke:currentColor;stroke-width:3.4;stroke-linecap:round;stroke-linejoin:round}
.aso-ic--y{background:var(--yes);color:#04210f}
.aso-ic--n{background:#ff453a26;color:var(--no)}
.aso-ic--n svg{stroke-width:3}
.aso-tx{font-size:11px;font-weight:800}
.aso-tx--d{color:var(--dim)}

.aso-cta{position:relative;display:flex;align-items:center;justify-content:center;min-height:58px;padding:10px 18px;border-radius:999px;text-decoration:none;color:#fff;background:linear-gradient(180deg,var(--cta1),var(--cta2));box-shadow:0 18px 40px -12px rgb(var(--ac) / .8),inset 0 1px 0 #ffffff55;overflow:hidden}
.aso-cta b{font-size:16px;font-weight:900;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}
.aso-cta::after{content:"";position:absolute;top:0;bottom:0;left:-40%;width:30%;background:linear-gradient(90deg,#fff0,#ffffff70,#fff0);transform:skewX(-20deg);animation:aso-shine 3.2s ease-in-out 2.6s infinite}
.aso-cta:focus-visible{outline:3px solid #fff;outline-offset:3px}
.aso-no{background:none;border:0;color:#ffffffc4;font:600 13px Montserrat,sans-serif;text-decoration:underline;cursor:pointer;align-self:center;padding:8px 6px 2px}

@media (max-height:700px){
  .vA-st{height:140px}.vA-in{zoom:.85}
  .aso-hi__t{font-size:30px}.aso:not(.s2) .aso-hi__t{font-size:40px}
  .aso-tr{min-height:28px}.aso-card{gap:9px;padding-block:12px}
  .aso-bk{width:88px}.aso-deal{grid-template-columns:96px 1fr}
  .aso-stk{width:84px;height:84px}.aso-stk__t b{font-size:24px}
}
@container (min-width:760px){
  .aso__in{max-width:1020px;padding:34px 60px;gap:22px}
  .aso-hi__t{font-size:62px}.aso:not(.s2) .aso-hi__t{font-size:78px}
  .aso-rev__in{gap:14px}
  .aso-card{display:grid;grid-template-columns:1fr 1.1fr;column-gap:44px;row-gap:14px;align-items:center;padding:28px 34px}
  .aso-deal{grid-column:1;grid-row:1/3;grid-template-columns:1fr;justify-items:center;text-align:center;gap:16px}
  .aso-bk{width:180px}
  .aso-stk{width:150px;height:150px;right:-80px;top:-30px;bottom:auto}
  .aso-stk__t b{font-size:44px}.aso-stk__t small{font-size:13px}.aso-stk__t em{font-size:13px}
  .aso-px__t{font-size:28px}
  .aso-pr{justify-content:center}
  .aso-pr__new{font-size:66px}
  .aso-pr__old{font-size:30px;margin-bottom:6px}
  .aso-tb{grid-column:2;grid-row:1}
  .aso-cta{grid-column:2;grid-row:2}
  .aso-tr{grid-template-columns:1fr 70px 110px;min-height:38px}
  .aso-tb__full{width:110px}
  .aso-tr>span{font-size:13.5px}
  .aso-th>span{font-size:9.5px;padding-block:10px}
}

/* the timing: s1 at once, sent when the email went, s2 + play opens the offer, s3 lets the sticker out */
.aso.play .aso-card{animation:aso-cardin .7s cubic-bezier(.2,.8,.2,1) 1.1s both}
.aso.play .aso-bk img{animation:aso-bookin .7s cubic-bezier(.2,.8,.2,1) 1.35s both}
.aso.play .aso-px{animation:aso-up .6s cubic-bezier(.2,.8,.2,1) 1.45s both}
.aso.play .aso-stk{animation:aso-stamp .55s cubic-bezier(.3,1.5,.5,1) 1.8s both}
.aso.play .aso-pr__old::after{animation:aso-strike .35s ease-out 1.9s both}
.aso.play .aso-pr__new{animation:aso-pricepop .55s cubic-bezier(.3,1.6,.5,1) 2.05s both}
.aso.play .aso-sv{animation:aso-up .4s ease-out 2.25s both}
.aso.play .aso-tb{animation:aso-up .5s ease-out 2.2s both}
.aso.play .aso-tr{animation:aso-rowin .4s ease-out both;animation-delay:calc(2.35s + var(--i,0) * .1s)}
.aso.play .aso-tr .aso-ic--y{animation:aso-pop .35s cubic-bezier(.3,1.7,.5,1) both;animation-delay:calc(2.45s + var(--i,0) * .1s)}
.aso.play .aso-cta{animation:aso-up .5s cubic-bezier(.2,.8,.2,1) 2.9s both,aso-breathe 2.2s ease-in-out 3.5s infinite}
.aso.play .aso-no{animation:aso-fade .5s ease-out 3.1s both}
@keyframes aso-up{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes aso-fade{from{opacity:0}to{opacity:1}}
@keyframes aso-pop{from{transform:scale(0)}to{transform:scale(1)}}
@keyframes aso-ring{0%{opacity:0;transform:scale(.7)}40%{opacity:1}100%{opacity:.6;transform:scale(1)}}
@keyframes aso-draw{from{stroke-dashoffset:30}to{stroke-dashoffset:0}}
@keyframes aso-fill{to{width:100%}}
@keyframes aso-cardin{from{opacity:0;transform:translateY(40px) scale(.96)}to{opacity:1;transform:none}}
@keyframes aso-bookin{from{opacity:0;transform:translateY(30px) rotate(-14deg) scale(.9)}to{opacity:1;transform:rotate(-5deg)}}
@keyframes aso-strike{from{transform:rotate(-14deg) scaleX(0)}to{transform:rotate(-14deg) scaleX(1)}}
@keyframes aso-pricepop{0%{opacity:0;transform:scale(.4)}100%{opacity:1;transform:scale(1)}}
@keyframes aso-stamp{0%{opacity:0;transform:scale(2.6) rotate(-30deg)}70%{opacity:1;transform:scale(.92) rotate(18deg)}100%{transform:scale(1) rotate(14deg)}}
@keyframes aso-rowin{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:none}}
@keyframes aso-spin{to{transform:rotate(360deg)}}
@keyframes aso-shine{0%{left:-40%}45%,100%{left:130%}}
@keyframes aso-breathe{0%,100%{box-shadow:0 18px 40px -12px rgb(var(--ac) / .8),inset 0 1px 0 #ffffff55}50%{box-shadow:0 18px 56px -6px rgb(var(--ac) / 1),inset 0 1px 0 #ffffff55}}
@media (prefers-reduced-motion:reduce){.aso *,.aso *::before,.aso *::after{animation:none!important;transition:none!important}}

/* 11/11 night (Nico, A1 + P1): the envelope, the FREE receipt, the line to the offer */
.aso{--env0:#174a8c;--env00:#0b2347;--env1:#3b8ef0;--env2:#1b5fc2;--env3:#5aa4f7}
.aso.aso--c1{--env0:#13602e;--env00:#082814;--env1:#36d86d;--env2:#139a42;--env3:#62e891}

.aso u{text-decoration:none;color:#ffd60a}
.vk u{color:#ffd60a}
.vfr{display:grid;grid-template-columns:46px 1fr 30px;gap:12px;align-items:center;width:100%;max-width:360px;padding:9px 12px 9px 9px;border-radius:18px;background:linear-gradient(90deg,#0d3a1dee,#08240fe6);border:1.5px solid #30d158aa;box-shadow:0 0 30px -8px #30d15899,0 16px 30px -14px #000;text-align:left}
.vfr-cv{position:relative;display:block}
.vfr-cv img{display:block;width:46px;border-radius:4px;box-shadow:0 6px 12px #0009}
.vfr-cv em{position:absolute;left:50%;bottom:-6px;transform:translateX(-50%);font-style:normal;font-size:8.5px;font-weight:900;letter-spacing:.1em;color:#111;background:#ffd60a;padding:2px 5px;border-radius:4px;box-shadow:0 2px 6px #0008}
.vfr-tx{min-width:0;display:flex;flex-direction:column;gap:2px}
.vfr-tx b{font-size:14.5px;font-weight:900;color:#fff;line-height:1.15;white-space:nowrap}
.vfr-tx small{font-size:11px;font-weight:700;color:#9ff0b6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vfr-ck{width:30px;height:30px;border-radius:50%;background:var(--yes);display:grid;place-items:center;box-shadow:0 0 0 4px #30d15830}
.vfr-ck svg{width:17px;height:17px;fill:none;stroke:#04210f;stroke-width:3.6;stroke-linecap:round;stroke-linejoin:round}
.aso.s1 .v .vfr{animation:none;opacity:0;transform:translateY(14px) scale(.96);transition:opacity .55s cubic-bezier(.2,.8,.2,1),transform .55s cubic-bezier(.3,1.5,.5,1)}
.aso.sent .v .vfr{opacity:1;transform:none;transition-delay:.75s}
.aso.sent .v .vfr-ck{animation:vpop .5s cubic-bezier(.3,1.6,.5,1) 1.15s both}
@container (min-width:760px){.vfr{max-width:460px;zoom:1.15}}

.v{width:100%}
.vk{margin:0;font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--acl);display:grid}
.vk>span{grid-area:1/1;transition:opacity .35s,transform .35s}
.vk .b{opacity:0;transform:translateY(6px);color:var(--yes)}
.aso.sent .vk .a{opacity:0;transform:translateY(-6px)}
.aso.sent .vk .b{opacity:1;transform:none}
