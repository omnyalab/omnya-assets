---
// An interactive 3D in the work grids (8/11): looks like a project card, but the
// picture is a moving preview, it carries an "Interactive 3D" badge and opens the live 3D.
import Arrow from './Arrow.astro';
import { t, langFromPath } from '../i18n';

interface Props {
  id: 'house' | 'tower' | 'towers';
  slot: number;
  kind?: 'pcard' | 'wcard';
  shape?: string;
  ar?: string;
  badge?: 'pill' | 'round';
}
const { id, slot, kind = 'pcard', shape, ar = '16 / 10', badge = 'round' } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const I = T.i3d;
const it = I.items[id];
const media = {
  house: { href: `${lang === 'it' ? '/it' : ''}/demo/hold-to-build/`, video: '/interactive/house.mp4', videoM: '/interactive/house-m.mp4', pic: '/interactive/house', cat: 'luxury' },
  tower: { href: `${lang === 'it' ? '/it' : ''}/demo/choose-your-floor/`, video: '/interactive/tower.mp4', videoM: '/interactive/tower-m.mp4', pic: '/interactive/tower', cat: 'real-estate' },
  towers: { href: `${lang === 'it' ? '/it' : ''}/demo/choose-your-view/`, video: '/interactive/towers.mp4', videoM: '/interactive/towers-m.mp4', pic: '/interactive/towers', cat: 'real-estate' },
}[id];
---

<a href={media.href} data-astro-reload class:list={['pcard', kind, 'i3card']} data-slot={slot} data-o="horizontal" data-cat={media.cat} data-shape={shape} data-cursor={I.try}>
  <div class="pcard__media">
    <div class="frame pcard__frame" style={`--ar: ${ar}`}>
      <div class="frame__in">
        {/* 9/11: like the hero, a sharp picture is always there underneath, and the moving preview fades in on top once it plays */}
        <img class="i3card__pic" src={`${media.pic}-1600.webp`} srcset={`${media.pic}-800.webp 800w, ${media.pic}-1600.webp 1600w`} sizes="(min-width: 900px) 58vw, 100vw" width="1600" height="900" alt={it.alt} decoding="async" />
        <video class="i3card__vid" muted playsinline loop preload="none" aria-hidden="true" data-lazyvideo>
          <source src={media.videoM} type="video/mp4" media="(max-width: 899px)" />
          <source src={media.video} type="video/mp4" />
        </video>
      </div>
    </div>
    {badge === 'pill' ? (
      <span class="i3badge i3badge--pill"><i aria-hidden="true"></i>{I.badge}</span>
    ) : (
      <span class="i3badge i3badge--round" aria-label={I.badge}>
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <defs><path id={`i3c-${id}-${slot}`} d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" /></defs>
          <text><textPath href={`#i3c-${id}-${slot}`} textLength="236" lengthAdjust="spacing">{I.ring}</textPath></text>
        </svg>
        <b>3D</b>
      </span>
    )}
    {/* like "View" on the other cards: the desktop cursor says it, on phones the circle shows mid-screen */}
    <span class="pcard__view i3card__view" aria-hidden="true"><span>{I.try}</span></span>
  </div>
  <div class="pcard__cap">
    <span class="pcard__title">{it.name}<Arrow diag class="pcard__arrow" /></span>
    <span class="i3card__text">{it.text}</span>
  </div>
</a>
