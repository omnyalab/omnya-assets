---
// /go/<id>: a click counter. Vercel Analytics records this page view, then the visitor
// moves on to the checkout, the booking page or (while those are empty) WhatsApp.
// The reel word (?k=3d) travels to the checkout as client_reference_id, so every sale
// in the Stripe dashboard shows which reel brought it.
// 10/11 (Nico): the reel's own code wins over the word. The links of the Instagram bot carry it (?ig=<code>), the first
// page of the visit keeps it in localStorage (omnya-ig, layouts/Base.astro) and here it goes on the Stripe Payment Link
// as client_reference_id=ig_<code> (letters, numbers, - and _ only; 30 days at most after the click). In Stripe it is
// the field "client_reference_id" of the Checkout Session (checkout.session.completed), which is where the app on the
// Mac reads it. Only Stripe links get it, and never the Omnya City ones: those are made by /api/city/buy with the
// username in the same field, and they do not pass from this page.
import { products, fallback, type ProductId } from '../lib/learn';
import { t, langFromPath } from '../i18n';

interface Props {
  id: string;
}
const lang = langFromPath(Astro.url.pathname);
const L = t(lang).learn;
const id = Astro.props.id as ProductId;
const product = products.find((p) => p.id === id)!;
// The Blueprints have their own Italian file.
const link = (id === 'free' || id === 'free-tower') && lang === 'it' ? product.checkout.replace('.pdf', '-it.pdf') : product.checkout;
const book = L.books.find((b) => b.id === id);
const lesson = L.lessons.find((l) => l.id === id);
const offer = (L.thanks.offers as Record<string, { a: string; b: string; price: string }>)[id];
const name = id === 'free' ? 'The Blueprint (PDF)' : id === 'free-tower' ? 'The Tower Blueprint (PDF)' : id === 'full-tower' ? 'The Full Tower Blueprint (PDF)' : id === 'free-3d' ? 'the free 3D to film blueprint (PDF)' : id === 'full-3d' ? 'the Full Blueprint, How to make a 3D that sells with AI (PDF)' : id === 'free-city' ? 'the free City Blueprint (PDF)' : id === 'full-city' ? 'the Full City Blueprint, How to build a 3D city that goes viral with AI (PDF)' : id === 'free-build' ? 'the free Build Blueprint (PDF)' : id === 'full-build' ? 'the Full Build Blueprint, How to build a house that builds itself (PDF)' : id === 'free-towers' ? 'the free Towers Blueprint (PDF)' : id === 'full-towers' ? 'the Full Towers Blueprint, How to build three towers you choose the view of (PDF)' : id === 'full-towers-scene' ? 'the Full Towers Blueprint and The Towers Scene File' : book ? `${book.a} ${book.b}` : lesson ? lesson.name : id === 'bundle' ? L.ladder[2][0] : id === 'everything' ? 'Everything we teach (4 Full blueprints + 3 playbooks)' : offer && id !== 'community' ? `${offer.a} (${offer.price})` : L.communityA;
// The WhatsApp message for a thanks-page offer (4/11, Nico):
// the paid ones keep "title (price)" with the title in lower case, as it reads inside a sentence.
const said = offer && id !== 'community' ? offerName() : name;
function offerName() {
  // 10/11: the free image is no longer offered; an old /go/sample link opens a plain message about a project
  if (id === 'sample') return lang === 'it' ? 'parlarvi del mio progetto' : 'to talk about my project';
  const a = offer.a.charAt(0).toLowerCase() + offer.a.slice(1);
  return `${a} (${offer.price})`;
}
// 10/11: the launch links (€1.99 until Sunday 8 November) are gone from the code; every product has one link, in lib/learn.ts
// 10/11 (Nico): a free funnel blueprint opens only in a browser that left its email on the funnel page
// (OptIn.astro sets localStorage omnya-optin-<id> when the form is sent). Everyone else goes to that page.
const funnels: Partial<Record<ProductId, string>> = { 'free-tower': '/the-tower-blueprint', 'free-3d': '/3d-to-film', 'free-city': '/the-city-blueprint', 'free-build': '/the-build-blueprint', 'free-towers': '/the-towers-blueprint' };
const gate = funnels[id] || '';
const fallbacks = Object.fromEntries(['', '3d', 'ai', 'claude', 'dubai'].map((k) => [k, fallback(id, lang, said, k || undefined)]));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{name} · Omnya Lab</title>
    <style>
      html { background: #edeae4; color: #111; font: 16px/1.5 -apple-system, BlinkMacSystemFont, system-ui, sans-serif; }
      body { min-height: 100svh; display: grid; place-items: center; margin: 0; padding: 16px; text-align: center; }
      a { color: inherit; }
    </style>
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body>
    <p><a href={gate || link || fallbacks['']} data-go>{name} →</a></p>
    <script is:inline define:vars={{ checkout: link, fallbacks, lang, gate, id }}>
      const q = new URLSearchParams(location.search);
      const k = (q.get('k') || '').toLowerCase().replace(/[^a-z0-9]/g, '');
      // the reel's code: from this address if it has one, or the one kept by the first page of the visit (30 days)
      let ig = (q.get('ig') || q.get('reel') || '').replace(/[^A-Za-z0-9_-]/g, '').slice(0, 60);
      try {
        if (ig) { localStorage.setItem('omnya-ig', ig); localStorage.setItem('omnya-ig-at', String(Date.now())); }
        else if (Date.now() - (Number(localStorage.getItem('omnya-ig-at')) || 0) < 30 * 864e5) ig = (localStorage.getItem('omnya-ig') || '').replace(/[^A-Za-z0-9_-]/g, '').slice(0, 60);
      } catch (e) {}
      let to = fallbacks[k] || fallbacks[''];
      if (checkout) {
        const u = new URL(checkout, location.origin);
        if (ig && u.hostname === 'buy.stripe.com') u.searchParams.set('client_reference_id', 'ig_' + ig);
        else if (k) u.searchParams.set('client_reference_id', k);
        to = u.toString();
      }
      if (gate) {
        let left = false;
        try { left = localStorage.getItem('omnya-optin-' + id) === '1'; } catch (e) {}
        if (!left) to = gate + (k ? '?k=' + k : '');
      }
      // the checkout comes back to one English page; this says which language to show it in
      try { localStorage.setItem('omnya-lang', lang); } catch (e) {}
      document.querySelector('[data-go]').href = to;
      // Long enough for the analytics beacon to leave, short enough not to be noticed
      setTimeout(() => location.replace(to), 450);
    </script>
  </body>
</html>
