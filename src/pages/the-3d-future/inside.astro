  /* the welcome and the badges side by side, then four photo cards */
  .A .mgrid .w.lvl.lvl2 { grid-column: span 2 }
  .A .lvl2 .medals { grid-template-columns: repeat(3, 1fr) }
  @container app (max-width: 899px) { .A .mgrid .w.lvl.lvl2 { grid-column: 1 / -1 } .A .lvl2 .lvlrow { grid-template-columns: 1fr; justify-items: center } }
  .A .tabin.t5 { grid-template-columns: repeat(5, 1fr); max-width: 460px }
  .A .tabin.t5 button span { font-size: 10.5px }

