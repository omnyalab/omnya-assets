---
// 25/11 (Nico): the Dubai Villa thanks page (/learn/thanks/full-villa) in the colours of its funnel.
// Made by scripts/new-funnel from the Riyadh violet block of views/Thanks.astro. is:inline: only on that page.
---
<style is:inline>
  /* 17/11 (Nico): after paying for the Dubai Villa guide the page is in the colours of that funnel (villa yellow, white text) */
  :root{--bg:#131006;--ink:#ffffff;--mute:#cdc59c;--mute-lg:#b1aa84;--line:#3c3820}
  html,body{background:radial-gradient(900px 600px at 50% -8%,#ffd60a33,#0000 70%),#131006!important;color:#fff}
  .oto .btn--fill,.oto-dl .btn--fill{background:#ffd60a!important;border-color:#ffd60a!important;color:#fff!important}
  .oto__steps .is-done span,.oto__steps .is-now span{background:#ffd60a!important;color:#fff!important;border-color:#ffd60a!important}
  .hdr .logo__img--dark{filter:invert(1)}
  .hdr::before{background:#131006e6!important;border-bottom-color:#3c3820!important}
  .hdr{color:#fff!important}
  .wa-fab{background:#ffd60a!important;color:#fff!important}
  html[data-page='thanks'] .oto-dl{background:linear-gradient(160deg,#ffffff1a,#ffffff08)!important;border:1px solid #ffffff26!important;-webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px);color:#fff!important;box-shadow:0 40px 80px -40px #ffd60aaa,inset 0 1px #ffffff33!important}
  html[data-page='thanks'] .oto-dl *{color:#fff}
  html[data-page='thanks'] .oto-dl .t-sub{color:#fff!important;-webkit-text-fill-color:#fff!important}
  html[data-page='thanks'] .oto-dl .oto-dl__note,html[data-page='thanks'] .oto-dl .oto-dl__note *{color:#cdc59c!important}
  html[data-page='thanks'] .oto-dl .btn:not(.btn--fill){background:#ffffff14!important;border-color:#ffffff33!important;color:#fff!important}
  html[data-page='thanks'] .oto__down{background:#ffd60a!important}
  html[data-page='thanks'] .oto__head{display:none}
  html[data-page='thanks'] .oto__card{background:#241f0a!important;border:1px solid #3c3820;box-shadow:0 40px 70px -40px #ffd60a88!important;color:#fff}
  html[data-page='thanks'] .oto__card *{color:#fff}
  html[data-page='thanks'] .oto__card .t-sub,html[data-page='thanks'] .oto__card p{color:#dfd8b5}

</style>
