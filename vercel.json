  "redirects": [
    {
      "source": "/:page(the-blueprint|the-tower-blueprint|the-tower-floors|3d-to-film|the-build-blueprint|the-towers-blueprint|the-stadium-blueprint|the-miami-blueprint|the-riyadh-blueprint|the-plane-blueprint|the-plane-skill|fable)",
      "has": [
        {
          "type": "query",
          "key": "ig",
          "value": "(?<post>[A-Za-z0-9_-]+)"
        },
        {
          "type": "query",
          "key": "t",
          "value": "(?<t>[abc])"
        }
      ],
      "destination": "/api/instagram?go=:page&p=:post&t=:t",
      "permanent": false
    },
