---
// First visit only (O9b, Nico 9/11). What we make flashes by in three words, the logo appears and holds
// for a moment, then the panel fades away and the page settles back into place, like a camera pulling out.
// About 3s, once per visit.
import Logo from './Logo.astro';
import { t, langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const words = lang === 'it' ? ['Immagini', 'Video', '3D interattivi'] : ['Images', 'Films', 'Interactive 3D'];
---

<div class="pre" id="pre" transition:persist="pre" aria-hidden="true">
  <div class="pre__in">
    {words.map((w, i) => <span class="pre__word" style={`--k:${i}`}>{w}</span>)}
    <Logo class="pre__logo" />
    <span class="sr-only">{T.siteTitle}</span>
  </div>
</div>

<script is:inline>
  // Once per visit. Drawing and logo are one CSS animation started by a class;
  // this only decides when it starts and when the panel lifts.
  (function () {
    var pre = document.getElementById('pre');
    if (!pre || pre.dataset.init) return;
    pre.dataset.init = '1';
    var seen = false;
    try { seen = sessionStorage.getItem('omSeenIntro') === '1'; } catch (e) {}
    // ?intro in the address shows it again, handy to review it
    if (/[?&]intro\b/.test(location.search)) seen = false;
    if (seen) {
      pre.classList.add('is-done', 'is-gone');
      window.__omPre = 'done';
      return;
    }
    window.__omPre = 'running';
    // While the panel covers the page, content paints normally underneath
    document.documentElement.classList.add('pre-run');
    // three words (1.25s), the logo holds and fades out (2.3s), then the panel fades (1s): ~3.3s
    var started = Date.now(), MIN = 2300, MAX = 2400, closed = false;
    requestAnimationFrame(function () { pre.classList.add('is-drawing'); });
    function close() {
      if (closed) return;
      closed = true;
      var wait = Math.max(0, MIN - (Date.now() - started));
      setTimeout(function () { ready(exit); }, wait);
    }
    // Pictures marked [data-pre-wait] (the home hero's first frame, on phones
    // the reel's poster) must be on screen when the panel lifts, never an empty
    // hero: wait for their decode, 1.5s at most on top of the usual time
    function ready(go) {
      var imgs = Array.prototype.slice.call(document.querySelectorAll('img[data-pre-wait]'));
      if (!imgs.length || !imgs[0].decode) return go();
      var done = false;
      var once = function () { if (!done) { done = true; go(); } };
      Promise.all(imgs.map(function (img) { return img.decode().catch(function () {}); })).then(once, once);
      setTimeout(once, 1500);
    }
    function exit() {
      try { sessionStorage.setItem('omSeenIntro', '1'); } catch (e) {}
      window.__omPre = 'done';
      document.documentElement.classList.remove('pre-run');
      window.dispatchEvent(new Event('om:pre-exit'));
      document.documentElement.classList.add('pre-settle');
      pre.classList.add('is-done');
      setTimeout(function () { pre.classList.add('is-gone'); }, 1050);
      setTimeout(function () { document.documentElement.classList.remove('pre-settle'); }, 2100);
    }
    if (document.readyState === 'complete') close();
    else window.addEventListener('load', close);
    setTimeout(close, MAX);
  })();
</script>
