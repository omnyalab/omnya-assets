---
// A2 of board A (20/11): the pre-registration in three steps on the Burj at night (P1), blurred, with the blue glass
// panel; step 3 is the Apple Invites card. The same panel holds the checkout from Saturday 28/11 (name and email, then
// the Stripe fields of api/club.js inside our page). Driven by club-client.js; both open as full-screen dialogs.
import Icon from './Icon.astro';
import { WANTS, VALUE } from './data';
const BUILD4 = [
  { k: 'tower', t: 'Tower', s: 'Buyers choose their floor in 3D' },
  { k: 'stadium', t: 'Stadium', s: 'Fans choose their seat in 3D' },
  { k: 'house', t: 'House', s: 'A house that builds itself on scroll' },
  { k: 'own', t: 'My own idea', s: 'Anything you want, the same method' },
];
---
{/* ---------- pre-registration ---------- */}
<div class="ov" data-ov="list" data-step="1" role="dialog" aria-modal="true" aria-labelledby="t3f-l1" hidden>
  <div class="joinbg" aria-hidden="true"><img src="/learn/3df_bg_burj.webp" alt="" decoding="async"></div>
  <div class="joinwrap">
    <div class="panel" data-steppanel>
      <div class="pbar">
        <button type="button" class="rb ctr" data-back aria-label="Back"><Icon name="back" /></button>
        <div class="track" role="progressbar" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1" aria-label="Step 1 of 3" data-track><i style="width:33.3%"></i><b style="left:33.3%">1/3</b></div>
        <button type="button" class="rb ctr" data-close aria-label="Close"><Icon name="x" /></button>
      </div>
      <div class="stp" data-s="1">
        <h2 id="t3f-l1" tabindex="-1">What do you want to build first?</h2>
        <div class="opts" role="radiogroup" aria-labelledby="t3f-l1" data-wants>
          {WANTS.map((w, i) => (
            <button type="button" class="opt" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-want={w.k}>
              <Icon name={w.i} /><span>{w.t}</span><Icon name="check" class="ok2" />
            </button>
          ))}
        </div>
        <button type="button" class="btn cta wide" data-next>Continue</button>
      </div>
      <div class="stp" data-s="2" hidden>
        <h2 id="t3f-l2" tabindex="-1">Where should your early key go?</h2>
        <form class="opts" data-listform novalidate>
          <div class="field"><label for="t3f-n">Name</label><input id="t3f-n" name="name" required autocomplete="name" maxlength="60" placeholder="Your name"></div>
          <div class="field"><label for="t3f-e">Email</label><input id="t3f-e" name="email" type="email" required autocomplete="email" inputmode="email" maxlength="120" placeholder="you@studio.com"></div>
          <label class="hp" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off"></label>
          <button class="btn cta wide save" type="submit" data-save>Save my seat</button>
        </form>
        <p class="small"><Icon name="lock" /><span>You go on the list for <span data-vv="a">THE 3D FUTURE</span><span data-vv="b">3D THAT SELLS</span>, we never share your email · <a href="/privacy-policy" target="_blank" rel="noopener">Privacy</a></span></p>
      </div>
    </div>
    <div class="invite stp" data-s="3" hidden>
      <img src="/club/v-towers-760.webp" alt="The Towers, our build by the sea" decoding="async" loading="lazy">
      <div class="ib">
        <span class="going"><Icon name="check" />You're on the list</span>
        <h2 id="t3f-l3" tabindex="-1">You get in first</h2>
        <p class="when">Sat 28 Nov · 09:00 CET</p>
        <div class="cdn" role="timer" aria-label="Time until your early door" data-cd="early">
          <span><b data-part="d">0</b><small>days</small></span><i aria-hidden="true">:</i><span><b data-part="h">00</b><small>hours</small></span><i aria-hidden="true">:</i><span><b data-part="m">00</b><small>min</small></span><i aria-hidden="true">:</i><span><b data-part="s">00</b><small>sec</small></span>
        </div>
        <div class="two">
          <button type="button" class="btn" data-sched><Icon name="cal" /><span>Schedule it</span></button>
          <button type="button" class="btn" data-share><Icon name="share" /><span>Share it</span></button>
        </div>
      </div>
    </div>
    <div class="stepdots" aria-hidden="true" data-dots><span aria-current="step"><i></i></span><span><i></i></span><span><i></i></span></div>
  </div>
  <button type="button" class="rb ctr x" data-close aria-label="Close" data-x3 hidden><Icon name="x" /></button>
</div>

{/* ---------- 25/11 Nico («si cambiano le card: finisci una card e vai su un'altra»): the join in four cards that change.
     01-03 one question each (a tap answers and moves on), 04 the card: name and email, «Join», then the Stripe fields of
     api/club.js inside the same card with €0 today. Behind each card its own blurred build: Burj Al Ballur at night,
     the DG tower at sunset, the stadium, the Ballur pool. ?demo=1 shows the card step with a stand-in of the Stripe fields. ---------- */}
{/* 27/11 (Nico, board «Buddy», B): seven cards with the club's 3D knot talking. 1 the hook, 2-4 the three questions, 5 your plan
     (written from the answers), 6 the offer (the real values of the site, the founders' price and when it ends, the guarantee:
     the only card with the price), 7 name and email, «Join», then the Stripe fields as before (no price repeated). */}
<div class="ov jov bud" data-ov="pay" data-step="1" data-stage="ask" role="dialog" aria-modal="true" aria-labelledby="t3f-c1" hidden>
  <div class="jbgs" aria-hidden="true">
    {[1, 2, 3, 4].map((n) => <img src={`/club/join-${n}.webp`} alt="" decoding="async" class:list={{ on: n === 1 }} data-bg={n} />)}
    <span class="jtint"></span><span class="grain"></span>
  </div>
  <div class="jwrap">
    <div class="jtop">
      <button type="button" class="rb ctr" data-jback aria-label="Back"><Icon name="back" /></button>
      <div class="jprog jbar" role="progressbar" aria-valuemin="1" aria-valuemax="7" aria-valuenow="1" aria-label="Card 1 of 7" data-jprog><i data-jbar></i></div>
      <button type="button" class="rb ctr" data-close aria-label="Close"><Icon name="x" /></button>
    </div>
    <div class="jdeck">
      {/* 27/11 (Nico, board «Le card del club»: E1 and T2): the link opens Buddy's cards. 1 what you'll build (our tower),
           2 our real numbers, 3 what is inside, 4 the one question, as one big photo you swipe (T2); 5-7 as before */}
      <section class="jc cur jhero" data-c="1" aria-labelledby="t3f-c1">
        <a class="bud-login" href="/login">Log in</a>
        <div class="bud-say"><img src="/club/knot-96.webp" alt="" width="64" height="64"><h2 id="t3f-c1" tabindex="-1" class="jq">Hi! I'm Buddy. Look what you'll learn to <em class="kw">build</em> 👇</h2></div>
        <div class="bud-hero"><img src="/club/join/hero.webp" alt="SAMAR, the tower of our course, at sunset by the sea" width="900" height="1117" decoding="async"><span>A tower where buyers choose their floor, then fly inside</span></div>
        <button type="button" class="bud-go" data-jnext>Show me how</button>
        <button type="button" class="bud-page" data-close>See the whole page</button>
      </section>
      <section class="jc jproof" data-c="2" aria-labelledby="t3f-c2">
        <div class="bud-say"><img src="/club/knot-96.webp" alt="" width="64" height="64"><h2 id="t3f-c2" tabindex="-1" class="jq">We build these with Claude, no code. Here is what it did for <em class="kw">us</em>:</h2></div>
        <!-- 28/11 Nico: «non dire i sales, essere più generali» (N3): no money, no numbers to keep up to date -->
        <div class="bud-proof">
          <div><b>Millions</b><small>of views on our reels</small></div>
          <div><b>Every week</b><small>developers write to us</small></div>
          <div><b>Worldwide</b><small>from Dubai to Mumbai</small></div>
        </div>
        <button type="button" class="bud-go" data-jnext>What's inside?</button>
      </section>
      <section class="jc jin" data-c="3" aria-labelledby="t3f-c3">
        <div class="bud-say"><img src="/club/knot-96.webp" alt="" width="64" height="64"><h2 id="t3f-c3" tabindex="-1" class="jq">Inside the club you learn it <em class="kw">step by step</em> 👇</h2></div>
        <div class="bud-mock"><img src="/club/join/inside.webp" alt="The course inside the club: the player and the list of the steps" width="780" height="1310" loading="lazy" decoding="async">
          <ul><li><b>Step-by-step video courses</b><small>SAMAR first: 11 steps</small></li><li><b>A new build every Friday</b><small>with the files and the skills</small></li><li><b>My comments every Monday</b><small>on what you build</small></li></ul></div>
        <button type="button" class="bud-go" data-jnext>I want it</button>
      </section>
      <section class="jc jbuild" data-c="4" data-tb aria-labelledby="t3f-c4">
        <div class="bud-say"><img src="/club/knot-96.webp" alt="" width="64" height="64"><h2 id="t3f-c4" tabindex="-1" class="jq">What do you want to <em class="kw">build</em> first?</h2></div>
        <div class="tb-track" role="radiogroup" aria-labelledby="t3f-c4" data-tbt>
          {BUILD4.map((o, i) => (
            <button type="button" class="tb" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-tbk={o.k}>
              <img src={`/club/join/t-${o.k}.webp`} alt="" width="900" height="900" loading="lazy" decoding="async" />
              <span class="tb-t"><b>{o.t}</b><small>{o.s}</small></span>
            </button>
          ))}
        </div>
        <div class="tb-pills" data-tbp>{BUILD4.map((o, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-tbgo={o.k}>{o.t}</button>)}</div>
        <button type="button" class="bud-go" data-jnext>See my plan</button>
      </section>
      <section class="jc jplan" data-c="5" aria-labelledby="t3f-c5">
        <div class="bud-conf" aria-hidden="true">{Array.from({ length: 18 }, (_, k) => <i style={`left:${(k * 37) % 100}%;top:${-((k * 13) % 60)}%;background:${['#58cc6a', '#ffc800', '#5aa8ff', '#ff5f8f'][k % 4]};animation-delay:${(k % 6) * 0.35}s`}></i>)}</div>
        <div class="bud-say"><img src="/club/knot-96.webp" alt="" width="64" height="64"><h2 id="t3f-c5" tabindex="-1" class="jq">Here is your plan! 🎉</h2></div>
        <div class="bud-rows">
          <div><span aria-hidden="true">🏙️</span><b data-plan="build"></b></div>
          <div><span aria-hidden="true">📅</span><b>A new build every Friday, my comments on your builds every Monday</b></div>
          <div><span aria-hidden="true">🎓</span><b>From zero: every message to Claude, word for word</b></div>
        </div>
        <button type="button" class="bud-go" data-jnext>What do I get?</button>
      </section>
      <section class="jc joffer" data-c="6" aria-labelledby="t3f-c6">
        <div class="bud-say"><img src="/club/knot-96.webp" alt="" width="64" height="64"><h2 id="t3f-c6" tabindex="-1" class="jq">Everything you get 👇</h2></div>
        <div class="bud-stack">
          {VALUE.map(([t, v]) => <div><i aria-hidden="true">✓</i><span>{t}</span>{/€/.test(v) ? <s>{v.replace(' on our site', '')}</s> : <em>{v || 'weekly'}</em>}</div>)}
          <div class="bud-tot"><span>On our site</span><s>€150+</s></div>
          <div class="bud-you"><span data-when="before">You pay today</span><span data-when="early open after">You pay</span><b data-when="before">€0</b><b data-when="early open after"><span data-payeur>€9</span><small>/month</small></b></div>
        </div>
        <p class="bud-chip hot" data-when="before">🎁 <span>The first 100 who reserve get the <b>founders' gift</b>. Then <b>€9/month</b> from Saturday 28 November.</span></p>
        <p class="bud-chip hot" data-when="early open" data-fbox>⏳ <span>Founders' price ends in <b data-fleft>…</b> · then €19</span></p>
        <p class="bud-chip safe">🛡️ <span data-when="before">Cancel before Saturday and you pay nothing · 14 days to withdraw</span><span data-when="early open after">Cancel whenever you want · 14 days to withdraw</span></p>
        <button type="button" class="bud-go" data-jnext><span data-when="before">Reserve my seat</span><span data-when="early open after">Lock <span data-payeur>€9</span>/month</span></button>
      </section>
      <section class="jc jcard" data-c="7" aria-labelledby="t3f-c7">
        <div class="bud-say"><img src="/club/knot-96.webp" alt="" width="64" height="64"><h2 id="t3f-c7" tabindex="-1" class="jq"><span data-when="before">Last step! Your seat, nothing charged today 🔑</span><span data-when="early open after">Last step! In a minute you're inside 🔑</span></h2></div>
        <div class="bud-now">
          <span class="k" data-when="before">On Saturday at 9:00 (Rome)</span><span class="k" data-when="early open after">Right after you join</span>
          <div><i aria-hidden="true">✓</i><span>Your own link to the club, by email</span></div>
          <div><i aria-hidden="true">✓</i><span>The SAMAR course: step 01 opens</span></div>
          <div><i aria-hidden="true">✓</i><span>The Vault: 6 builds and 9 full guides</span></div>
          <div><i aria-hidden="true">✓</i><span>Your House Builder skill, yours to keep</span></div>
        </div>
        <p class="paid" data-paid hidden><Icon name="check" /><span>Guide found · €9 a month for you, after Friday 4 December too</span></p>
        <form class="jform" data-payform novalidate>
          <div class="field"><label for="t3f-pn">Name</label><input id="t3f-pn" name="name" required autocomplete="name" maxlength="60" placeholder="Your name"></div>
          <div class="field"><label for="t3f-pe">Email</label><input id="t3f-pe" name="email" type="email" required autocomplete="email" inputmode="email" maxlength="120" placeholder="you@studio.com"></div>
          <label class="hp" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off"></label>
          <button class="btn cta wide jgo bud-go" type="submit" data-go>Join the club</button>
        </form>
        <div class="jpay" data-paystage hidden>
          <p class="jme"><span data-me></span><button type="button" data-jedit>Change</button></p>
          <div class="paybox" data-paybox></div>
          <button type="button" class="btn cta wide jgo bud-go" data-pay><span data-when="before">Reserve my seat · €0 today</span><span data-when="early open after">Pay <span data-payeur2>€9</span> a month</span></button>
        </div>
        <p class="pnote" data-early hidden>Doors open for everyone at 18:00</p>
        <p class="perr" data-perr role="alert"></p>
        <p class="jsafe" data-when="before">Cancel before Saturday and you pay nothing.</p>
        <p class="small"><Icon name="lock" /><span>Secure payment by Stripe · <a href="/the-3d-future/terms" target="_blank" rel="noopener">Terms</a></span></p>
      </section>
    </div>
  </div>
</div>

<div class="sheetwrap" data-sheet hidden>
  <div class="scrim" data-sheetx></div>
  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="t3f-sh">
    <div class="grab" aria-hidden="true"></div>
    <button type="button" class="rb ctr x" data-sheetx aria-label="Close"><Icon name="x" /></button>
    <p class="s-eyebrow">Sat 28 Nov · 09:00 CET</p>
    <h3 class="s-title" id="t3f-sh">Put it in your calendar</h3>
    <p class="s-text">One hour, the time your door opens, with the link to get in.</p>
    <div class="cal">
      <a data-ics href="#" download="the-3d-future.ics"><span class="ci" style="background:#ff3b30">28</span><span>Apple Calendar</span><Icon name="chev" /></a>
      <a data-gcal href="#" target="_blank" rel="noopener"><span class="ci" style="background:#1a73e8">G</span><span>Google Calendar</span><Icon name="chev" /></a>
      <a data-ocal href="#" target="_blank" rel="noopener"><span class="ci" style="background:#0f6cbd">O</span><span>Outlook</span><Icon name="chev" /></a>
    </div>
  </div>
</div>
<div class="toast" role="status" aria-live="polite" data-toast></div>
