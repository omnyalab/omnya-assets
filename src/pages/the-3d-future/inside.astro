---
// /the-3d-future/inside?m=<member link> (25/11, Nico: «tutto nel sito», no Skool): the members' page of THE 3D FUTURE.
// 25/11 evening (Nico: «noi avevamo fatto tutto il profilo, tutte le card… bisogna adattare la pagina delle card e
// inserirla dentro tutto quello che avevamo già fatto»): the member area of board A of 20/11
// (https://claude.ai/artifact/E9JsJzy1K8P1B4ceYPQaJK, direction A, choices H6 P1 M3 B2) taken as it is: its own CSS
// (components/club/board-a.css, a copy of the board's), the glass top bar and tab bar, the Home of glass widgets and photo
// cards, the Vault of stacked photo cards, the profile M3 (the photo melts into its own blurred copy) with the B2 trophy
// badges. Inside it, the new pieces: Nico's welcome video, the eleven B3 step cards of the course (unchanged), the files
// of the Vault, every Full guide, the skills, the founders' gift, «Send me your build», cancel and withdraw.
// No invented numbers: where the board had example data (minutes, likes, streaks, levels) the page shows what is real
// (real dates, what the member has) or leaves the widget out; badges not earned yet are grey with a lock.
// 25/11 (Nico: «il corso in primo piano… quando lo schiacci ti escono tutte le card», «B, vai»): the course the member is on is
// one big card on top of Home; a tap opens the fifth tab, Courses, with its eleven step cards and the next course.
// Everything personal comes from /api/club/inside (api/_lib/club.js
// insideData) at every visit; the file links last one day. noindex.
import '../../components/club/board-a.css';
import { badgeB2 } from '../../components/club/badges';
const BADGES: [string, string, string][] = [
  ['founder', 'Founder', 'One of the first 100 who reserved'],
  ['first', 'First build', 'Post your first build'],
  ['tower', 'Tower', 'Finish the SAMAR course'],
  ['stadium', 'Stadium', 'Build the stadium of the Vault'],
  ['house', 'House', 'Build the house of the Vault'],
  ['month', 'Build of the Month', 'Win a monthly challenge'],
];
const SVG = Object.fromEntries(BADGES.map(([k]) => [k, badgeB2(k)]));
