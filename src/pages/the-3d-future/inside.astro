      </div>
      <div class="pmain">
        <div class="glass w wide2 badgesw"><span class="k">${ic('trophy')}Badges<span class="r">${nOn} of ${BL.length}</span></span><div class="medals lg">${BL.map((b, i) => medal(b, earned[i])).join('')}</div></div>
        ${certHTML()}
        ${open ? `<div class="objs">${[['/club/course/step-05.webp', (d.lessons || []).length, 'course steps', GO_COURSE], ['/club/v-towers-760.webp', (d.vault || []).length, 'Vault builds', 'vault'], [founder ? '/club/v-plane-760.webp' : '/club/v-miami-760.webp', founder ? d.gifts.length : (d.guides || []).length, founder ? "founders' gifts" : 'Full guides', founder ? 'gift' : 'vault']].map(([im, n, l, go]) => `<a class="glass obj" href="#${go}" data-go="${go}"><img src="${im}" alt=""><b>${n}</b><span>${l}</span></a>`).join('')}</div>` : ''}
        <div class="glass w wide2"><span class="k">${ic('person')}Your membership</span>
          <p class="msmall">${d.portal ? `To cancel: <a href="${esc(d.portal)}" target="_blank" rel="noopener">open Stripe</a> (your email, then a code). ` : ''}To withdraw within 14 days: <a href="/withdraw">omnyalab.com/withdraw</a>.</p></div>
      </div></div></div>`
    const tabs = `<div class="tabbar"><div class="tabin t${TABS.length}" role="tablist">${TABS.map(([k, i, t]) => `<button type="button" data-go="${k}">${ic(i)}<span>${t}</span></button>`).join('')}</div></div>`
    app.insertAdjacentHTML('afterbegin', '') // keep the background first
    root.insertAdjacentHTML('beforebegin', top + `<div class="mhd"><a href="#home" data-go="home" aria-label="THE 3D FUTURE, Home"><img src="/club/knot-96.webp" alt="" width="28" height="28">THE <b>3D</b> FUTURE</a></div>`)
    root.innerHTML = home + courseV + vault + chal + gifts + me
    app.insertAdjacentHTML('beforeend', tabs)
    if (d.lessons) course_(d.lessons)
    document.body.insertAdjacentHTML('beforeend', `<button type="button" class="hbfab" data-menu aria-label="Open the menu" aria-expanded="false"><span></span><span></span><span></span>${founder ? '<i class="dotg" aria-hidden="true"></i>' : ''}</button>`)
    wire()
    loadFeed()
    appSetup()
    opnDone(true)
    buddyInit()
  }
  const course_ = ls => course(ls)

  /* the screens: a tap on the bar shows one (board A), the address keeps it (#vault) */
  const SCREENS = ['home', 'course', 'vault', 'feed', 'gifts', 'me']
  function show(k, push) {
    let target = null
    if (k === 'course-list') { k = 'course'; target = 'course-list' }
    if (k === 'send') { k = 'home'; target = 'send' }
    if (k === 'chal') k = 'feed'
    if (k === 'gift') k = 'gifts'
    if (k === 'guides' || k === 'skills') { target = k; k = 'vault' }
    if (!SCREENS.includes(k) || !$(`[data-v="${k}"]`)) k = 'home'
    app.dataset.screen = k; if (budOn()) buddyNudge(k)
    $$('.links [data-go], .tabin [data-go]').forEach(a => { if (a.dataset.go === k) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current') })
    const bg = $('[data-mbg]'); if (bg && BG[k] && !bg.src.endsWith(BG[k])) bg.src = BG[k]
    if (push !== false && location.hash !== '#' + k) try { history.pushState(null, '', '#' + k) } catch (e) {}
    // the cards of a screen that was hidden come in when it shows
    setTimeout(() => $$(`[data-v="${k}"] .steps2 li`).forEach(li => li.classList.add('in')), 350)
    if (target) setTimeout(() => { const el = document.getElementById(target); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' }) }, 40); else if (push !== false) scrollTo({ top: 0 })
  }
  function wire() {
    document.addEventListener('click', e => {
      const mb = e.target.closest('[data-menu]'); if (mb) { menuOpen() ? closeMenu() : openMenu(); return }
      if (e.target.closest('[data-mclose]')) { closeMenu(); return }
      const mg = e.target.closest('[data-mgo]'); if (mg) { menuGo(mg.dataset.mgo); return }
      const g = e.target.closest('[data-go]'); if (g) { e.preventDefault(); closeMenu(); show(g.dataset.go); return }
      if (e.target.closest('[data-gifts]')) { show('gifts'); return }
      const hd = e.target.closest('[data-hide]'); if (hd) { doHide(hd.dataset.hide, hd.dataset.on === '1'); return }
      if (e.target.closest('[data-compose]')) { compose(); return }
      if (e.target.closest('[data-editp]')) { editProfile(); return }
      const lk = e.target.closest('[data-like]'); if (lk) { doLike(lk.dataset.like, lk); return }
      const cm = e.target.closest('[data-cmt]'); if (cm) { postSheet(cm.dataset.cmt); return }
      const sh = e.target.closest('[data-share]'); if (sh) { doShare(sh.dataset.share); return }
      const b = e.target.closest("[data-vb]"); if (b) { openBuild(+b.dataset.vb); return }
      if (e.target.closest('[data-next]')) { toast('The next build opens Friday 4 December'); return }
      if (e.target.closest('[data-sheetx]')) closeSheet()
    })
    // the Vault: on the computer the card under the pointer opens (board A)
    $$('.vx').forEach(c => c.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); c.click() } }))
    vxInit()
    $$('[data-hello] video').forEach(v => v.addEventListener('timeupdate', () => { if (v.duration && v.currentTime / v.duration >= 0.9) markHello() }))
    $$('[data-hello] video').forEach(v => { const go = () => { if (!v.controls) { v.controls = true; v.play().catch(() => {}) } }
      v.addEventListener('click', go); v.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go() } }) })
    document.addEventListener('submit', e => { const f = e.target.closest('[data-cform]'); if (!f) return; e.preventDefault()
      const id = f.dataset.cform, t = f.t.value.trim(), b = $('button', f); if (!t) return; b.disabled = true
      post('/api/club/comment', { m, id, text: t }).then(r => { b.disabled = false; if (!r.ok) { toast(r.d.error || 'Something went wrong, try again'); return }
        f.reset(); const l = $('[data-clist]'); if (l) { if (!$('.crow', l)) l.innerHTML = ''; l.insertAdjacentHTML('beforeend', cRow(r.d.comment)); l.scrollTop = l.scrollHeight }
        const p = byId(id); if (p) { p.comments = r.d.comments; paint(id) } }) })
    addEventListener('keydown', e => { if (e.key === 'Escape' && menuOpen()) closeMenu() })
    $$('[data-build]').forEach(f => f.tagName === 'FORM' && f.addEventListener('submit', e => {
      e.preventDefault(); const msg = $('[data-build-msg]', f), btn = $('button', f), link = f.link.value.trim()
      if (!/^https?:\/\/[^\s]+\.[^\s]+$/i.test(link)) { msg.className = 'err'; msg.textContent = 'Paste the link of your build, like https://your-tower.netlify.app'; return }
      btn.disabled = true; msg.textContent = ''
      post('/api/club/build', { m, link, note: f.note.value.trim() }).then(r => { msg.className = r.ok ? 'err ok' : 'err'; msg.textContent = r.ok ? 'Sent. I answer you by email on Monday.' : (r.d.error || 'Something went wrong, try again'); if (r.ok) f.reset() })
        .catch(() => { msg.className = 'err'; msg.textContent = 'Something went wrong, try again' }).then(() => { btn.disabled = false })
    }))
    const start = (location.hash || '').slice(1); show(SCREENS.includes(start) ? start : 'home', false)
    addEventListener('popstate', () => { const h = (location.hash || '').slice(1); closeMenu(); if (!sheet.hidden) closeSheet(); show(SCREENS.includes(h) ? h : 'home', false) })
    // the file links last one day: a page kept open (the app on the Home Screen) gets fresh ones when it comes back after hours
    let away = 0; document.addEventListener('visibilitychange', () => { if (document.hidden) away = Date.now(); else if (away && Date.now() - away > 6 * 36e5) location.reload(); else if (away) fresh() })
    // 27/11 (Nico saw an old version in the Home Screen app): when the page comes back, a new version of the site reloads it
    const vOf = () => fetch(location.pathname + '?v=' + Date.now(), { method: 'HEAD', cache: 'no-store' }).then(r => r.headers.get('etag') || '').catch(() => '')
    let V0 = ''; vOf().then(v => { V0 = v })
    function fresh() { vOf().then(v => { if (V0 && v && v !== V0) location.reload() }) }
    setInterval(() => { if (!document.hidden) fresh() }, 10 * 60e3)
  }
  let DATA = null
  const sheet = $('[data-sheet]')
  $('[data-sheet] .sx').innerHTML = ic('x')
  /* the Vault carousel: which card is in front, the counter, the dots, «Swipe» until the first swipe, the arrows on the computer */
  function vxInit() {
    const t = $('[data-vxt]'); if (!t) return
    const cards = $$('.vx', t), dots = $$('[data-vxd] i'), cnt = $('[data-vxc]'), w = $('[data-vx]')
    let seen = false; try { seen = !!localStorage.getItem('t3f-vx') } catch (e) {}
    if (seen) w.dataset.swiped = '1'
    const at = () => { const step = cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : 1; return Math.max(0, Math.min(cards.length - 1, Math.round(t.scrollLeft / step))) }
    let last = 0
    t.addEventListener('scroll', () => { const k = at(); if (k !== last) { last = k; cnt.textContent = `${k + 1} / ${cards.length}`; dots.forEach((d, j) => d.classList.toggle('on', j === k)) }
      if (t.scrollLeft > 30 && !w.dataset.swiped) { w.dataset.swiped = '1'; try { localStorage.setItem('t3f-vx', '1') } catch (e) {} } }, { passive: true })
    w.addEventListener('click', e => { const b = e.target.closest('[data-vxgo]'); if (!b) return; const k = Math.max(0, Math.min(cards.length - 1, at() + +b.dataset.vxgo)); t.scrollTo({ left: cards[k].offsetLeft - cards[0].offsetLeft, behavior: RMx ? 'auto' : 'smooth' }) })
    // the first time: the row moves a little and comes back, so it is clear that it scrolls
    if (!seen && !RMx) setTimeout(() => { if (t.scrollLeft < 5 && $('[data-screen="vault"]')) { t.scrollTo({ left: 64, behavior: 'smooth' }); setTimeout(() => { if (t.scrollLeft < 80) t.scrollTo({ left: 0, behavior: 'smooth' }) }, 650) } }, 900)
  }
  const RMx = matchMedia('(prefers-reduced-motion: reduce)').matches
  function openBuild(i) {
    const b = DATA && DATA.vault && DATA.vault[i]; if (!b) return
    $('[data-sheetbody]').innerHTML = `<p class="s-eyebrow">${esc(b.type)}</p><h3 class="s-title" id="t3m-sh">${esc(b.t)}</h3><img class="s-img" src="/club/v-${esc(b.img)}-760.webp" alt="">${b.files.map(f => fl(f) + (f.note ? `<p class="snote">${esc(f.note)}</p>` : '')).join('')}`
    sheet.hidden = false; requestAnimationFrame(() => sheet.classList.add('on')); document.documentElement.style.overflow = 'hidden'
  }
  function closeSheet() { sheet.classList.remove('on'); document.documentElement.style.overflow = ''; setTimeout(() => { sheet.hidden = true }, 300) }
  addEventListener('keydown', e => { if (e.key === 'Escape' && !sheet.hidden) closeSheet() })

  /* states before the member area: no link, the link went bad, the membership ended */
  const stateH = $('[data-state-h]')
  const say = t => { stateH.textContent = t; stateH.classList.remove('sr'); opnDone(false) }
  function lost(msg) {
    opnDone(false)
    root.innerHTML = `<div class="mtop"><div><p class="eyebrow">THE 3D FUTURE</p><h1>Log in to the club</h1></div></div><form class="glass mbox" data-lost novalidate><p>${esc(msg || 'Write the email you joined with. Your link to the club arrives in a minute, no password.')}</p>
      <label for="t3m-e" class="sr">Email</label><input id="t3m-e" name="email" type="email" autocomplete="email" inputmode="email" maxlength="120" placeholder="you@studio.com" required>
      <button class="btn cta wide" type="submit">Send my link</button><p class="err" role="status" data-lost-msg></p><p class="lostjoin">Not a member yet? <a href="/the-3d-future">Join for €9/month</a></p></form>`
    $('[data-lost]').addEventListener('submit', e => {
      e.preventDefault(); const f = e.currentTarget, msg = $('[data-lost-msg]'), btn = $('button', f), email = f.email.value.trim()
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { msg.textContent = 'That email does not look right'; return }
      btn.disabled = true; msg.textContent = ''
      post('/api/club/link', { email }).then(r => { msg.className = r.ok ? 'err ok' : 'err'; msg.textContent = r.ok ? 'If that email is a member, your link is on its way. Check your inbox (and the spam folder).' : (r.d.error || 'Something went wrong, try again') })
        .catch(() => { msg.textContent = 'Something went wrong, try again' }).then(() => { btn.disabled = false })
    })
  }
  if (!m) { let k = ''; try { k = localStorage.getItem('t3f-m') || '' } catch (e) {}; if (k) location.replace(location.pathname + '?m=' + encodeURIComponent(k) + location.hash); else lost() }
  else fetch('/api/club/inside?m=' + encodeURIComponent(m)).then(r => r.json().then(d => ({ ok: r.ok, d }))).then(({ ok, d }) => {
    if (!ok) { try { if (localStorage.getItem('t3f-m') === m) localStorage.removeItem('t3f-m') } catch (e) {}; return lost(d.error) }
    if (d.state === 'none') { say('We are getting your seat ready. Refresh this page in a minute.'); return }
    if (d.state === 'ended') { opnDone(false); root.innerHTML = `<div class="mtop"><div><h1>Your membership has ended</h1></div></div><div class="glass mbox"><p>Thank you for being part of it. If you want to come back, the doors are always open: <a href="/the-3d-future">omnyalab.com/the-3d-future</a>.</p></div>`; return }
    DATA = d; render(d)
  }).catch(() => { say('Could not open the club right now, try again in a minute.') })
}

</script>
</body>
</html>
