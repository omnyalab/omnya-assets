---
// 18/11 (Nico): the Plane thanks page (/learn/thanks/full-plane) in the sky blue of its funnel.
// Made by scripts/make-plane-ry.py from the Riyadh violet block of views/Thanks.astro. is:inline: only on that page.
---
<style is:inline>
  /* 17/11 (Nico): after paying for the Plane guide the page is in the colours of that funnel (plane sky blue, white text) */
  :root{--bg:#060e13;--ink:#ffffff;--mute:#9cbdcd;--mute-lg:#84a2b1;--line:#20333c}
  html,body{background:radial-gradient(900px 600px at 50% -8%,#38b6ff33,#0000 70%),#060e13!important;color:#fff}
  .oto .btn--fill,.oto-dl .btn--fill{background:#38b6ff!important;border-color:#38b6ff!important;color:#fff!important}
  .oto__steps .is-done span,.oto__steps .is-now span{background:#38b6ff!important;color:#fff!important;border-color:#38b6ff!important}
  .hdr .logo__img--dark{filter:invert(1)}
  .hdr::before{background:#060e13e6!important;border-bottom-color:#20333c!important}
  .hdr{color:#fff!important}
  .wa-fab{background:#38b6ff!important;color:#fff!important}
  html[data-page='thanks'] .oto-dl{background:linear-gradient(160deg,#ffffff1a,#ffffff08)!important;border:1px solid #ffffff26!important;-webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px);color:#fff!important;box-shadow:0 40px 80px -40px #38b6ffaa,inset 0 1px #ffffff33!important}
  html[data-page='thanks'] .oto-dl *{color:#fff}
  html[data-page='thanks'] .oto-dl .t-sub{color:#fff!important;-webkit-text-fill-color:#fff!important}
  html[data-page='thanks'] .oto-dl .oto-dl__note,html[data-page='thanks'] .oto-dl .oto-dl__note *{color:#9cbdcd!important}
  html[data-page='thanks'] .oto-dl .btn:not(.btn--fill){background:#ffffff14!important;border-color:#ffffff33!important;color:#fff!important}
  html[data-page='thanks'] .oto__down{background:#38b6ff!important}
  html[data-page='thanks'] .oto__head{display:none}
  html[data-page='thanks'] .oto__card{background:#0a1b24!important;border:1px solid #20333c;box-shadow:0 40px 70px -40px #38b6ff88!important;color:#fff}
  html[data-page='thanks'] .oto__card *{color:#fff}
  html[data-page='thanks'] .oto__card .t-sub,html[data-page='thanks'] .oto__card p{color:#b5d1df}

</style>
