---
// /the-3d-future/inside?m=<member link> (25/11, Nico: «tutto nel sito», no Skool): the members' page of THE 3D FUTURE.
// The page is static; everything personal comes from /api/club/inside (api/_lib/club.js insideData) at every visit:
//   open     the first course (five lessons, a video each once it is online), the course skill, the Vault with the six
//            builds and their files, every Full guide, the House Builder skill, the founders' gift for the first 100
//            reservations, «Send me your build» (to Nico by email) and the cancel link
//   waiting  a reservation whose first payment has not gone through: the club opens on Saturday 28/11 at 9:00 (Rome)
//   ended    the membership was cancelled
//   no link, or a wrong one: «Write your email and we send you your link» (POST /api/club/link, same answer for all)
// The file links last one day: a new visit makes new ones. noindex.
import Club from '../../layouts/Club.astro';
---
<Club title="Inside THE 3D FUTURE" noindex>
  <h1 data-hi>Welcome inside.</h1>
  <p class="lead" data-state>Opening the club…</p>

  {/* 25/11 (Nico): his thank-you video on top whenever a member comes in */}
  <div class="hello" data-hello hidden>
    <video playsinline preload="metadata" poster="/club/intro-nico-cover.webp" tabindex="0" aria-label="Play the welcome from Nico" style="cursor:pointer">
      <source src="/club/intro-nico-v2-720.mp4" media="(max-width: 700px)" type="video/mp4">
      <source src="/club/intro-nico-v2.mp4" type="video/mp4">
    </video>
  </div>

  {/* no link, or a wrong one */}
  <form class="box" data-lost hidden novalidate>
    <h2>Get your link to the club</h2>
    <p>Write the email you paid with and we send you your own link.</p>
    <label for="t3i-e">Email</label>
    <input class="in" id="t3i-e" name="email" type="email" autocomplete="email" inputmode="email" maxlength="120" placeholder="you@studio.com" required>
    <button class="btn" type="submit">Send me my link</button>
    <p class="err" role="status" data-lost-msg></p>
  </form>

  {/* the reservation, before the first payment */}
  <div class="box" data-waiting hidden>
    <h2>Your seat is reserved</h2>
    <p>The club opens on Saturday 28 November at 9:00 (Rome), when your first month starts. Come back to this page then: your courses, the Vault and every Full guide will be here.</p>
  </div>

  <div class="box" data-ended hidden>
    <h2>Your membership has ended</h2>
    <p>Thank you for being part of it. If you want to come back, the doors are always open: <a href="/the-3d-future">omnyalab.com/the-3d-future</a>.</p>
  </div>

  {/* 25/11 (Nico, L2): the first course, eleven steps as cards, each locked until it opens on Saturday 28/11 */}
  <section class="course" data-course hidden>
    <div class="chead">
      <span class="eyebrow">Your first course</span>
      <h2>SAMAR, <span class="g">floor by floor</span></h2>
      <p>Eleven steps, from an empty folder to a tower online where buyers choose their floor, built the real way we build them for our clients.</p>
      <div class="cd" data-cd>
        <div class="num"><span><b data-u="d">0</b><small>days</small></span><span><b data-u="h">00</b><small>hours</small></span><span><b data-u="m">00</b><small>min</small></span><span><b data-u="s">00</b><small>sec</small></span></div>
        <span class="when">Every step opens on Saturday 28 November at 9:00 (Rome)</span>
      </div>
    </div>
    <ol class="steps2" data-lessons></ol>
  </section>

  <div data-open hidden>
    <div class="file" data-skill></div>

    <section class="sec">
      <h2>Send me your build</h2>
      <p class="mute">When your tower is online, paste its link here. I look at every first build myself and I answer you by email every Monday.</p>
      <form class="box sendb" data-build novalidate>
        <label for="t3i-l">The link of your build</label>
        <input class="in" id="t3i-l" name="link" type="url" inputmode="url" maxlength="300" placeholder="https://your-tower.netlify.app" required>
        <label for="t3i-n">A note for me (optional)</label>
        <textarea class="in" id="t3i-n" name="note" rows="3" maxlength="1500" placeholder="What you'd like me to look at"></textarea>
        <button class="btn" type="submit">Send it to Nico</button>
        <p class="err" role="status" data-build-msg></p>
      </form>
    </section>

    <section class="sec">
      <h2>The Vault</h2>
      <p class="mute">Six builds from our reels, each with its files, prompts and Claude skills. A new one comes every Friday.</p>
      <div class="vault" data-vault></div>
    </section>

    <section class="sec" data-gifts-sec hidden>
      <h2>Your founders' gift</h2>
      <p class="mute">You reserved your seat among the first 100, so these are yours to keep.</p>
      <div class="files" data-gifts></div>
    </section>

    <section class="sec">
      <h2>Every Full guide</h2>
      <div class="files" data-guides></div>
    </section>

    <section class="sec">
      <h2>Your bonus</h2>
      <div class="files" data-house></div>
    </section>
  </div>

  <p class="mute small" data-foot hidden><span data-cancel></span> To withdraw within 14 days: <a href="/withdraw">omnyalab.com/withdraw</a>.</p>
</Club>

<style is:global>
  .cl{width:min(980px,100%)}
</style>
<style is:global>
  /* global: most of the page is written by the script below (scoped styles would not reach it) */
  .sec{margin:42px 0 0}
  .sec > h2{margin:0 0 6px}
  .sec > p{margin:0 0 18px;max-width:62ch}
  .small{font-size:14px;margin-top:44px}
  .hello{margin:22px 0 26px;aspect-ratio:16/9;border-radius:20px;overflow:hidden;background:#000;border:1px solid #ffffff1f;box-shadow:0 30px 70px -30px #000c}.hello video{display:block;width:100%;height:100%;object-fit:cover}
  /* the course (L2): a header with a live countdown, then eleven cards, each with a glass lock until its video is online */
  .course{margin:34px 0 0}
  .g{background:linear-gradient(180deg,#f2f9ff 0%,#a6d4ff 36%,#3f8cff 70%,#2457e0 100%);-webkit-background-clip:text;background-clip:text;color:transparent;padding-right:.06em}
  .chead{display:grid;gap:12px;margin:0 0 22px}
  .chead .eyebrow{display:inline-flex;width:max-content;padding:6px 14px;border-radius:999px;background:#ffffff10;border:1px solid var(--line);font:600 12.5px Geist,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
  .chead h2{margin:0;font:700 clamp(30px,6vw,44px)/1.04 Geist,sans-serif;letter-spacing:-.035em}
  .chead p{margin:0;max-width:60ch;color:#cfdcf2;font-size:17px}
  .cd{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:4px}
  .cd .num{display:flex;gap:8px}
  .cd .num span{display:grid;justify-items:center;min-width:62px;padding:8px 10px;border-radius:14px;background:#ffffff12;border:1px solid var(--line)}
  .cd .num b{font:700 25px/1.1 Geist,sans-serif;font-variant-numeric:tabular-nums}
  .cd .num small{font:500 10.5px Geist,sans-serif;letter-spacing:.12em;color:var(--mute);text-transform:uppercase}
  .cd .when{font:500 15px Geist,sans-serif;color:var(--mute)}
  /* B3 (Nico 25/11): the card looks like the approved step covers: the cover photo blurred with grain, big number, big title
     with the keyword in azure, a thin azure light, a round glass lock, one short line */
  .steps2{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:14px}
  .steps2 li{position:relative;overflow:hidden;isolation:isolate;min-height:270px;padding:22px 22px 20px;border-radius:24px;background:#0a1428;border:1px solid var(--line);display:flex;flex-direction:column;transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.2,1)}
  .steps2.rv li{opacity:0;transform:translateY(18px)}
  .steps2.rv li.in{opacity:1;transform:none}
  .steps2 li > *{position:relative;z-index:2}
  .steps2 li > .sbg{position:absolute;z-index:0;inset:-12px;background-size:cover;background-position:center;opacity:.95;transform:scale(1.06)}
  .steps2 li > .sveil{position:absolute;z-index:1;inset:0;background:linear-gradient(180deg,#05091588 0%,#05091555 38%,#050915e0 100%)}
  .steps2 li > .sgrain{position:absolute;z-index:1;inset:0;opacity:.09;mix-blend-mode:overlay;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
  .steps2 .stop{display:flex;justify-content:space-between;align-items:flex-start}
  .steps2 .no{font:700 54px/.85 Geist,sans-serif;letter-spacing:-.06em;color:#fff;text-shadow:0 4px 30px #0008;font-variant-numeric:tabular-nums}
  .steps2 h3{margin:auto 0 8px;font:700 26px/1.04 Geist,sans-serif;letter-spacing:-.035em;text-wrap:balance;text-shadow:0 3px 24px #0009}
  .steps2 h3 em{font-style:normal;background:linear-gradient(100deg,#e2f1ff 0%,#8ccaff 45%,#5a9dff 100%);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:none;filter:drop-shadow(0 2px 10px #000c) drop-shadow(0 0 14px #2f7bff66)}
  .steps2 .sfl{display:block;height:1px;margin:2px 0 10px;background:linear-gradient(90deg,#6fb6ff00,#8cc4ffcc 40%,#dceeff 50%,#8cc4ffcc 60%,#6fb6ff00);opacity:.7}
  .steps2 p{margin:0 0 14px;color:#ffffffcc;font-size:15px;line-height:1.4;max-width:34ch}
  .steps2 video{display:block;width:100%;aspect-ratio:16/9;margin-top:4px;border-radius:14px;background:#000}
  .lk{position:relative;flex:none;width:50px;height:50px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(70% 70% at 35% 25%,#ffffff40,#ffffff10 60%);border:1px solid #ffffff38;backdrop-filter:blur(10px);box-shadow:0 0 0 6px #5aa8ff14,0 10px 30px -8px #2a74ffaa}
  .lk svg{width:22px;height:22px;filter:drop-shadow(0 0 6px #5aa8ffaa)}
  .lk::after{content:"";position:absolute;inset:-7px;border-radius:50%;border:1px solid #8cc4ff;opacity:0;animation:lkring 3.2s ease-out infinite;animation-delay:var(--d,0s)}
  @keyframes lkring{0%{opacity:.6;transform:scale(.9)}70%,100%{opacity:0;transform:scale(1.25)}}
  .lk-pill{align-self:flex-start;display:inline-flex;align-items:center;gap:7px;padding:5px 11px;border-radius:999px;background:#05091599;border:1px solid var(--line);font:600 12.5px Geist,sans-serif;color:#cfe3ff}
  .lk-pill i{width:7px;height:7px;border-radius:50%;background:#5ab8ff;box-shadow:0 0 0 4px #5ab8ff2a}
  @media (max-width:600px){.cd .num span{min-width:54px}.cd .num b{font-size:21px}}
  @media (prefers-reduced-motion:reduce){.lk::after{animation:none}.steps2.rv li{opacity:1;transform:none}}
  .lessons{list-style:none;margin:0;padding:0;display:grid;gap:14px}
  .lessons li{border-radius:18px;background:linear-gradient(160deg,#ffffff12,#ffffff05);border:1px solid var(--line);overflow:hidden}
  .lessons .lh{display:flex;align-items:center;gap:14px;padding:14px 16px}
  .lessons .num{flex:none;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--blue);font:700 15px Geist,sans-serif}
  .lessons .lt{flex:1;min-width:0;font:600 16.5px/1.3 Geist,sans-serif}
  .lessons .ld{flex:none;font:500 14px Geist,sans-serif;color:var(--mute);font-variant-numeric:tabular-nums}
  .lessons video{display:block;width:100%;aspect-ratio:16/9;background:#000}
  .lessons .soon{margin:0;padding:0 16px 14px 64px;font-size:14px;color:var(--mute)}
  .vault{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
  .vb{border-radius:18px;overflow:hidden;background:linear-gradient(160deg,#ffffff12,#ffffff05);border:1px solid var(--line)}
  .vb img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}
  .vb .vbb{padding:14px 16px 16px}
  .vb h3{margin:0;font:600 18px/1.2 Geist,sans-serif}
  .vb .ty{margin:2px 0 12px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}
  .files{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px}
  .vb .files{grid-template-columns:1fr;gap:8px}
  .fl{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;border:1px solid #ffffff26;background:#0b1428;color:#fff;text-decoration:none;font:500 15px/1.3 Geist,sans-serif}
  .fl:hover{border-color:var(--blue2)}
  .fl b{flex:none;font:600 11px Geist,sans-serif;letter-spacing:.1em;padding:4px 7px;border-radius:6px;background:#ffffff18;color:#cfe5ff}
  .fl span{flex:1;min-width:0}
  .file .fl{margin-top:14px}
  .note{margin:6px 2px 0;font-size:13.5px;color:var(--mute)}
  .sendb{margin:0;max-width:640px}
  .sendb textarea{resize:vertical;font:500 15px/1.45 Geist,sans-serif}
  .ok{color:#7fe0a8 !important}
</style>

<script is:inline>
{ const q = new URLSearchParams(location.search), m = q.get('m') || '', $ = s => document.querySelector(s), st = $('[data-state]')
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]))
  const fl = f => `<a class="fl" href="${esc(f.href)}"${f.zip ? ' download' : ' target="_blank" rel="noopener"'}><b>${f.zip ? 'ZIP' : 'PDF'}</b><span>${esc(f.name)}</span></a>`
  const lost = (msg) => { st.textContent = msg || 'Your link to the club comes by email.'; $('[data-lost]').hidden = false }
  const post = (u, b) => fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b) }).then(r => r.json().catch(() => ({})).then(d => ({ ok: r.ok, d })))
  $('[data-lost]').addEventListener('submit', e => {
    e.preventDefault(); const f = e.currentTarget, msg = $('[data-lost-msg]'), btn = f.querySelector('button'), email = f.email.value.trim()
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { msg.textContent = 'That email does not look right'; return }
    btn.disabled = true; msg.textContent = ''
    post('/api/club/link', { email }).then(r => { msg.className = r.ok ? 'err ok' : 'err'; msg.textContent = r.ok ? 'If that email is a member, your link is on its way. Check your inbox (and the spam folder).' : (r.d.error || 'Something went wrong, try again') })
      .catch(() => { msg.textContent = 'Something went wrong, try again' }).then(() => { btn.disabled = false })
  })
  // 25/11 (Nico, L2): the course as eleven cards, locked until each video is online; live countdown to Saturday 9:00 Rome
  const OPENS = Date.parse('2026-11-28T08:00:00Z')
  const LOCK = '<svg viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="lkg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#eaf4ff"/><stop offset="1" stop-color="#7fb8ff"/></linearGradient></defs><path d="M7.5 10.5V8a4.5 4.5 0 0 1 9 0v2.5" fill="none" stroke="url(#lkg)" stroke-width="2.2" stroke-linecap="round"/><rect x="5" y="10.5" width="14" height="10" rx="3" fill="url(#lkg)"/><circle cx="12" cy="15.2" r="1.6" fill="#1b4fae"/><path d="M12 16.4v1.8" stroke="#1b4fae" stroke-width="1.6" stroke-linecap="round"/></svg>'
  function course(ls) {
    const before = Date.now() < OPENS, ol = $('[data-lessons]')
    const no = l => String(l.n).padStart(2, '0'), ttl = l => { const t = esc(l.t), k = esc(l.k || ''); return k && t.includes(k) ? t.replace(k, '<em>' + k + '</em>') : t }
    const bg = l => l.img ? `<span class="sbg" style="background-image:url(${esc(l.img)})"></span><span class="sveil"></span><span class="sgrain"></span>` : ''
    ol.innerHTML = ls.map((l, i) => l.src
      ? `<li>${bg(l)}<div class="stop"><span class="no">${no(l)}</span></div><h3>${ttl(l)}</h3><span class="sfl"></span><p>${esc(l.s || l.p)}</p><video controls playsinline preload="metadata"${l.poster ? ` poster="${esc(l.poster)}"` : ''} src="${esc(l.src)}"></video></li>`
      : `<li class="locked" style="--d:${(i * .35).toFixed(2)}s">${bg(l)}<div class="stop"><span class="no">${no(l)}</span><span class="lk" role="img" aria-label="Locked">${LOCK}</span></div><h3>${ttl(l)}</h3><span class="sfl"></span><p>${esc(l.s || l.p)}</p><span class="lk-pill"><i></i>${before ? 'Opens 28 November' : 'Coming soon'}</span></li>`).join('')
    $('[data-course]').hidden = false
    // the cards come in as they scroll into view (and are all there without the observer)
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      ol.classList.add('rv'); const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) } }), { rootMargin: '0px 0px -8% 0px' })
      ol.querySelectorAll('li').forEach((li, i) => { li.style.transitionDelay = (i % 3) * 90 + 'ms'; io.observe(li) })
    }
    const cd = $('[data-cd]'), tick = () => { const s = Math.max(0, Math.floor((OPENS - Date.now()) / 1000)); if (!s) { cd.hidden = true; return }
      const u = { d: Math.floor(s / 86400), h: Math.floor(s % 86400 / 3600), m: Math.floor(s % 3600 / 60), s: s % 60 }
      cd.querySelectorAll('[data-u]').forEach(b => { b.textContent = b.dataset.u === 'd' ? u.d : String(u[b.dataset.u]).padStart(2, '0') }) }
    tick(); if (before) setInterval(tick, 1000); else cd.hidden = true
  }
  if (!m) lost()
  else fetch('/api/club/inside?m=' + encodeURIComponent(m)).then(r => r.json().then(d => ({ ok: r.ok, d }))).then(({ ok, d }) => {
    if (!ok) return lost(d.error)
    if (d.name && d.name !== 'there') $('[data-hi]').textContent = 'Welcome inside, ' + d.name + '.'
    if (d.portal) { const c = $('[data-cancel]'), a = document.createElement('a'); a.href = d.portal; a.textContent = 'one tap here'; c.textContent = 'To cancel: '; c.append(a, '.'); $('[data-foot]').hidden = false }
    if (d.state === 'none') { st.textContent = 'We are getting your seat ready. Refresh this page in a minute.'; return }
    if (d.state === 'waiting' || d.state === 'open') { $('[data-hello]').hidden = false; if (d.lessons) course(d.lessons) }
    if (d.state === 'waiting') { st.textContent = ''; $('[data-waiting]').hidden = false; return }
    if (d.state === 'ended') { st.textContent = ''; $('[data-ended]').hidden = false; return }
    st.textContent = 'Everything of the club is here. Start with the first lesson.'
    $('[data-skill]').innerHTML = fl(d.skill) + `<p class="note">${esc(d.skill.name)} ${esc(d.skill.note)}</p>`
    $('[data-vault]').innerHTML = d.vault.map(b => `<article class="vb"><img src="/club/v-${esc(b.img)}-760.webp" alt="" loading="lazy" decoding="async"><div class="vbb"><h3>${esc(b.t)}</h3><p class="ty">${esc(b.type)}</p><div class="files">${b.files.map(fl).join('')}</div></div></article>`).join('')
    $('[data-guides]').innerHTML = d.guides.map(fl).join('')
    $('[data-house]').innerHTML = fl(d.house)
    if (d.gifts && d.gifts.length) { $('[data-gifts]').innerHTML = d.gifts.map(fl).join(''); $('[data-gifts-sec]').hidden = false }
    $('[data-open]').hidden = false
  }).catch(() => { st.textContent = 'Could not open the club right now, try again in a minute.' })
  $('[data-build]').addEventListener('submit', e => {
    e.preventDefault(); const f = e.currentTarget, msg = $('[data-build-msg]'), btn = f.querySelector('button'), link = f.link.value.trim()
    if (!/^https?:\/\/[^\s]+\.[^\s]+$/i.test(link)) { msg.className = 'err'; msg.textContent = 'Paste the link of your build, like https://your-tower.netlify.app'; return }
    btn.disabled = true; msg.textContent = ''
    post('/api/club/build', { m, link, note: f.note.value.trim() }).then(r => { msg.className = r.ok ? 'err ok' : 'err'; msg.textContent = r.ok ? 'Sent. I answer you by email on Monday.' : (r.d.error || 'Something went wrong, try again'); if (r.ok) f.reset() })
      .catch(() => { msg.className = 'err'; msg.textContent = 'Something went wrong, try again' }).then(() => { btn.disabled = false })
  })
}

// 25/11 (Nico): his welcome video shows the cover first (A welcome from Nico · Play); the player bar appears on the first tap
document.querySelectorAll('[data-hello] video').forEach(v => { const go = () => { if (!v.controls) { v.controls = true; v.play().catch(() => {}) } }
  v.addEventListener('click', go); v.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go() } }) })
</script>
