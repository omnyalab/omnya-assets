---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { contact, sampleLinks } from '../lib/contact';
import { t, langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const C = T.contact;
const links = sampleLinks(lang);
---

<Base page="contact" title={C.title} description={C.description}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://assets.calendly.com" />
  </Fragment>

  <!-- F1: one of our photos edge to edge, a sheet of glass with the ways to reach us -->
  <section class="ctg" data-header="light" data-header-media>
    <div class="ctg__bg" aria-hidden="true">
      <img src="/learn/dev_sunset_mobile.webp" srcset="/learn/dev_sunset_mobile.webp 960w, /learn/dev_sunset.webp 1920w" sizes="100vw" alt="" fetchpriority="high" decoding="async" />
    </div>
    <div class="ctg__in wrap">
      <div class="ctg__card">
        <h1 class="t-h3 ctg__title" data-fade data-intro>{C.titleA} <span class="mute">{C.titleB}</span></h1>
        <a class="ctg__mail" href={`mailto:${contact.email}`} data-fade data-intro><span class="u">{contact.email}</span></a>
        <div class="ctg__pills" data-fade data-intro>
          <a class="btn btn--white" href={links.whatsapp} target="_blank" rel="noopener">WhatsApp <Arrow diag /></a>
          <a class="btn btn--glass" href={links.email}>Email <Arrow diag /></a>
          <a class="btn btn--glass" href={contact.phoneHref}>{C.call} <Arrow diag /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap ct__cal" id="book" data-calendly>
    <div class="label ct__calhead" data-fade>
      <h2 class="t-h3">{C.book}</h2>
      <a class="u" href={contact.calendly} target="_blank" rel="noopener">{C.bookNote}</a>
    </div>
    <div class="cal">
      <div class="cal__ph">{C.loading}</div>
      <div data-calendly-mount style="min-width: min(300px, 100%); height: 700px"></div>
    </div>
  </section>
</Base>
