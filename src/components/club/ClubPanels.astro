---
// A2 of board A (20/11): the pre-registration in three steps on the Burj at night (P1), blurred, with the blue glass
// panel; step 3 is the Apple Invites card. The same panel holds the checkout from Saturday 28/11 (name and email, then
// the Stripe fields of api/club.js inside our page). Driven by club-client.js; both open as full-screen dialogs.
import Icon from './Icon.astro';
import { WANTS } from './data';
---
{/* ---------- pre-registration ---------- */}
<div class="ov" data-ov="list" data-step="1" role="dialog" aria-modal="true" aria-labelledby="t3f-l1" hidden>
  <div class="joinbg" aria-hidden="true"><img src="/learn/3df_bg_burj.webp" alt="" decoding="async"></div>
  <div class="joinwrap">
    <div class="panel" data-steppanel>
      <div class="pbar">
        <button type="button" class="rb ctr" data-back aria-label="Back"><Icon name="back" /></button>
        <div class="track" role="progressbar" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1" aria-label="Step 1 of 3" data-track><i style="width:33.3%"></i><b style="left:33.3%">1/3</b></div>
        <button type="button" class="rb ctr" data-close aria-label="Close"><Icon name="x" /></button>
      </div>
      <div class="stp" data-s="1">
        <h2 id="t3f-l1" tabindex="-1">What do you want to build first?</h2>
        <div class="opts" role="radiogroup" aria-labelledby="t3f-l1" data-wants>
          {WANTS.map((w, i) => (
            <button type="button" class="opt" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-want={w.k}>
              <Icon name={w.i} /><span>{w.t}</span><Icon name="check" class="ok2" />
            </button>
          ))}
        </div>
        <button type="button" class="btn cta wide" data-next>Continue</button>
      </div>
      <div class="stp" data-s="2" hidden>
        <h2 id="t3f-l2" tabindex="-1">Where should your early key go?</h2>
        <form class="opts" data-listform novalidate>
          <div class="field"><label for="t3f-n">Name</label><input id="t3f-n" name="name" required autocomplete="name" maxlength="60" placeholder="Your name"></div>
          <div class="field"><label for="t3f-e">Email</label><input id="t3f-e" name="email" type="email" required autocomplete="email" inputmode="email" maxlength="120" placeholder="you@studio.com"></div>
          <label class="hp" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off"></label>
          <button class="btn cta wide save" type="submit" data-save>Save my seat</button>
        </form>
        <p class="small"><Icon name="lock" /><span>You go on the list for <span data-vv="a">THE 3D FUTURE</span><span data-vv="b">3D THAT SELLS</span>, we never share your email · <a href="/privacy-policy" target="_blank" rel="noopener">Privacy</a></span></p>
      </div>
    </div>
    <div class="invite stp" data-s="3" hidden>
      <img src="/club/v-towers-760.webp" alt="The Towers, our build by the sea" decoding="async" loading="lazy">
      <div class="ib">
        <span class="going"><Icon name="check" />You're on the list</span>
        <h2 id="t3f-l3" tabindex="-1">You get in first</h2>
        <p class="when">Sat 28 Nov · 09:00 CET</p>
        <div class="cdn" role="timer" aria-label="Time until your early door" data-cd="early">
          <span><b data-part="d">0</b><small>days</small></span><i aria-hidden="true">:</i><span><b data-part="h">00</b><small>hours</small></span><i aria-hidden="true">:</i><span><b data-part="m">00</b><small>min</small></span><i aria-hidden="true">:</i><span><b data-part="s">00</b><small>sec</small></span>
        </div>
        <div class="two">
          <button type="button" class="btn" data-sched><Icon name="cal" /><span>Schedule it</span></button>
          <button type="button" class="btn" data-share><Icon name="share" /><span>Share it</span></button>
        </div>
      </div>
    </div>
    <div class="stepdots" aria-hidden="true" data-dots><span aria-current="step"><i></i></span><span><i></i></span><span><i></i></span></div>
  </div>
  <button type="button" class="rb ctr x" data-close aria-label="Close" data-x3 hidden><Icon name="x" /></button>
</div>

{/* ---------- checkout (early, open and after: the doors never close) ---------- */}
<div class="ov" data-ov="pay" role="dialog" aria-modal="true" aria-labelledby="t3f-p" hidden>
  <div class="joinbg" aria-hidden="true"><img src="/learn/3df_bg_burj.webp" alt="" decoding="async"></div>
  <div class="joinwrap">
    <div class="panel">
      <div class="pbar solo">
        <h2 id="t3f-p" tabindex="-1"><span data-when="before">Reserve your seat</span><span data-when="early open after">Join <span data-vv="a">THE 3D FUTURE</span><span data-vv="b">3D THAT SELLS</span></span></h2>
        <button type="button" class="rb ctr" data-close aria-label="Close"><Icon name="x" /></button>
      </div>
      <p class="paid" data-paid hidden><Icon name="check" /><span>Guide found · €9 a month for you, after Friday 4 December too</span></p>
      <form class="opts" data-payform novalidate>
        <div class="field"><label for="t3f-pn">Name</label><input id="t3f-pn" name="name" required autocomplete="name" maxlength="60" placeholder="Your name"></div>
        <div class="field"><label for="t3f-pe">Email</label><input id="t3f-pe" name="email" type="email" required autocomplete="email" inputmode="email" maxlength="120" placeholder="you@studio.com"></div>
        <label class="hp" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off"></label>
        <button class="btn cta wide save" type="submit" data-go>Continue to payment</button>
      </form>
      <div class="opts" data-paystage hidden>
        <div class="paybox" data-paybox></div>
        <button type="button" class="btn cta wide save" data-pay><span data-when="before">Reserve my seat · €0 today</span><span data-when="early open after">Pay <span data-payeur>€9</span> a month</span></button>
      </div>
      <p class="pnote" data-early hidden>Doors open for everyone at 18:00</p>
      <p class="pnote" data-when="before">Nothing is charged today. On Saturday 28 November at 9:00 (Rome) the doors open and your card is charged €9 a month, the founders' price locked for as long as you stay. The first 100 who reserve get the founders' gift.</p>
      <p class="perr" data-perr role="alert"></p>
      <p class="small"><Icon name="lock" /><span>Cancel in one tap, whenever you want · <a href="/the-3d-future/terms" target="_blank" rel="noopener">Terms</a></span></p>
    </div>
  </div>
</div>

<div class="sheetwrap" data-sheet hidden>
  <div class="scrim" data-sheetx></div>
  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="t3f-sh">
    <div class="grab" aria-hidden="true"></div>
    <button type="button" class="rb ctr x" data-sheetx aria-label="Close"><Icon name="x" /></button>
    <p class="s-eyebrow">Sat 28 Nov · 09:00 CET</p>
    <h3 class="s-title" id="t3f-sh">Put it in your calendar</h3>
    <p class="s-text">One hour, the time your door opens, with the link to get in.</p>
    <div class="cal">
      <a data-ics href="#" download="the-3d-future.ics"><span class="ci" style="background:#ff3b30">28</span><span>Apple Calendar</span><Icon name="chev" /></a>
      <a data-gcal href="#" target="_blank" rel="noopener"><span class="ci" style="background:#1a73e8">G</span><span>Google Calendar</span><Icon name="chev" /></a>
      <a data-ocal href="#" target="_blank" rel="noopener"><span class="ci" style="background:#0f6cbd">O</span><span>Outlook</span><Icon name="chev" /></a>
    </div>
  </div>
</div>
<div class="toast" role="status" aria-live="polite" data-toast></div>
