    fetch('/api/club/feed?m=' + encodeURIComponent(m)).then(r => r.json().then(d => ({ ok: r.ok, d }))).then(({ ok, d }) => {
      if (!ok) return fail(d.error || 'Could not load the feed, try again in a minute.')
      FEED = d; paintFeed()
    }).catch(() => fail('Could not load the feed, try again in a minute.'))
