---
import Base from '../layouts/Base.astro';
import Duo from '../components/Duo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Arrow from '../components/Arrow.astro';
import EndCta from '../components/EndCta.astro';
import { projects, pad } from '../lib/data';
import { sizes as dims } from '../lib/media';
import { t, langFromPath, localize } from '../i18n';
import heroFrames from '../data/hero-frames.json';

// An empty 1x1 GIF: a <source> that resolves to nothing to download
const pixel = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';

const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const H = T.home;

// Sizes follow the asymmetric grid in global.css (.pcard[data-slot])
const sizes = [
  '(min-width: 900px) 34vw, 75vw',
  '(min-width: 900px) 50vw, 75vw',
  '(min-width: 900px) 66vw, 84vw',
  '(min-width: 900px) 34vw, 84vw',
  '(min-width: 900px) 66vw, 100vw',
  '(min-width: 900px) 42vw, 75vw',
  '(min-width: 900px) 50vw, 92vw',
];
const featured = projects.filter((p) => p.featured);
// Learn on the home page (A1): the three playbook covers as a fan, like the bundle on Learn
const books = ['white-to-real', 'reel', 'before-it-exists'].map((id) => `/studio/book_${id}_${lang}_mobile.webp`);
// "See all the work": gallery shots from every project. Each row has its own
// pictures (first and second shot of each project), never repeated across rows.
const rows = [
  projects.map((p) => p.gallery[0]).filter(Boolean),
  projects.map((p) => p.gallery[1]).filter(Boolean),
];
---

<Base page="home">
  <!-- Desktop: the hero stays on screen (sticky) while the scroll flies the
       drone up to the villa, then the page slides over it (frames in
       public/hero/desktop, made by scripts/hero-frames.mjs). Phones: the reel,
       muted and looping, starting as soon as the page loads; the page slides
       over it. Logic: src/scripts/hero.ts -->
  <div class="hero-pin" data-hero-pin>
    <section class="hero" data-hero data-header="light" data-header-media data-header-until=".after-hero" aria-label={H.reel} data-frames={JSON.stringify(heroFrames)}>
      <div class="hero__media">
        {/* Desktop first frame: what shows without JavaScript and under the preloader (which waits for its decode).
            Low priority on purpose: Chrome never counts a full-screen picture as LCP, the h1 is the LCP,
            and a high-priority picture would only steal bandwidth from the font the h1 needs.
            On phones it resolves to an empty inline pixel: nothing is downloaded there. */}
        <picture>
          <source media="(max-width: 767px)" srcset={pixel} />
          <source type="image/avif" srcset="/hero/desktop/0001.avif" />
          <img class="hero__poster" src="/hero/desktop/0001.webp" width={heroFrames.desktop.w} height={heroFrames.desktop.h} alt="" fetchpriority="low" data-hero-first data-pre-wait />
        </picture>
        {/* Phones: the reel's first frame, the first thing on screen (the preloader waits for it, never for
            the video). With reduced motion it is all there is. On desktop: the empty pixel.
            Default priority: Chrome raises it anyway for a picture in view (poster at ~1.2s on Fast 4G either
            way), while fetchpriority="high" cost the h1 0.4s of Lighthouse LCP (4.5s → 4.9s). */}
        <picture class="hero__reel-poster">
          <source media="(min-width: 768px)" srcset={pixel} />
          <img src="/reel/hero_mobile_poster.webp" width="828" height="1472" alt="" data-pre-wait />
        </picture>
        {/* Desktop only (hidden on phones, never drawn there) */}
        <canvas class="hero__frames" aria-hidden="true" data-hero-frames></canvas>
        {/* Phones only: the reel loads with the page (the source only matches a phone without reduced motion,
            so desktop never downloads it) and plays by itself, in a loop */}
        <video class="hero__video" muted playsinline autoplay loop preload="auto" disablepictureinpicture aria-hidden="true" data-hero-video>
          <source src="/reel/hero_mobile.mp4" type="video/mp4" media="(max-width: 767px) and (prefers-reduced-motion: no-preference)" />
        </video>
      </div>
      <div class="hero__shade"></div>
      <div class="hero__title wrap">
        <h1 class="t-h1" data-hero-title>{H.heroA}{' '}<span class="mute">{H.heroB}</span></h1>
      </div>
      <a class="hero__cue" href="#statement" aria-label={H.scrollLabel} data-scroll-to>
        <span class="hero__cue-in" data-fade="0.3" data-intro><span>{H.scroll}</span><i></i></span>
      </a>
    </section>
  </div>

  <div class="after-hero">
    <section class="statement wrap" id="statement">
      <Duo as="h2" size="h1" class="statement__title" a={H.titleA} b={H.titleB} />
      <div class="statement__row">
        <div class="statement__txt">
          <p class="statement__line" data-fade>{H.line}</p>
          <div class="statement__btns" data-fade>
            <button type="button" class="btn btn--fill" data-sample>{T.cta} <Arrow /></button>
            <a class="btn" href={localize('/work', lang)}>{T.work.seeWork} <Arrow /></a>
          </div>
        </div>
      </div>
    </section>

    <section class="plist wrap" aria-labelledby="work-title">
      <div class="label plist__head" data-fade>
        <h2 id="work-title">{H.selected}</h2>
      </div>
      <div class="plist__grid">
        {featured.map((p, i) => <ProjectCard project={p} slot={i % 7} sizes={sizes[i % 7]} />)}
      </div>
    </section>

    <!-- Edge to edge, as big as a project: the rest of the work slides behind -->
    <a href={localize('/work', lang)} class="seeall" data-cursor={T.cursor.view} data-seeall data-header="light">
      <div class="seeall__bg" aria-hidden="true">
        {
          rows.map((row, r) => (
            <div class="seeall__row" data-dir={r % 2 ? 'right' : 'left'}>
              {/* one set; the script repeats it as many times as the screen needs */}
              <div class="seeall__track" data-track>
                {row.map((g) => {
                  const d = dims(g);
                  return (
                    <span class="seeall__item" style={`--ar: ${g.w} / ${g.h}`}>
                      <img data-seeall-src={g.mobile} width={d.mw} height={Math.round((d.mw * g.h) / g.w)} alt="" decoding="async" />
                    </span>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>
      <div class="seeall__shade"></div>
      <div class="seeall__txt">
        <span class="seeall__title" data-split>{H.seeAllA}<br /><span class="mute">{H.seeAllB}</span></span>
        <span class="seeall__arrow" aria-hidden="true"><Arrow class="seeall__arrow-svg" /></span>
      </div>
    </a>

    <!-- Everything here is made with AI: after the work, before the studio -->
    <section class="ai wrap" aria-label={`${H.aiA} ${H.aiB}`}>
      <Duo size="h2" class="ai__title" a={H.aiA} b={H.aiB} />
      <div class="ai__row">
        <p class="ai__text" data-fade>{H.aiText}</p>
      </div>
    </section>

    <!-- Learn (A1): the three playbooks as a fan, on the warm card of the bundle -->
    <section class="hlearn wrap" aria-label={`${H.learnA} ${H.learnB}`}>
      <a class="hlearn__card" href={localize('/learn', lang)}>
        <span class="hlearn__fan" aria-hidden="true">
          {books.map((src, i) => <img class={`hlearn__book hlearn__book--${i + 1}`} data-src={src} width="540" height="720" alt="" decoding="async" />)}
        </span>
        <span class="hlearn__copy">
          <span class="t-h1 hlearn__title">{H.learnA} <span class="mute">{H.learnB}</span></span>
          <span class="t-sub hlearn__text">{H.learnText}</span>
          <span class="hlearn__chips"><span>{H.learnBooks}</span><span>{H.learnLessons}</span></span>
          <span class="btn btn--fill hlearn__btn">{H.learnCta} <Arrow /></span>
        </span>
      </a>
    </section>

    <EndCta />
  </div>
</Base>
