---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { contact, sampleLinks } from '../lib/contact';
import Booker from '../components/Booker.astro';
import { t, langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const C = T.contact;
const links = sampleLinks(lang);
---

<Base page="contact" title={C.title} description={C.description}>
  <!-- C3: one of our photos edge to edge, the ways to reach us written straight on it -->
  <section class="ctg" data-header="light" data-header-media>
    <div class="ctg__bg" aria-hidden="true">
      <img src="/learn/dev_sunset_mobile.webp" srcset="/learn/dev_sunset_mobile.webp 960w, /learn/dev_sunset.webp 1920w" sizes="100vw" alt="" fetchpriority="high" decoding="async" />
    </div>
    <div class="ctg__in wrap">
      <div class="ctg__card">
        <h1 class="t-h2 ctg__title" data-fade data-intro>{C.titleA} <span class="mute">{C.titleB}</span></h1>
        <a class="ctg__mail" href={`mailto:${contact.email}`} data-fade data-intro><span class="u">{contact.email}</span></a>
        <div class="ctg__pills d-only" data-fade data-intro>
          <a class="btn btn--white" href={links.whatsapp} target="_blank" rel="noopener">WhatsApp <Arrow diag /></a>
          <a class="btn btn--glass" href={links.email}>Email <Arrow diag /></a>
          <a class="btn btn--glass" href="#book" data-book-open>{C.book} <Arrow /></a>
        </div>
        <details class="ctg__more m-only" data-fade data-intro>
          <summary class="btn btn--white">{C.message} <span class="ctg__plus" aria-hidden="true">+</span></summary>
          <div class="ctg__pills">
            <a class="btn btn--glass" href={links.whatsapp} target="_blank" rel="noopener">WhatsApp <Arrow diag /></a>
            <a class="btn btn--glass" href={links.email}>Email <Arrow diag /></a>
            <a class="btn btn--glass" href="#book" data-book-open>{C.book} <Arrow /></a>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="wrap ct__cal is-closed" id="book" data-book-box>
    <div class="label ct__calhead">
      <h2 class="t-h3">{C.book}</h2>
      <span class="mute">{C.bookNote}</span>
    </div>
    <Booker type="call" />
  </section>
</Base>
