---
// 22/11 (Nico): the 3D AI Mastery thanks page (/learn/thanks/full-mastery) in the colours of its funnel.
// Made by scripts/new-funnel from the Riyadh violet block of views/Thanks.astro. is:inline: only on that page.
---
<style is:inline>
  /* 17/11 (Nico): after paying for the 3D AI Mastery guide the page is in the colours of that funnel (Æther blue, white text) */
  :root{--bg:#060b13;--ink:#ffffff;--mute:#9caecd;--mute-lg:#8495b1;--line:#202a3c}
  html,body{background:radial-gradient(900px 600px at 50% -8%,#2f7bff33,#0000 70%),#060b13!important;color:#fff}
  .oto .btn--fill,.oto-dl .btn--fill{background:#2f7bff!important;border-color:#2f7bff!important;color:#fff!important}
  .oto__steps .is-done span,.oto__steps .is-now span{background:#2f7bff!important;color:#fff!important;border-color:#2f7bff!important}
  .hdr .logo__img--dark{filter:invert(1)}
  .hdr::before{background:#060b13e6!important;border-bottom-color:#202a3c!important}
  .hdr{color:#fff!important}
  .wa-fab{background:#2f7bff!important;color:#fff!important}
  html[data-page='thanks'] .oto-dl{background:linear-gradient(160deg,#ffffff1a,#ffffff08)!important;border:1px solid #ffffff26!important;-webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px);color:#fff!important;box-shadow:0 40px 80px -40px #2f7bffaa,inset 0 1px #ffffff33!important}
  html[data-page='thanks'] .oto-dl *{color:#fff}
  html[data-page='thanks'] .oto-dl .t-sub{color:#fff!important;-webkit-text-fill-color:#fff!important}
  html[data-page='thanks'] .oto-dl .oto-dl__note,html[data-page='thanks'] .oto-dl .oto-dl__note *{color:#9caecd!important}
  html[data-page='thanks'] .oto-dl .btn:not(.btn--fill){background:#ffffff14!important;border-color:#ffffff33!important;color:#fff!important}
  html[data-page='thanks'] .oto__down{background:#2f7bff!important}
  html[data-page='thanks'] .oto__head{display:none}
  html[data-page='thanks'] .oto__card{background:#0a1324!important;border:1px solid #202a3c;box-shadow:0 40px 70px -40px #2f7bff88!important;color:#fff}
  html[data-page='thanks'] .oto__card *{color:#fff}
  html[data-page='thanks'] .oto__card .t-sub,html[data-page='thanks'] .oto__card p{color:#b5c4df}

</style>
