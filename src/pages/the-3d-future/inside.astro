    const st = { link: '', img: '', w: 0, h: 0, cap: '' }
    const one = () => { openSheet(`<p class="s-eyebrow">Post your build</p><div class="fsteps" aria-hidden="true"><i class="on"></i><i></i></div><h3 class="s-title" id="t3m-sh">The link of your build</h3>
        <label class="lbl" for="t3m-fl">Where it's online</label><input id="t3m-fl" class="finp" data-flink type="url" inputmode="url" maxlength="300" placeholder="https://your-tower.netlify.app" value="${esc(st.link)}">
        <p class="ferr" role="status" data-ferr></p><button class="bigb blue" type="button" data-fnext>Next${ic('arrow')}</button>`)
      const i = $('[data-flink]'); setTimeout(() => i && i.focus(), 300)
      i.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); $('[data-fnext]').click() } })
      $('[data-fnext]').addEventListener('click', () => { const v = i.value.trim(); if (!/^https?:\/\/[^\s]+\.[^\s]+$/i.test(v)) { $('[data-ferr]').textContent = 'Paste the link of your build, like https://your-tower.netlify.app'; return } st.link = v; two() }) }
    const two = () => { openSheet(`<p class="s-eyebrow">Post your build</p><div class="fsteps" aria-hidden="true"><i class="on"></i><i class="on"></i></div><h3 class="s-title" id="t3m-sh">Add a photo of it</h3>
        <label class="drop2">${st.img ? `<img src="${st.img}" alt="">` : `${ic('cam')}<span>Choose a photo</span><small>A screenshot of your build is perfect</small>`}<input type="file" accept="image/*" data-fimg aria-label="Choose a photo of your build"></label>
        <label class="lbl" for="t3m-cap">Say something about it (optional)</label><textarea id="t3m-cap" rows="3" maxlength="600" data-fcap placeholder="What you built, what you'd like people to look at">${esc(st.cap)}</textarea>
        <p class="ferr" role="status" data-ferr></p><div class="sbtns"><button class="bigb ghost" type="button" data-fback>Back</button><button class="bigb blue" type="button" data-fpost>${ic('send')}Post it</button></div>
        <p class="snote">Everyone in the club sees it. I look at every post and write to you privately with what works and what I'd change.</p>`)
      const f = $('[data-fimg]'), err = $('[data-ferr]'), cap = $('[data-fcap]')
      f.addEventListener('change', () => { const x = f.files && f.files[0]; if (!x) return; err.textContent = 'Getting your photo ready…'; err.className = 'ferr ok'
        shrink(x).then(r => { st.img = r.data; st.w = r.w; st.h = r.h; st.cap = cap.value; two() }).catch(() => { err.className = 'ferr'; err.textContent = 'That photo did not open, try a JPG or PNG' }) })
      $('[data-fback]').addEventListener('click', () => { st.cap = cap.value; one() })
      $('[data-fpost]').addEventListener('click', e => { const b = e.currentTarget; st.cap = cap.value.trim()
        if (!st.img) { err.className = 'ferr'; err.textContent = 'Add a photo of your build'; return }
        b.disabled = true; err.className = 'ferr ok'; err.textContent = 'Posting…'
        post('/api/club/post', { m, link: st.link, caption: st.cap, img: st.img, w: st.w, h: st.h }).then(r => {
          if (!r.ok) { err.className = 'ferr'; err.textContent = r.d.error || 'Something went wrong, try again'; b.disabled = false; return }
          closeSheet(); FEED.posts.unshift(r.d.post); paintFeed(); show('feed'); toast('Posted. I write to you privately soon.')
        }).catch(() => { err.className = 'ferr'; err.textContent = 'Something went wrong, try again'; b.disabled = false }) }) }
    one()
  }

