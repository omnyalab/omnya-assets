  /* the photo is made small on the phone before it leaves (about 1600 px, JPEG) */
  function shrink(file) {
    return new Promise((res, rej) => { const u = URL.createObjectURL(file), im = new Image()
      im.onload = () => { const c = document.createElement('canvas'); let s = Math.min(1, 1600 / Math.max(im.naturalWidth, im.naturalHeight)), qy = .85, out = ''
        for (let i = 0; i < 6; i++) { c.width = Math.round(im.naturalWidth * s); c.height = Math.round(im.naturalHeight * s); c.getContext('2d').drawImage(im, 0, 0, c.width, c.height); out = c.toDataURL('image/jpeg', qy); if (out.length < 650000) break; qy -= .1; s *= .85 }
        URL.revokeObjectURL(u); res({ data: out, w: c.width, h: c.height }) }
      im.onerror = () => { URL.revokeObjectURL(u); rej(new Error('img')) }; im.src = u })
  }
