---
// THE 3D FUTURE (20/11, Nico): the plain frame of the club pages (welcome, terms, withdraw): dark, the club's blue of
// components/RiyadhFuture.astro, Geist, no site header. The visual designer restyles them later; the footer links
// (terms, the withdrawal function, privacy, contact) stay on every club page.
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = 'THE 3D FUTURE, the club of Omnya Lab', noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title} · Omnya Lab</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<link rel="icon" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  :root{--bg:#060c1a;--bg2:#0c1830;--ink:#fff;--mute:#a9b8d0;--line:#ffffff1f;--blue:#0071e3;--blue2:#5ab8ff;--glow:#2f8bff}
  *{box-sizing:border-box}
  html{background:var(--bg);color:var(--ink);-webkit-text-size-adjust:100%}
  body{margin:0;min-height:100svh;display:flex;flex-direction:column;background:radial-gradient(120% 60% at 50% 0%,#10254a,var(--bg) 70%) no-repeat,var(--bg);font:400 16px/1.55 Geist,Inter,-apple-system,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:var(--blue2)}
  .cl{width:min(640px,100%);margin:0 auto;padding:56px 16px 40px;flex:1}
  .cl__brand{display:flex;align-items:center;gap:10px;margin:0 0 34px;font:600 13px Geist,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);text-decoration:none}
  .cl__brand img{width:34px;height:34px}
  .cl h1{margin:0 0 14px;font:700 clamp(34px,8vw,48px)/1.05 Geist,sans-serif;letter-spacing:-.03em}
  .cl h1 span{color:var(--blue2)}
  .cl h2{margin:34px 0 10px;font:600 20px/1.25 Geist,sans-serif;letter-spacing:-.01em}
  .cl p,.cl li{color:#dbe5f5}
  .cl .lead{font-size:18px;color:#e9f1ff}
  .cl .mute{color:var(--mute)}
  .box{margin:22px 0;padding:22px 18px;border-radius:22px;background:linear-gradient(160deg,#ffffff14,#ffffff06);border:1px solid var(--line);box-shadow:0 40px 80px -50px #2f8bffaa}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;padding:14px 22px;border:0;border-radius:999px;background:var(--blue);color:#fff;font:600 16px Geist,sans-serif;text-decoration:none;cursor:pointer}
  .btn:hover{background:#0a7cf0}
  .btn[disabled]{opacity:.55;cursor:default}
  .btn--line{background:transparent;border:1px solid #ffffff40}
  .in{display:block;width:100%;margin:6px 0 14px;padding:14px 14px;border-radius:12px;border:1px solid #ffffff2e;background:#0b1428;color:#fff;font:500 16px Geist,sans-serif}
  .in:focus{outline:2px solid var(--blue2);outline-offset:1px}
  label{font:500 14px Geist,sans-serif;color:#e4ecfa}
  .err{min-height:20px;margin:8px 0 0;color:#ff9b9b;font-size:14px}
  .cl__foot{width:min(640px,100%);margin:0 auto;padding:22px 16px 34px;border-top:1px solid var(--line);font-size:13.5px;color:var(--mute)}
  .cl__foot nav{display:flex;flex-wrap:wrap;gap:8px 18px;margin-bottom:10px}
  .cl__foot a{color:#d9e6fb;text-decoration:none}
  .cl__foot a:hover{text-decoration:underline}
  .cl__foot .w{font-weight:600;color:#fff}
  [hidden]{display:none!important}
</style>
</head>
<body>
<main class="cl">
  <a class="cl__brand" href="/"><img src="/learn/3df_knot.webp" alt="" width="34" height="34">The 3D Future · Omnya Lab</a>
  <slot />
</main>
<footer class="cl__foot">
  <nav aria-label="Club links">
    <a href="/the-3d-future/terms">Club terms</a>
    <a class="w" href="/withdraw">Withdraw from contract here</a>
    <a href="/privacy-policy">Privacy</a>
    <a href="mailto:info@omnyalab.com">info@omnyalab.com</a>
  </nav>
  <span>Omnya Lab · Venice, Italy · VAT IT05578770264</span>
</footer>
<script is:inline defer src="/club/back.js"></script>
</body>
</html>
