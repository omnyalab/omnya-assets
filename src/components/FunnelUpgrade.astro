---
// Step 2 on /learn/thanks/full-* (10/11, Nico after the board: "I'd go on with the funnel, it makes no sense to give it
// to them in those colours"): "Everything we teach" for the difference, €53, drawn as the next step of the funnel the
// buyer just came from and not as a card of the site. It is the card of /the-*-blueprint/sent in its "Everything we
// teach" state (views/sent/*.html: .uc, .arc, .x3-kick, .up2, .x3-btn, .ul), same dark ground, same glow, same button,
// Montserrat, in the colour of that funnel: green after the Build guide, the site blue after Tower, 3D, City and Towers.
// When it shows is decided outside: views/Thanks.astro puts it in the page only when lib/learn.ts has the Stripe link
// (everythingUpgrade), it starts hidden, and scripts/learn.ts shows it only after api/files.js has confirmed the payment.
import { goHref, type ProductId } from '../lib/learn';
import { t, type Lang } from '../i18n';

interface Props {
  /** the Full guide just bought: full-tower, full-3d, full-city, full-build, full-towers */
  id: string;
  lang: Lang;
}
const { id, lang } = Astro.props;
const X = t(lang).learn.thanks;
const upId: ProductId = 'everything-upgrade';
const o = (X.offers as Record<string, { a: string; b: string; price: string; cta: string }>)[upId];
const x = (X.extra as Record<string, { strike: string; items: string[] }>)[upId];
// the colours of the funnels, as written in views/sent/build.html (green) and views/sent/towers.html (blue)
const themes = {
  blue: '--fc:41 151 255;--g1:#163266;--g2:#0b1630;--g3:#070b14',
  green: '--fc:34 211 94;--g1:#1d6636;--g2:#0e3019;--g3:#06140b',
};
const theme = id === 'full-build' ? themes.green : themes.blue;
// the three playbooks fanned out on top, the same covers as the funnel (the Italian ones on /it/)
const covers = lang === 'it'
  ? ['white-to-real', 'reel', 'before-it-exists'].map((b) => `/studio/book_${b}_it_mobile.webp`)
  : ['/learn/pk_pb01.webp', '/learn/pk_pb02.webp', '/learn/pk_pb03.webp'];
---

<article class="fup" style={theme} data-upgrade data-funnel={id} hidden>
  <div class="fup__arc" aria-hidden="true">{covers.map((src) => <img src={src} alt="" loading="lazy" />)}</div>
  <p class="fup__kick">{X.only}</p>
  <h2 class="fup__title">Everything<br /><span>we teach</span></h2>
  <p class="fup__price"><b>{o.price}</b><s>{x.strike}</s></p>
  <p class="fup__sub">{X.upgradeSub}</p>
  <a class="fup__btn" href={goHref(upId, lang)}>{o.cta} →</a>
  <ul class="fup__list">{x.items.map((it) => <li><span>{it}</span></li>)}</ul>
  <a class="fup__no" href="#download">{X.upgradeNo}</a>
</article>

<style is:global>
  @font-face { font-family: Montserrat; src: url(/fonts/montserrat-latin.woff2) format('woff2'); font-weight: 500 900; font-display: swap; }
  .fup {
    position: relative; isolation: isolate; box-sizing: border-box; width: min(620px, 100%); margin: 110px auto 0; padding: 0 30px 26px;
    border-radius: 30px; text-align: center; color: #fff; font-family: Montserrat, -apple-system, sans-serif; -webkit-font-smoothing: antialiased;
    background: linear-gradient(170deg, var(--g1) 0%, var(--g2) 40%, var(--g3) 75%, #05070a 100%);
    box-shadow: 0 50px 110px -40px rgb(var(--fc) / 0.65), inset 0 1px rgb(255 255 255 / 0.18);
    scroll-margin-top: calc(var(--hdr, 0px) + 96px);
  }
  .fup[hidden] { display: none; }
  .fup::before { content: ''; position: absolute; left: 50%; top: -120px; width: 520px; max-width: 120%; height: 260px; transform: translateX(-50%); background: radial-gradient(closest-side, rgb(var(--fc) / 0.6), rgb(var(--fc) / 0.18) 60%, transparent); filter: blur(22px); z-index: -1; pointer-events: none; }
  .fup__arc { position: relative; height: 200px; width: 100%; margin: -42px auto 12px; animation: fupFloat 6s ease-in-out infinite; }
  .fup__arc img { position: absolute; top: 50%; left: 50%; width: 138px; height: auto; border-radius: 3px 8px 8px 3px; box-shadow: 0 10px 18px -8px rgb(0 0 0 / 0.55); filter: drop-shadow(0 12px 16px rgb(0 0 0 / 0.45)); }
  .fup__arc img:nth-child(1) { transform: translate(-50%, -50%) translateX(-56%) rotate(-7deg) scale(0.95); z-index: 1; }
  .fup__arc img:nth-child(2) { transform: translate(-50%, -53%) scale(1.04); z-index: 3; }
  .fup__arc img:nth-child(3) { transform: translate(-50%, -50%) translateX(56%) rotate(7deg) scale(0.95); z-index: 2; }
  @keyframes fupFloat { 50% { transform: translateY(-9px) rotate(-2deg); } }
  @media (prefers-reduced-motion: reduce) { .fup__arc { animation: none; } }
  .fup__kick { margin: 0 0 8px; font-size: 12px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: rgb(var(--fc)); }
  .fup__title { margin: 0; font: 900 40px/0.95 Montserrat, sans-serif; letter-spacing: 0; text-transform: uppercase; color: #fff; }
  .fup__title span { display: inline-block; margin-top: 8px; font-size: 0.62em; font-weight: 800; letter-spacing: 0.14em; text-indent: 0.14em; border: 0.075em solid #fff; padding: 0.12em 0.36em 0.06em; }
  .fup__price { margin: 20px 0 4px; display: flex; justify-content: center; align-items: baseline; gap: 12px; }
  .fup__price b { font: 900 62px/1 Montserrat, sans-serif; letter-spacing: -0.02em; }
  .fup__price s { color: rgb(255 255 255 / 0.45); font: 700 24px Montserrat, sans-serif; }
  .fup__sub { margin: 0 0 18px; color: rgb(255 255 255 / 0.7); font: 500 14px/1.45 -apple-system, sans-serif; }
  .fup__btn {
    display: flex; justify-content: center; align-items: center; gap: 10px; width: 100%; min-height: 58px; box-sizing: border-box; padding: 8px 28px; border-radius: 999px;
    background: rgb(var(--fc)); color: #fff; box-shadow: 0 18px 40px -18px rgb(var(--fc) / 0.9);
    font-size: 16px; font-weight: 800; line-height: 1.2; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; text-align: center;
  }
  .fup__list { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 11px; text-align: left; }
  .fup__list li { display: flex; gap: 12px; color: rgb(255 255 255 / 0.82); font: 400 14.5px/1.45 -apple-system, sans-serif; }
  .fup__list li::before { content: '✓'; flex: 0 0 20px; height: 20px; border-radius: 50%; background: rgb(var(--fc)); color: #fff; display: grid; place-items: center; font: 800 11px/1 -apple-system, sans-serif; margin-top: 1px; }
  .fup__no { display: block; width: max-content; max-width: 100%; margin: 22px auto 0; min-height: 30px; color: rgb(255 255 255 / 0.7); font: 600 14px -apple-system, sans-serif; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 899px) {
    .fup { margin-top: 84px; padding: 0 18px 22px; border-radius: 28px; }
    .fup__arc { height: 150px; margin: -34px auto 10px; }
    .fup__arc img { width: 100px; }
    .fup__title { font-size: 32px; }
    .fup__price b { font-size: 52px; }
    .fup__price s { font-size: 20px; }
    .fup__btn { min-height: 54px; padding: 8px 18px; font-size: 14px; letter-spacing: 0.04em; }
  }
</style>
