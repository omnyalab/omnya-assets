---
// 17/11 (Nico): on the Riyadh thanks page, after the download, the same yellow Black Friday card that was on the
// Riyadh watch page (copied as it was: pill, fanned covers, Get everything, €260 struck, €59, -77%, the real countdown
// to Friday 27 November 23:59 Rome, the yellow button). The button opens the "Everything we teach" Stripe link (€59).
// After the end the card hides itself, and the Everything upgrade card of the page (€53, components/FunnelUpgrade) comes
// back: while the card runs it is hidden (html.ry-bf), so the page never shows two prices for the same pack.
// 18/11: the Build thanks page uses it too (name="Build", the Build book in the fan).
// 19/11 (Nico): on the plane thanks page Playbook 02 "How to go viral" is the book in the middle; `side` is the last book of the fan
// 19/11 (Nico): the plane thanks page has its own bridge (h, p): don't miss it, and what they just paid comes off
const { name = 'Riyadh', book = '/learn/ry_book_tight.webp', side = '/learn/pk_pb02.webp', h = 'One more thing before you go', p = 'Right now there’s a Black Friday offer on everything we teach', offer } = Astro.props as { name?: string; book?: string; side?: string; h?: string; p?: string; offer?: { books: string[]; title: string; inc: string; was: number; link: string; label: string; credit: Record<string, [number, string, string]> } };
// 22/11 (Nico, 3D AI Mastery): `offer` turns the card into another Black Friday pack (its books, title, line, struck price, Stripe
// link, button and what each payment just made comes off, {cents: [price, link, line]}). Without it the card is Everything as before.
// 22/11 (Nico: «occhio che qua esce doppio»): the five books of the fan never repeat. `book` is always the one in the middle;
// the others are the 3D, Towers, Stadium books and `side`, and one that is already in the fan is replaced by another real book
// of the pack (Plane, Build, Tower, the playbooks), so the stadium thanks page (book = the stadium) no longer shows it twice.
const SPARE = ['/learn/pl_book_tight.webp', '/learn/bd_book_tight.webp', '/learn/tw_book.webp', '/learn/pk_pb01.webp', '/learn/pk_pb03.webp', '/learn/pk_pb02.webp'];
const want = ['/learn/3d_book.webp', '/learn/tt_book_tight.webp', book, '/learn/sd_book_tight.webp', side];
const fan: string[] = [];
const used = new Set([book]);
want.forEach((src, i) => {
  if (i === 2) { fan.push(book); return; }
  const pick = used.has(src) ? SPARE.find((x) => !used.has(x) && !want.includes(x)) || SPARE.find((x) => !used.has(x)) || src : src;
  used.add(pick); fan.push(pick);
});
const books = offer ? offer.books : fan;
const was = offer ? offer.was : 260;
---
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800;900&family=Inter:wght@500;600;700;800&display=swap" rel="stylesheet">
<section class="rybf" data-rybf data-was={was} data-label={offer ? offer.label : undefined} data-credit={offer ? JSON.stringify(offer.credit) : undefined} hidden>
<div class="bfw"><div class="bridge"><h3>{h}</h3><p>{p}</p><span class="ar">↓</span></div>
      <div class="bfc bft" data-bft><span class="rib"><i></i>BLACK FRIDAY OFFER</span><span class={offer ? 'fan fan--front' : 'fan'}>{books.map((src) => <img src={src} alt="" />)}</span><span class="bh">{offer ? offer.title : 'Get everything'}</span><span class="inc">{offer ? offer.inc : `Every Full guide, ${name} too, the 3 playbooks, the skills and every new guide`}</span><span class="pz"><s>€{was}</s><b data-bfp>€59</b><span data-bfo>{offer ? '-' + Math.round((1 - 59 / was) * 100) + '%' : '-77%'}</span></span><span class="pd" data-bfpaid hidden></span><div class="bcd"><small>Black Friday ends in</small><div class="bx"><span><b data-bd>11</b><i>DAYS</i></span><span><b data-bh>00</b><i>HRS</i></span><span><b data-bm>00</b><i>MIN</i></span><span class="sc"><b data-bs>00</b><i>SEC</i></span></div></div><a class="go" href={offer ? offer.link : 'https://buy.stripe.com/5kQcN4bgVbIs6tMeyN8so0C'} data-bfgo>{offer ? offer.label : 'Get everything'} · €59 →</a></div></div>
</section>
<style is:global>
.rybf{padding:8px 16px 40px;text-align:center;color:#fff;font-family:Inter,-apple-system,sans-serif}
.rybf[hidden]{display:none}

.bfc .rib{display:inline-flex;align-items:center;gap:8px;padding:5px 12px;border-radius:999px;background:#ffd60a;color:#111;font:900 11px Poppins;letter-spacing:.16em}
.bfc .rib i{width:7px;height:7px;border-radius:50%;background:#ff3b30;box-shadow:0 0 0 3px #ff3b3044}
.bfc .fan{display:block;position:relative;height:96px;margin:12px auto 4px;width:250px}
.bfc .fan img{position:absolute;bottom:0;width:58px;height:auto;border-radius:4px;box-shadow:0 10px 20px #000c,0 0 0 1px #ffffff14}
.bfc .fan img:nth-child(1){left:6px;transform:rotate(-16deg) translateY(8px);filter:brightness(.75)}
.bfc .fan img:nth-child(2){left:52px;transform:rotate(-8deg) translateY(2px);filter:brightness(.9)}
.bfc .fan img:nth-child(3){left:96px;width:62px;z-index:3;transform:translateY(-6px);box-shadow:0 0 0 1.5px #ffd60a,0 0 26px #ffd60a88}
.bfc .fan img:nth-child(4){left:142px;transform:rotate(8deg) translateY(2px);filter:brightness(.9);z-index:2}
.bfc .fan img:nth-child(5){left:186px;transform:rotate(16deg) translateY(8px);filter:brightness(.75)}
.bfc .bh{display:block;margin:6px 0 0;font:900 26px/1 Poppins;letter-spacing:-.01em;text-transform:uppercase;color:#fff}
.bfc .inc{display:block;margin:6px 0 0;font:600 12.5px/1.45 Inter;color:#e5d9a6}
.bfc .pz{display:flex;align-items:center;justify-content:center;gap:10px;margin:8px 0 0}
.bfc .pz s{font:700 18px Poppins;color:#8a8270;text-decoration-color:#ff3b30;text-decoration-thickness:2.5px}
.bfc .pz b{font:900 46px/1 Poppins;color:#ffd60a;text-shadow:0 0 26px #ffd60a66}
.bfc .pz span{padding:3px 8px;border-radius:999px;background:#ff3b30;color:#fff;font:900 12px Poppins;transform:rotate(-8deg)}
.bfc .go{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;height:54px;margin:12px 0 0;border-radius:14px;border:0;font:900 16px Poppins;letter-spacing:.03em;text-transform:uppercase;color:#111;background:linear-gradient(180deg,#ffe24a,#ffc400);box-shadow:0 14px 34px -12px #ffd60acc;cursor:pointer}
.bfc .end{display:block;margin:8px 0 0;font:700 11.5px Inter;color:#ffb3ad}
@media (min-width:821px){.bfc .fan{transform:scale(1.15);transform-origin:50% 100%}}
.bfw{display:block;width:min(420px,100%);margin:0 auto}
.bridge{margin:34px 0 0}
.bridge h3{margin:0;font:900 27px/1.1 Poppins;text-wrap:balance}
.bridge p{margin:10px auto 0;max-width:300px;font:800 15.5px/1.35 Poppins;color:#ffd60a}
.bridge .ar{display:block;margin:8px auto 0;font:900 22px/1 Poppins;color:#ffd60a;animation:bdn 1.4s ease-in-out infinite}
@keyframes bdn{50%{transform:translateY(5px)}}
.bfc.bft{position:relative;margin:14px 0 0;padding:16px 14px 14px;border-radius:18px;background:radial-gradient(120% 90% at 50% 0%,#3a2c00 0%,#0b0a06 62%);border:1.5px solid #ffd60a;box-shadow:0 0 0 5px #ffd60a1a,0 24px 60px -24px #ffd60a99;text-align:center;overflow:hidden}
.bft .go{text-decoration:none;margin-top:14px}
.bcd{margin:12px 0 0}
.bcd small{display:block;font:800 11px Inter;letter-spacing:.16em;text-transform:uppercase;color:#ffb3ad}
.bcd .bx{display:flex;justify-content:center;gap:6px;margin-top:7px}
.bcd .bx span{display:grid;justify-items:center;min-width:56px;padding:7px 4px 6px;border-radius:10px;background:#000;border:1px solid #ffd60a44}
.bcd .bx b{font:900 22px/1 Poppins;color:#fff;font-variant-numeric:tabular-nums}
.bcd .bx i{margin-top:3px;font:700 9.5px Inter;font-style:normal;letter-spacing:.12em;color:#a99e78}
.bcd .bx .sc b{color:#ffd60a}
.rybf .bfc .pd{display:block;margin:2px auto 10px;max-width:300px;font:600 13.5px/1.4 Inter,sans-serif;color:#ffe27a}
.rybf .bfc .pz s+b{transition:transform .3s}
.rybf .bfc .go{background:linear-gradient(180deg,#ffe24a,#ffc400);color:#111;text-decoration:none}
html.ry-bf [data-upgrade]{display:none!important}
/* 22/11 (Nico, 3D AI Mastery): an offer's own book in front, bigger, with the light on its edge, the other three in a symmetric
   half circle behind it (left, middle higher, right): offer.books = [left, middle, right, the one in front] */
.bfc .fan.fan--front{height:146px;width:250px;margin:8px auto 6px}
.bfc .fan.fan--front img{bottom:6px;filter:brightness(.72)!important;box-shadow:0 10px 20px #000c,0 0 0 1px #ffffff14!important}
.bfc .fan.fan--front img:nth-child(1){left:30px;width:54px;transform:rotate(-18deg) translateY(2px);z-index:1}
.bfc .fan.fan--front img:nth-child(2){left:98px;width:54px;transform:translateY(-52px);z-index:0}
.bfc .fan.fan--front img:nth-child(3){left:166px;width:54px;transform:rotate(18deg) translateY(2px);z-index:1}
.bfc .fan.fan--front img:nth-child(4){left:89px;width:72px;bottom:0;z-index:3;filter:none!important;transform:none;box-shadow:0 0 0 1.5px #ffd60a,0 0 30px #ffd60a99,0 14px 26px #000c!important}
</style>
<script is:inline>
{ const end = Date.parse('2026-11-27T23:59:59+01:00'), box = document.querySelector('[data-rybf]')
  // 20/11: preview only. With ?at=<ISO date> in the URL (the previews of the thanks page, as in components/RiyadhFuture)
  // the card lives at that moment: after 27/11 23:59 Rome it is gone. Without ?at= now() is Date.now(), nothing changes.
  const pv = Date.parse((new URLSearchParams(location.search).get('at') || '').replace(' ', '+')), t0 = Date.now()
  const now = () => isNaN(pv) ? Date.now() : pv + (Date.now() - t0)
  if (box && now() < end) { box.hidden = false; document.documentElement.classList.add('ry-bf')
    const card = box.querySelector('[data-bft]'), p2 = n => String(n).padStart(2, '0'), q = a => card.querySelector('[data-' + a + ']')
    const bt = () => { const x = Math.max(0, Math.floor((end - now()) / 1000)); if (!x) { box.hidden = true; document.documentElement.classList.remove('ry-bf'); return } q('bd').textContent = Math.floor(x / 86400); q('bh').textContent = p2(Math.floor(x % 86400 / 3600)); q('bm').textContent = p2(Math.floor(x % 3600 / 60)); q('bs').textContent = p2(x % 60) }
    bt(); setInterval(bt, 1000)
    // 18/11 (Nico): the offer counts what the buyer has just paid. €59 minus the guide (or guide + kit) of this payment,
    // read from Stripe through api/files.js (paid = amount_total in cents), never for who already holds the pack.
    // Each price has its own Stripe link on the product "Everything we teach · upgrade" (it delivers the whole pack).
    // A price without its link keeps the card at €59, so the page never shows a price it cannot charge.
    // 20/11 (Nico): who bought the Plane Builder Skill at €1.99 gets a super discount, Everything at €44 (the €44 upgrade link
    // that already exists), with its own line: it is more than "what you paid comes off"
    const CREDIT0 = { 199: [44, 'https://buy.stripe.com/fZu6oGbgVfYIg4meyN8so0X', 'You just got the skill, so for you it’s €44 instead of €59'], 599: [53, 'https://buy.stripe.com/bJedR8acRbIs3hAbmB8so0F'], 999: [49, 'https://buy.stripe.com/8x2eVcckZ5k43hAbmB8so0W'], 1499: [44, 'https://buy.stripe.com/fZu6oGbgVfYIg4meyN8so0X'], 1999: [39, 'https://buy.stripe.com/bJeeVc84J7sccSafCR8so0Y'] }
    const CREDIT = box.dataset.credit ? JSON.parse(box.dataset.credit) : CREDIT0, LABEL = box.dataset.label || 'Get everything', WAS = +box.dataset.was || 260
    window.__bfCredit = cents => { const c = CREDIT[cents]; if (!c || !c[1]) return
      const paid = '€' + (cents / 100).toFixed(2)
      q('bfp').textContent = '€' + c[0]; q('bfo').textContent = '-' + Math.round((1 - c[0] / WAS) * 100) + '%'
      const pd = q('bfpaid'); pd.textContent = c[2] || 'You already paid ' + paid + ', so you only pay the rest'; pd.hidden = false
      const go = q('bfgo'); go.href = c[1]; go.textContent = LABEL + ' · €' + c[0] + ' →' }
    const sid = new URLSearchParams(location.search).get('session_id')
    // 22/11: who paid €59 or more on this payment (the 3D AI Mastery bundle, €59) is not offered Everything for €59 again
    if (sid) fetch('/api/files?session_id=' + encodeURIComponent(sid)).then(r => r.ok ? r.json() : null).then(d => { if (d && !d.pack && d.paid >= 5900) { box.hidden = true; return } if (d && !d.pack && d.paid) window.__bfCredit(d.paid) }).catch(() => {}) } }
</script>
