<style is:global>
  /* the course cards (B3) read these */
  :root{--line:#ffffff1f;--mute2:#a9b8d0;--blue2:#5ab8ff}
  /* the course (L2): a header with a live countdown, then eleven cards, each with a glass lock until its video is online */
  .course{margin:34px 0 0}
  .g{background:linear-gradient(180deg,#f2f9ff 0%,#a6d4ff 36%,#3f8cff 70%,#2457e0 100%);-webkit-background-clip:text;background-clip:text;color:transparent;padding-right:.06em}
  .chead{display:grid;gap:12px;margin:0 0 22px}
  .chead .eyebrow{display:inline-flex;width:max-content;padding:6px 14px;border-radius:999px;background:#ffffff10;border:1px solid var(--line);font:600 12.5px Geist,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
  .chead h2{margin:0;font:700 clamp(30px,6vw,44px)/1.04 Geist,sans-serif;letter-spacing:-.035em}
  .chead p{margin:0;max-width:60ch;color:#cfdcf2;font-size:17px}
  .cd{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:4px}
  .cd .num{display:flex;gap:8px}
  .cd .num span{display:grid;justify-items:center;min-width:62px;padding:8px 10px;border-radius:14px;background:#ffffff12;border:1px solid var(--line)}
  .cd .num b{font:700 25px/1.1 Geist,sans-serif;font-variant-numeric:tabular-nums}
  .cd .num small{font:500 10.5px Geist,sans-serif;letter-spacing:.12em;color:var(--mute);text-transform:uppercase}
  .cd .when{font:500 15px Geist,sans-serif;color:var(--mute)}
  /* B3 (Nico 25/11): the card looks like the approved step covers: the cover photo blurred with grain, big number, big title
     with the keyword in azure, a thin azure light, a round glass lock, one short line */
  .steps2{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:14px}
  .steps2 li{position:relative;overflow:hidden;isolation:isolate;min-height:270px;padding:22px 22px 20px;border-radius:24px;background:#0a1428;border:1px solid var(--line);display:flex;flex-direction:column;transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.2,1)}
  .steps2.rv li{opacity:0;transform:translateY(18px)}
  .steps2.rv li.in{opacity:1;transform:none}
  .steps2 li > *{position:relative;z-index:2}
  .steps2 li > .sbg{position:absolute;z-index:0;inset:-12px;background-size:cover;background-position:center;opacity:.95;transform:scale(1.06)}
  .steps2 li > .sveil{position:absolute;z-index:1;inset:0;background:linear-gradient(180deg,#05091588 0%,#05091555 38%,#050915e0 100%)}
  .steps2 li > .sgrain{position:absolute;z-index:1;inset:0;opacity:.09;mix-blend-mode:overlay;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
  .steps2 .stop{display:flex;justify-content:space-between;align-items:flex-start}
  .steps2 .no{font:700 54px/.85 Geist,sans-serif;letter-spacing:-.06em;color:#fff;text-shadow:0 4px 30px #0008;font-variant-numeric:tabular-nums}
  .steps2 h3{margin:auto 0 8px;font:700 26px/1.04 Geist,sans-serif;letter-spacing:-.035em;text-wrap:balance;text-shadow:0 3px 24px #0009}
  .steps2 h3 em{font-style:normal;background:linear-gradient(100deg,#e2f1ff 0%,#8ccaff 45%,#5a9dff 100%);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:none;filter:drop-shadow(0 2px 10px #000c) drop-shadow(0 0 14px #2f7bff66)}
  .steps2 .sfl{display:block;height:1px;margin:2px 0 10px;background:linear-gradient(90deg,#6fb6ff00,#8cc4ffcc 40%,#dceeff 50%,#8cc4ffcc 60%,#6fb6ff00);opacity:.7}
  .steps2 p{margin:0 0 14px;color:#ffffffcc;font-size:15px;line-height:1.4;max-width:34ch}
  .steps2 video{display:block;width:100%;aspect-ratio:16/9;margin-top:4px;border-radius:14px;background:#000}
  .steps2 .aff{position:relative;margin:12px 0 0;font-size:15px;line-height:1.45;color:rgba(255,255,255,.78)}
  .steps2 .aff a{color:#6fb6ff;font-weight:600;text-decoration:underline;text-underline-offset:3px}
  .steps2 .aff span{color:rgba(255,255,255,.5)}
  .lk{position:relative;flex:none;width:50px;height:50px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(70% 70% at 35% 25%,#ffffff40,#ffffff10 60%);border:1px solid #ffffff38;backdrop-filter:blur(10px);box-shadow:0 0 0 6px #5aa8ff14,0 10px 30px -8px #2a74ffaa}
  .lk svg{width:22px;height:22px;filter:drop-shadow(0 0 6px #5aa8ffaa)}
  .lk::after{content:"";position:absolute;inset:-7px;border-radius:50%;border:1px solid #8cc4ff;opacity:0;animation:lkring 3.2s ease-out infinite;animation-delay:var(--d,0s)}
  @keyframes lkring{0%{opacity:.6;transform:scale(.9)}70%,100%{opacity:0;transform:scale(1.25)}}
  .lk-pill{align-self:flex-start;display:inline-flex;align-items:center;gap:7px;padding:5px 11px;border-radius:999px;background:#05091599;border:1px solid var(--line);font:600 12.5px Geist,sans-serif;color:#cfe3ff}
  .lk-pill i{width:7px;height:7px;border-radius:50%;background:#5ab8ff;box-shadow:0 0 0 4px #5ab8ff2a}
  @media (max-width:600px){.cd .num span{min-width:54px}.cd .num b{font-size:21px}}
  @media (prefers-reduced-motion:reduce){.lk::after{animation:none}.steps2.rv li{opacity:1;transform:none}}
</style>
<style is:global>
  /* ===== the page around board A's member area (the board drew it inside a phone or a browser frame) ===== */
  html, body.t3m { background: #0b1534; color: #fff; margin: 0 }
  body.t3m { min-height: 100vh; font-family: var(--f-sf); -webkit-font-smoothing: antialiased; overflow-x: clip }
  .t3m :focus-visible { outline: 3px solid #8cc4ff; outline-offset: 2px }
  .t3m .app.A { min-height: 100vh }
  .A .top { top: max(8px, env(safe-area-inset-top)) }
  .A .mbg { position: fixed; height: 100vh }
  .A .mbg img { transition: opacity .5s ease }
  .A .mtop { padding-top: 24px }
  .A .tabbar { position: fixed; left: 0; right: 0; bottom: 0; padding-bottom: max(16px, env(safe-area-inset-bottom)) }
  .A .member { padding-bottom: 112px }
  .A .mav { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font: 700 17px/1 var(--f-sfd); color: #fff; background: linear-gradient(140deg, #8cc4ff, #2a74ff 55%, #1d4fd8); box-shadow: 0 0 0 2px rgba(255,255,255,.22), 0 8px 20px rgba(42,116,255,.45); flex: none }
  .A .top .lockup img { width: 32px; height: 32px; display: block; filter: drop-shadow(0 4px 12px rgba(40,110,255,.4)) }
  .A [data-v] { display: none }
  .A[data-screen="home"] [data-v="home"], .A[data-screen="course"] [data-v="course"], .A[data-screen="vault"] [data-v="vault"], .A[data-screen="chal"] [data-v="chal"], .A[data-screen="me"] [data-v="me"] { display: block }
  /* Nico's welcome inside the board's video widget (.yt) */
  .A .yt video { display: block; width: 100%; height: 100%; object-fit: cover; cursor: pointer }
  .A .w .btn { justify-self: start; min-height: 44px; font-size: 15px; padding: 0 18px }
  .A .w .lede2 { margin: 0; font: 400 15px/20px var(--f-sf); color: var(--fg); opacity: .86; max-width: 46ch }
  .A .inc { text-decoration: none }
  .A .medal2 { position: relative }
  .A .medal2 small { font: 400 11px/14px var(--f-sf); color: var(--mute); max-width: 15ch }
  /* the course (B3 cards of the course chat, unchanged) inside the board's page */
  .A .ccourse { max-width: 1280px; margin: 0 auto; padding: 8px 24px 32px }
  .A .course .cd { display: flex; grid-template-columns: none; padding: 0; border-radius: 0; background: none; border: 0; -webkit-backdrop-filter: none; backdrop-filter: none }
  .A .course .cd > div + div { box-shadow: none }
  .A .course .cd .num span { text-transform: none; letter-spacing: 0; opacity: 1 }
  .A .course .chead h2 { font: 700 clamp(30px,6vw,44px)/1.04 Geist,sans-serif; letter-spacing: -.035em }
  .A .course .steps2 h3 { margin: auto 0 8px; font: 700 26px/1.04 Geist,sans-serif }
  .A .course .chead .eyebrow { opacity: 1 }
  .A .mfile { margin-top: 18px }
  .A .mfile .note, .A .files .note { margin: 8px 2px 0; font: 400 13.5px/1.45 var(--f-sf); color: var(--mute) }
  /* files: glass rows */
  .A .files { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 10px; margin-top: 8px }
  .A .fl { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 10px 14px; border-radius: 16px; border: 1px solid var(--edge); background: var(--glass-2);
    color: #fff; text-decoration: none; font: 500 15px/1.3 var(--f-sf); transition: border-color .2s, background-color .2s }
  .A .fl:hover { border-color: #8cc4ff; background: rgba(0,113,227,.28) }
  .A .fl b { flex: none; font: 700 11px/1 var(--f-sf); letter-spacing: .1em; padding: 6px 8px; border-radius: 8px; background: rgba(140,196,255,.2); color: #d6e9ff }
  .A .fl span { flex: 1; min-width: 0 }
  .A .fl .ic { width: 18px; height: 18px; color: #8cc4ff }
  .A .fl.lockd, .A .fl.lockd:hover { cursor: default; opacity: .78; border-color: var(--edge); background: var(--glass-2) } .A .fl.lockd b svg { width: 14px; height: 14px }
  .A .w.fgw { border-color: rgba(140,200,255,.65); box-shadow: 0 0 28px 2px rgba(59,155,255,.4), 0 0 70px 10px rgba(59,155,255,.14) }
  /* the build form in the challenge widget */
  .A .bform { display: grid; gap: 12px; margin-top: 8px }
  .A .bform label { font: 600 13px/16px var(--f-sf); color: var(--mute) }
  .A .bform input, .A .bform textarea { width: 100%; padding: 14px 16px; border-radius: 16px; border: 1px solid rgba(255,255,255,.22); background: rgba(255,255,255,.1); color: #fff; font: 400 17px/1.35 var(--f-sf); outline: none }
  .A .bform textarea { resize: vertical }
  .A .bform input:focus, .A .bform textarea:focus { border-color: #fff }
  .A .err { margin: 0; min-height: 20px; font: 500 15px/20px var(--f-sf); color: #ffb4a8 }
  .A .err.ok { color: #7fe0a8 }
  .A .msmall { margin: 0; font: 400 14px/20px var(--f-sf); color: var(--mute) }
  .A .msmall a { color: #8cc4ff }
  /* the sheet of a Vault build */
  .sheetwrap[hidden] { display: none }
  .sheetwrap { position: fixed; inset: 0; z-index: 60; --sheet-bg: #121c3d; --sheet-fg: #fff; --sheet-chip: rgba(255,255,255,.12) }
  .sheetwrap .sheet { position: absolute }
  @media (min-width: 900px) { .sheetwrap .sheet { left: 50%; right: auto; width: 560px; margin-left: -280px; bottom: auto; top: 50%; max-height: min(760px, calc(100% - 48px)) } .sheetwrap.on .sheet { transform: translateY(-50%) } }
  .sheet .fl { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 10px 14px; border-radius: 16px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: #fff; text-decoration: none; font: 500 15px/1.3 var(--f-sf) }
  .sheet .fl b { flex: none; font: 700 11px/1 var(--f-sf); letter-spacing: .1em; padding: 6px 8px; border-radius: 8px; background: rgba(140,196,255,.2); color: #d6e9ff }
  .sheet .fl span { flex: 1 } .sheet .fl .ic { width: 18px; height: 18px; color: #8cc4ff }
  .sheet .note { margin: 0; font: 400 13.5px/1.45 var(--f-sf); opacity: .75 }
  .toast { position: fixed }
  /* states outside the member area */
  .A .mbox { max-width: 560px; margin: 24px auto; padding: 24px; display: grid; gap: 14px }
  .A .mbox p { margin: 0; font: 400 17px/24px var(--f-sf) }
  .A .mbox a { color: #8cc4ff }
  .A .mbox input { width: 100%; height: 56px; padding: 0 16px; border-radius: 16px; border: 1px solid rgba(255,255,255,.22); background: rgba(255,255,255,.1); color: #fff; font: 400 17px/1 var(--f-sf) }
  .mfooter { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 22px 24px 120px; border-top: 1px solid rgba(255,255,255,.12); font: 400 13.5px/1.5 var(--f-sf); color: rgba(255,255,255,.66) }
  .mfooter nav { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-bottom: 10px }
  .mfooter a { color: #d9e6fb; text-decoration: none }
  .mfooter .w { font-weight: 600; color: #fff }
  @container app (min-width: 900px) {
    .A .member { margin-top: 0 }
    .A .mtop { padding-top: 48px }
    .A .ccourse { padding: 8px 64px 48px }
    .A .mbox { margin-top: 48px }
  }
  @media (min-width: 900px) { .mfooter { padding: 22px 64px 40px } }
  /* where board A's own rules met the course cards */
  .A .course .steps2 .no { color: #fff }
  .A .course .steps2 .stop { width: 100%; justify-content: space-between }
  .A .course .cd > div { display: flex; justify-items: normal; gap: 8px }
  .A .course .cd span { letter-spacing: normal; text-transform: none; opacity: 1 }
  .A .course .cd .when { font: 500 15px Geist, sans-serif; color: var(--mute2) }
  .A .snote { margin: 8px 2px 0; font: 400 13.5px/1.45 var(--f-sf); color: var(--mute) }
  .sheet .snote { margin: 0; opacity: .75 }
  .A a.lockup { text-decoration: none }
  .A .w.wf { align-content: start; min-height: 0 }

  /* ===== the course in front (25/11, Nico: «il corso in cui sta facendo adesso in primo piano, quando lo schiacci ti escono tutte le card») ===== */
  .A .cherow { grid-column: 1 / -1; display: grid; gap: 16px }
  .A .chero { position: relative; isolation: isolate; overflow: hidden; display: grid; min-height: 360px; border-radius: 32px; color: #fff; text-decoration: none; border: 1px solid rgba(190,220,255,.28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 30px 70px rgba(3,8,30,.45); transition: transform .3s cubic-bezier(.2,.8,.2,1), border-color .3s }
  .A .chero:hover { transform: translateY(-4px); border-color: rgba(140,196,255,.6) }
  .A .chero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -3; transform: scale(1.04) }
  .A .chero .gz { z-index: -2; height: 70% }
  .A .chero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(5,8,18,.2), rgba(5,8,18,0) 30%, rgba(5,8,18,.55) 70%, rgba(5,8,18,.88)) }
  .A .chero .grain2 { position: absolute; inset: 0; z-index: -1; opacity: .1; mix-blend-mode: overlay; pointer-events: none; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>") }
  .A .chero .ip { left: 16px; top: 16px; height: 32px; padding: 0 12px; font-size: 12px }
  .A .chno { position: absolute; right: 22px; top: 14px; display: flex; align-items: baseline; gap: 4px }
  .A .chno b { font: 700 84px/1 var(--f-sfd); letter-spacing: -.06em; text-shadow: 0 6px 36px rgba(0,0,0,.45) }
  .A .chno small { font: 500 20px/1 var(--f-sf); opacity: .8 }
  .A .chbody { align-self: end; display: grid; gap: 10px; padding: 96px 22px 22px }
  .A .cht { font: 700 40px/1.02 var(--f-sfd); letter-spacing: -.04em; text-wrap: balance; text-shadow: 0 3px 24px rgba(0,0,0,.45) }
  .A .chero .kw { font-style: normal; background: linear-gradient(100deg, #b9ddff 0%, #5aa8ff 52%, #2a74ff 100%); -webkit-background-clip: text; background-clip: text; color: transparent; filter: drop-shadow(0 0 16px rgba(47,123,255,.35)) }
  .A .chs { font: 500 17px/22px var(--f-sf); color: rgba(255,255,255,.92) }
  .A .chdots { display: grid; grid-template-columns: repeat(11, 1fr); gap: 5px; max-width: 440px; margin-top: 4px }
  .A .chdots i { height: 6px; border-radius: 3px; background: rgba(255,255,255,.28) }
  .A .chdots i.on { background: linear-gradient(90deg, #b9ddff, #5aa8ff 55%, #2a74ff) }
  .A .chfoot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; margin-top: 6px }
  .A .chcd { font: 500 15px/20px var(--f-sf); color: rgba(255,255,255,.86) }
  .A .chcd b { font-weight: 700; color: #fff }
  .A .chero .btn { pointer-events: none; min-height: 48px; padding: 0 20px; font-size: 16px }
  .A .nextc .big small { font: 400 17px/1 var(--f-sf); color: var(--mute); margin-left: 4px }
  .A .nextc { background: repeating-linear-gradient(115deg, rgba(255,255,255,.03) 0 2px, transparent 2px 18px), var(--glass) }
  @container app (min-width: 900px) {
    .A .chero { min-height: 420px }
    .A .chbody { padding: 120px 36px 32px }
    .A .cht { font-size: 64px }
    .A .chno b { font-size: 120px }
    .A .chno { right: 32px; top: 20px }
