---
// 17/11 (Nico): on the Riyadh thanks page the community card is no longer "on Skool": it is "The 3D Future", our own
// community that opens online on Friday 27 November, where we explain everything (how we build these 3D projects).
// "Save my spot" opens a small glass pop-up with name and email: the sign-up goes to /api/optin as
// free = 'waitlist-3d-future' (kept in the same list as the opt-ins, no email sent), and Nico's sheet
// ~/Documents/Omnya Community Waitlist.csv is filled from there by a sync on his Mac.
---
<article class="ryf" data-fade>
  <p class="ryf__tag"><i></i>Opens Friday 27 November</p>
  <h2 class="ryf__t">The 3D Future</h2>
  <p class="ryf__sub">Our community goes online in 10 days, and inside we explain everything: how we build these 3D towers, the prompts, the clips and how we sell them</p>
  <ul class="ryf__li"><li>Every reel taken apart, step by step</li><li>The project files</li><li>Live calls with us</li></ul>
  <button type="button" class="ryf__btn" data-ryf-open>Save my spot · free →</button>
  <p class="ryf__note">We write to you the day it opens</p>
</article>
<div class="ryfm" data-ryf-modal hidden>
  <form class="ryfm__box" data-ryf-form novalidate>
    <button type="button" class="ryfm__x" aria-label="Close" data-ryf-close>×</button>
    <p class="ryf__tag"><i></i>The 3D Future · 27 November</p>
    <h3 class="ryfm__t">Save your spot</h3>
    <input class="ryfm__in" name="name" placeholder="Your first name" autocomplete="given-name" maxlength="60" required>
    <input class="ryfm__in" name="email" type="email" placeholder="Your best email" autocomplete="email" maxlength="120" required>
    <input name="company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
    <button class="ryf__btn" type="submit" data-ryf-send>Put me on the list →</button>
    <p class="ryfm__err" data-ryf-err role="alert"></p>
    <p class="ryfm__ok" data-ryf-ok hidden></p>
  </form>
</div>
<style is:global>
.ryf{position:relative;margin:0 auto 40px;max-width:640px;padding:30px 24px 26px;border-radius:26px;text-align:center;color:#fff;background:linear-gradient(160deg,#ffffff1a,#ffffff08);border:1px solid #ffffff26;-webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px);box-shadow:0 40px 80px -40px #9d5cffaa,inset 0 1px #ffffff33}
.ryf__tag{display:inline-flex;align-items:center;gap:8px;margin:0;padding:6px 12px;border-radius:999px;background:#9d5cff2e;border:1px solid #9d5cff80;font:700 12px/1 var(--font);letter-spacing:.12em;text-transform:uppercase;color:#d9c8ff}
.ryf__tag i{width:7px;height:7px;border-radius:50%;background:#ffb066;box-shadow:0 0 0 3px #ffb06644}
.ryf__t{margin:14px 0 0;font:600 clamp(40px,8vw,64px)/1 var(--font);letter-spacing:-.03em;background:linear-gradient(180deg,#fff 0%,#ffb066 45%,#9d5cff 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.ryf__sub{margin:14px auto 0;max-width:500px;font:500 17px/1.45 var(--font);color:#d6cdea}
.ryf__li{list-style:none;margin:18px auto 0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.ryf__li li{padding:8px 12px;border-radius:999px;background:#ffffff12;border:1px solid #ffffff22;font:500 14px var(--font);color:#fff}
.ryf__btn{display:flex;align-items:center;justify-content:center;width:100%;max-width:420px;height:56px;margin:22px auto 0;border:0;border-radius:999px;background:linear-gradient(180deg,#b48cff,#8a4dff);color:#fff;font:600 17px var(--font);cursor:pointer;box-shadow:0 18px 40px -16px #9d5cffee}
.ryf__btn:disabled{opacity:.6}
.ryf__note{margin:10px 0 0;font:500 13px var(--font);color:#a99ec6}
.ryfm{position:fixed;inset:0;z-index:300;display:grid;place-items:center;padding:20px;background:#07041099;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.ryfm[hidden]{display:none}
.ryfm__box{position:relative;width:min(420px,100%);padding:28px 22px 22px;border-radius:24px;text-align:center;color:#fff;background:linear-gradient(160deg,#2a1650e6,#120a24f0);border:1px solid #ffffff2e;box-shadow:0 50px 100px -30px #000,0 0 80px -30px #9d5cff}
.ryfm__x{position:absolute;right:10px;top:10px;width:36px;height:36px;border:0;border-radius:50%;background:#ffffff14;color:#fff;font-size:22px;cursor:pointer}
.ryfm__t{margin:14px 0 16px;font:600 30px/1.1 var(--font);letter-spacing:-.02em}
.ryfm__in{display:block;width:100%;height:52px;margin:0 0 10px;padding:0 16px;border-radius:14px;border:1px solid #ffffff2e;background:#ffffff10;color:#fff;font:500 16px var(--font);outline:none}
.ryfm__in::placeholder{color:#a99ec6}
.ryfm__in:focus{border-color:#b48cff;box-shadow:0 0 0 3px #9d5cff44}
.ryfm .ryf__btn{margin-top:8px}
.ryfm__err{min-height:18px;margin:8px 0 0;font:500 13px var(--font);color:#ff8f8f}
.ryfm__ok{margin:6px 0 0;font:600 17px/1.4 var(--font);color:#fff}
</style>
<script is:inline>
{ const m = document.querySelector('[data-ryf-modal]'), f = document.querySelector('[data-ryf-form]')
  if (m && f) {
    const open = () => { m.hidden = false; setTimeout(() => f.name.focus(), 50) }, close = () => { m.hidden = true }
    document.querySelectorAll('[data-ryf-open]').forEach(b => b.addEventListener('click', open))
    m.querySelector('[data-ryf-close]').addEventListener('click', close)
    m.addEventListener('click', e => { if (e.target === m) close() })
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && !m.hidden) close() })
    f.addEventListener('submit', async e => {
      e.preventDefault()
      const err = f.querySelector('[data-ryf-err]'), ok = f.querySelector('[data-ryf-ok]'), btn = f.querySelector('[data-ryf-send]')
      const name = f.name.value.trim(), email = f.email.value.trim()
      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { err.textContent = 'Write your name and a valid email'; return }
      err.textContent = ''; btn.disabled = true; btn.textContent = 'Saving…'
      try {
        const r = await fetch('/api/optin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ free: 'waitlist-3d-future', name, email, page: 'thanks-' + location.pathname.split('/').pop(), company: f.company.value }) })
        if (!r.ok) throw new Error()
        f.querySelectorAll('input,[data-ryf-send]').forEach(x => x.hidden = true)
        ok.hidden = false; ok.textContent = 'You’re on the list, ' + name + '. We’ll email you on 27 November.'
        document.querySelectorAll('[data-ryf-open]').forEach(b => { b.textContent = '✓ You’re on the list'; b.disabled = true })
      } catch (_) { btn.disabled = false; btn.textContent = 'Put me on the list →'; err.textContent = 'Something went wrong, try again' }
    })
  } }
</script>
