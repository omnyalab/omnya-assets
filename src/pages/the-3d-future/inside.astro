  function paint(id) {
    const p = byId(id); if (!p) return
    $$(`[data-like="${id}"]`).forEach(b => { b.setAttribute('aria-pressed', String(!!p.liked)); const n = $('b', b); if (n) n.textContent = p.likes || '' })
    $$(`button[data-cmt="${id}"]`).forEach(b => { const n = $('b', b); if (n) n.textContent = p.comments || ''; else if (b.classList.contains('fpm')) b.textContent = p.comments ? (p.comments === 1 ? 'See the comment' : `See all ${p.comments} comments`) : 'Add a comment' })
    $$(`[data-share="${id}"] b`).forEach(n => { n.textContent = p.shares || '' })
  }
  function doLike(id, btn) {
    const p = byId(id); if (!p) return
    p.liked = !p.liked; p.likes = Math.max(0, (p.likes || 0) + (p.liked ? 1 : -1)); paint(id)
    if (btn && p.liked) { btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop') }
    post('/api/club/like', { m, id, on: p.liked }).then(r => { if (r.ok) { p.likes = r.d.likes; p.liked = r.d.liked; paint(id) } })
  }
  async function doShare(id) {
    const p = byId(id); if (!p) return
    let ok = false
    try { if (navigator.share) { await navigator.share({ title: `${p.name}'s build`, text: `${p.name}'s build, made in THE 3D FUTURE`, url: p.link }); ok = true } else throw 0 }
    catch (e) { if (e && e.name === 'AbortError') return; try { await navigator.clipboard.writeText(p.link); toast('Link copied'); ok = true } catch (_) { toast(p.link) } }
    if (ok) post('/api/club/share', { m, id }).then(r => { if (r.ok) { p.shares = r.d.shares; paint(id) } })
  }
