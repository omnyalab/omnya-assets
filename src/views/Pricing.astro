---
// Prices: three tables (images by quantity, films by length, launch packages) on a photo, rows in glass,
// the volume line, a real project on a dark band, terms, then the live demo.
// 10/11 (Nico): the Interactive 3D table opens with the pilot, €490, the first paid step before a full project.
// On phones each table row becomes one line: quantity left, price large right.
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import EndCta from '../components/EndCta.astro';
import { projects, href } from '../lib/data';
import { srcset } from '../lib/media';
import { t, langFromPath, localize } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const P = T.pricing;
const hygeia = projects.find((p) => p.id === '05_corfu_resort')!;
const bestRow = P.imagesBest;
// What a pack saves against single images, from the table itself (1 view = the first row)
const num = (v: string) => Number(v.replace(/[^\d]/g, ''));
const single = num(P.imagesRows[0][1]);
const money = (n: number) => {
  const g = String(n).replace(/\B(?=(\d{3})+(?!\d))/g, lang === 'it' ? '.' : ',');
  return lang === 'it' ? `${g} €` : `€${g}`;
};
// the same views at the single price, struck through next to the real one (also the monthly plan)
const perUnit = (q: string) => Number(q.match(/^\d+/)?.[0] ?? 0);
const saving = (q: string, price: string) => (/^\d+$/.test(q) && Number(q) > 1 ? Number(q) * single - num(price) : 0);
// Films: the same seconds bought as 30-second films (60 s = two, 90–120 s = four), struck through
const film30 = num(P.filmsRows[0][1]);
const filmUnits = [1, 2, 4];
// the 30-second film alone has a full price of its own, struck through like the others (Nico 9/11)
const film30Full = 1190;
const filmWas = (i: number) => (i === 0 ? film30Full : filmUnits[i] * film30);
// Packs: the same images at the single price plus the film of the same length, struck through
const packParts = [[8, 0], [15, 1], [25, 2]];
const packWas = (i: number) => packParts[i][0] * single + num(P.filmsRows[packParts[i][1]][1]);
// 10/11 (Nico): prices by zone. The page is written with today's prices; /api/geo says the zone of the visitor and
// scripts/pages.ts (priceZone) swaps the text of the marked elements. data-geo-190 = Europe, the Gulf and North America,
// where the single image is €190 (so the "bought one by one" prices struck through next to the packs grow with it);
// data-geo-gulf = the six Gulf countries, where Choose your floor and Full tower launch are at their full price,
// €4,900 and €7,900, with no launch offer (data-geo-off hides the struck price and "You save" there).
const single190 = 190;
const zImg = (q: string, price: string) => ({ was: money(perUnit(q) * single190), save: /^\d+$/.test(q) && Number(q) > 1 ? `${P.save} ${money(Number(q) * single190 - num(price))}` : '' });
const packWas190 = (i: number) => packParts[i][0] * single190 + num(P.filmsRows[packParts[i][1]][1]);
const gulfRows = [1, 2]; // Choose your floor, Full tower launch
// The "i" next to a name (8/11): the description and a moving preview in a small card, instead of text under the row
type Media = { video?: string; img?: string; poster?: string };
const byId = (id: string) => projects.find((p) => p.id === id);
const i3Media: Media[] = [
  // small clips made for this card (9/11): the card is 320 px wide, the home previews were 1.5-5 MB
  { video: '/prices/i3-house.mp4', poster: '/interactive/house-800.webp' },
  { video: '/prices/i3-tower.mp4', poster: '/interactive/tower-800.webp' },
  { video: '/prices/i3-tower.mp4', poster: '/interactive/tower-800.webp' },
];
const filmMedia: Media[] = ['30', '60', '90'].map((n) => ({ video: `/prices/film-${n}.mp4`, poster: `/prices/film-${n}.webp` }));
const packMedia: Media[] = ['02_villa_cape_town', '01_penthouse_dubai', '05_corfu_resort'].map((id) => ({ img: byId(id)?.gallery[0]?.mobile }));
const infos: { id: string; name: string; price: string; text: string; media?: Media; gulf?: string }[] = [
  { id: 'i3p', name: P.i3Pilot[0], price: P.i3Pilot[1], text: P.i3Pilot[3], media: i3Media[1] },
  ...P.i3Rows.map(([name, was, price, text], i) => ({ id: `i3-${i}`, name, price, text, media: i3Media[i], gulf: gulfRows.includes(i) ? was : undefined })),
  ...P.i3Extras.map(([name, price, text], i) => ({ id: `i3x-${i}`, name, price, text })),
  ...P.filmsRows.map(([len, price, use], i) => ({ id: `film-${i}`, name: `${len} ${P.filmsUnit}`, price, text: `${use}. ${P.filmsNoteShort}`, media: filmMedia[i] })),
  ...P.launchRows.map(([name, price, what], i) => ({ id: `pack-${i}`, name, price, text: what, media: packMedia[i] })),
];
---

<Base page="pricing" title={P.title} seoTitle={T.seo.pricing.title} description={T.seo.pricing.description}>
  <section class="phead wrap">
    <div class="work__head">
      <h1 class="t-display work__title" data-split="intro">{P.titleA}{' '}<span class="mute">{P.titleB}</span></h1>
    </div>
    <p class="t-sub phead__lead" data-fade="0.3" data-intro>{P.lead}</p>
  </section>

  <!-- The price tables on a warm light band, each row a sheet of white glass; the best one in colour -->
  <div class="pband">
  <!-- Interactive 3D (8/11): first, launch offer with the full price struck through -->
  <section class="prices wrap" aria-labelledby="i3-title">
    <h2 class="t-h3 prices__title" id="i3-title" data-split>{P.i3A}{' '}<span class="mute">{P.i3B}</span></h2>
    <table class="ptable ptable--films ptable--i3" data-fade>
      <caption class="sr-only">{P.i3A}, {P.i3B}</caption>
      <thead>
        <tr>{P.i3Cols.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        <tr class="ptable__pilot">
          <th scope="row" class="ptable__q">
            <span class="ptable__qn">{P.i3Pilot[0]}<button type="button" class="pinfo" data-info="i3p" aria-label={`${P.info} ${P.i3Pilot[0]}`}><span aria-hidden="true">i</span></button></span>
          </th>
          <td class="ptable__price">
            <span class="ptable__now">{P.i3Pilot[1]}</span>
            <span class="ptable__save">{P.i3Pilot[2]}</span>
          </td>
        </tr>
        {
          P.i3Rows.map(([name, was, price], i) => (
            <tr class:list={{ 'is-best': i === P.i3Best }}>
              <th scope="row" class="ptable__q">
                {i === P.i3Best && <span class="ptable__pill">{P.recommended}</span>}
                <span class="ptable__qn">{name}<button type="button" class="pinfo" data-info={`i3-${i}`} aria-label={`${P.info} ${name}`}><span aria-hidden="true">i</span></button></span>
              </th>
              <td class="ptable__price">
                <s class="ptable__was" data-geo-off={gulfRows.includes(i) ? 'gulf' : undefined}>{was}</s>
                <span class="ptable__now" data-geo-gulf={gulfRows.includes(i) ? was : undefined}>{price}</span>
                <span class="ptable__save" data-geo-off={gulfRows.includes(i) ? 'gulf' : undefined}>{P.save} {money(num(was) - num(price))}</span>
              </td>
            </tr>
          ))
        }
        {
          P.i3Extras.map(([name, price], i) => (
            <tr class="ptable__extra">
              <th scope="row" class="ptable__q">
                <span class="ptable__qn">{name}<button type="button" class="pinfo" data-info={`i3x-${i}`} aria-label={`${P.info} ${name}`}><span aria-hidden="true">i</span></button></span>
              </th>
              <td class="ptable__price"><span class="ptable__now">{price}</span></td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="prices__star" data-fade>{P.i3Star}</p>
    <div class="prices__ctas" data-fade>
      <a class="btn btn--sm prices__try" href={`${lang === 'it' ? '/it' : ''}/demo/hold-to-build/`} data-astro-reload>{P.tryLive} <Arrow /></a>
      <a class="btn btn--sm btn--fill" href={`https://wa.me/393792220465?text=${encodeURIComponent(P.pilotMsg)}`} target="_blank" rel="noopener">{P.pilotCta} <Arrow /></a>
    </div>
  </section>

  <!-- Films -->
  <section class="prices wrap" aria-labelledby="films-title">
    <h2 class="t-h3 prices__title" id="films-title" data-split>{P.filmsA}{' '}<span class="mute">{P.filmsB}</span></h2>
    <table class="ptable ptable--films" data-fade>
      <caption class="sr-only">{P.filmsA}, {P.filmsB}</caption>
      <thead>
        <tr>{P.filmsCols.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          P.filmsRows.map(([len, price, use], i) => (
            <tr class:list={{ 'is-best': i === P.filmsBest }}>
              <th scope="row" class="ptable__q">
                {i === P.filmsBest && <span class="ptable__pill">{P.recommended}</span>}
                <span class="ptable__qn">{len}<button type="button" class="pinfo" data-info={`film-${i}`} aria-label={`${P.info} ${`${len} ${P.filmsUnit}`}`}><span aria-hidden="true">i</span></button><span class="ptable__unit">{P.filmsUnit}</span></span>
              </th>
              <td class="ptable__price">
                <s class="ptable__was">{money(filmWas(i))}</s>
                <span class="ptable__now">{price}</span>
                <span class="ptable__save">{P.save} {money(filmWas(i) - num(price))}</span>
              </td>
              <td class="ptable__each">{use}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="prices__note prices__note--desk" data-fade>{P.filmsNote}</p>
    <p class="prices__note m-only" data-fade>{P.filmsNoteShort}</p>
  </section>

  <!-- Launch packages -->
  <section class="prices wrap" aria-labelledby="launch-title">
    <h2 class="t-h3 prices__title" id="launch-title" data-split>{P.launchA}{' '}<span class="mute">{P.launchB}</span></h2>
    <table class="ptable ptable--films ptable--packs" data-fade>
      <caption class="sr-only">{P.launchA}, {P.launchB}</caption>
      <thead>
        <tr>{P.launchCols.slice(0, 2).map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          P.launchRows.map(([name, price], i) => (
            <tr class:list={{ 'is-best': i === P.launchBest }}>
              <th scope="row" class="ptable__q">
                {i === P.launchBest && <span class="ptable__pill">{P.recommended}</span>}
                <span class="ptable__qn">{name}<button type="button" class="pinfo" data-info={`pack-${i}`} aria-label={`${P.info} ${name}`}><span aria-hidden="true">i</span></button></span>
              </th>
              <td class="ptable__price">
                <s class="ptable__was" data-geo-190={money(packWas190(i))}>{money(packWas(i))}</s>
                <span class="ptable__now">{price}</span>
                <span class="ptable__save" data-geo-190={`${P.save} ${money(packWas190(i) - num(price))}`}>{P.save} {money(packWas(i) - num(price))}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="prices__note prices__note--desk" data-fade>{P.launchNote}</p>
    <p class="prices__note m-only" data-fade>{P.launchNoteShort}</p>
  </section>
  <!-- Images -->
  <section class="prices wrap" aria-labelledby="images-title">
    <h2 class="t-h3 prices__title" id="images-title" data-split>{P.imagesA}{' '}<span class="mute">{P.imagesB}</span></h2>
    <table class="ptable ptable--images" data-fade>
      <caption class="sr-only">{P.imagesA}, {P.imagesB}</caption>
      <thead>
        <tr>{P.imagesCols.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          P.imagesRows.map(([q, price, each], i) => (
            <tr class:list={{ 'is-best': i === bestRow }}>
              <th scope="row" class="ptable__q">
                {i === bestRow && <span class="ptable__pill">{P.best}</span>}
                <span class="ptable__qn">{q}{/^\d+$/.test(q) && <span class="ptable__unit">{q === '1' ? P.imagesUnit[0] : P.imagesUnit[1]}</span>}</span>
              </th>
              <td class="ptable__price">
                {perUnit(q) > 1 && <s class="ptable__was" data-geo-190={zImg(q, price).was}>{money(perUnit(q) * single)}</s>}
                <span class="ptable__now" data-geo-190={q === '1' ? money(single190) : undefined}>{price}</span>
                {saving(q, price) > 0 && <span class="ptable__save" data-geo-190={zImg(q, price).save}>{P.save} {money(saving(q, price))}</span>}
              </td>
              <td class="ptable__each" data-label={P.imagesCols[2]} data-geo-190={q === '1' ? money(single190) : undefined}>{each}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="prices__note d-only" data-fade>{P.imagesNote}</p>
    <p class="prices__star d-only" data-fade>{P.imagesStar}</p>
    <p class="prices__note m-only" data-fade>{P.imagesNoteShort}</p>
    <p class="prices__star m-only" data-fade>{P.imagesStarShort}</p>
    <p class="t-sub prices__volume" data-fade>{P.volume}</p>
    <p class="prices__star" data-fade>{P.note}</p>
  </section>

  </div>

  <!-- A real project -->
  <section class="pcase" aria-labelledby="case-title" data-header="light">
    <div class="pcase__bg" aria-hidden="true">
      <img data-src={hygeia.gallery[5].mobile} data-srcset={srcset(hygeia.gallery[5])} sizes="100vw" alt="" decoding="async" />
    </div>
    <div class="pcase__in wrap">
      <h2 class="t-h1 pcase__title" id="case-title" data-split>{P.caseA}{' '}<span class="mute">{P.caseB}</span></h2>
      <div class="pcase__row">
        <p class="t-sub pcase__text" data-fade>{P.caseText}</p>
        <ul class="pcase__stats">
          {
            P.caseStats.map((st) => (
              <li data-fade>
                <span class="pcase__n">{st.n}</span>
                <span class="pcase__l">{st.label}</span>
              </li>
            ))
          }
        </ul>
        <a href={localize(href(hygeia), lang)} class="btn btn--light pcase__link" data-fade>{P.caseLink} <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- Terms -->
  <section class="pterms wrap" aria-labelledby="terms-title">
    <h2 class="t-h3 pterms__title" id="terms-title" data-split>{P.termsA}{' '}<span class="mute">{P.termsB}</span></h2>
    <p class="t-sub pterms__text" data-fade>{P.terms}</p>
    <ol class="pfig" data-play>
      {P.termsFigs.map(([n, l]) => <li><span class="pfig__n">{n}</span><span class="pfig__l">{l}</span></li>)}
    </ol>
  </section>


  <!-- what the "i" buttons open: one card, filled from these templates -->
  {
    infos.map((f) => (
      <template id={`info-${f.id}`}>
        {f.media && (
          <div class="pinfo-pop__media">
            {f.media.video ? <video src={f.media.video} poster={f.media.poster} muted playsinline loop preload="none"></video> : <img src={f.media.img} alt="" />}
          </div>
        )}
        <p class="pinfo-pop__name"><span>{f.name}</span><span data-geo-gulf={f.gulf}>{f.price}</span></p>
        <p class="pinfo-pop__text">{f.text}</p>
      </template>
    ))
  }
  <div class="pinfo-pop" role="dialog" hidden data-info-pop>
    <button type="button" class="pinfo-pop__x" aria-label={P.close} data-info-close><span aria-hidden="true">×</span></button>
    <div data-info-body></div>
  </div>

  <EndCta second="work" />
</Base>
