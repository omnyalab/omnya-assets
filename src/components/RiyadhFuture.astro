---
// 17/11 (Nico): on the Riyadh thanks page the community card is no longer "on Skool": it is "The 3D Future", our own
// community that opens online on Friday 27 November, where we explain everything (how we build these 3D projects).
// "Save my spot" opens a small glass pop-up with name and email: the sign-up goes to /api/optin as
// free = 'waitlist-3d-future' (kept in the same list as the opt-ins, no email sent), and Nico's sheet
// ~/Documents/Omnya Community Waitlist.csv is filled from there by a sync on his Mac.
// 18/11 (Nico): the card keeps the colours of The 3D Future on every thanks page (never the funnel's): the blue glass
// knot, "The 3D Future" in Geist with "3D" in the blue gradient, glass with a blue glow, and behind it a blurred photo
// of one of our projects that is barely seen (bg: towers, burj or stadium; Nico chose B2, the Burj at night).
// kind="build" only changes the words. The pop-up opens only on a tap of "Save my spot", never by itself, and
// says what the community is (18/11, Nico: "the pop-up a bit explained").
// 20/11 (Nico): the card changes with the date (Europe/Rome), same look in every state:
// 1. "soon"   until Sat 28/11/2026 09:00: the card and the pop-up of today, the tag now says "Opens Saturday 28 November"
//    (the success text keeps "We'll email you on 27 November": that email is real)
// 2. "open"   from 28/11 09:00: the join card, €9 a month, with the seats left
// 24/11 (Nico: «le porte son sempre aperte»): the doors never close, so there is no "closed" state any more. From Sat 5/12
// 00:00 (data-founders-end) the card stays open: before the purchase (href) it says €19 and the seats go, on the thanks
// pages the buyer keeps €9.
// The page is static, so the script below picks the state in the visitor's browser (the HTML starts with the state of
// the build time, for who has no JavaScript). Preview of any state: ?at=<ISO date>, e.g.
// /learn/thanks/full-stadium?at=2026-11-28T10:00:00%2B01:00&seats=63
// panel: on the light thanks pages (full-tower, full-towers, full-3d, everything) the card sits on its own night ground.
// href (20/11, Nico, Riyadh video page): the same card before the purchase; its buttons open the club page
// (/the-3d-future does the pre-registration, then the join) instead of the pop-up, and the "you bought this guide" line
// is left out. Without href the card is exactly the one of the thanks pages.
// cta (27/11, Nico on the Rome page: «senza join for 9 month… te lo dice alla fine dopo le card»): a button label with no
// price, the club page says the price at the end. Without cta the button is the one of before.
const { kind = 'riyadh', bg = 'burj', panel = false, href = '', cta = '' } = Astro.props as { kind?: 'riyadh' | 'build' | 'stadium' | 'plane' | 'mastery' | 'villa' | 'rome'; bg?: 'towers' | 'burj' | 'stadium'; panel?: boolean; href?: string; cta?: string };
const what = kind === 'build' ? 'these 3D houses' : kind === 'stadium' ? 'these 3D stadiums' : kind === 'plane' ? 'these 3D planes' : kind === 'mastery' ? 'any 3D like this' : kind === 'villa' ? 'villas like this' : kind === 'rome' ? 'cities like this' : 'these 3D towers';
// Rome is on +01:00 for the whole window (CET), so the two instants are fixed
const OPEN = '2026-11-28T09:00:00+01:00', FOUNDERS_END = '2026-12-05T00:00:00+01:00';
const at = Date.now();
const state = at < Date.parse(OPEN) ? 'soon' : 'open';
const after = at >= Date.parse(FOUNDERS_END);
---
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@500;600;700&display=swap" rel="stylesheet">
<section class:list={['ryfw', { 'ryfw--panel': panel }]} data-fade data-ryf data-open={OPEN} data-founders-end={FOUNDERS_END}>
  <img class="ryfw__bg" src={`/learn/3df_bg_${bg}.webp`} alt="" aria-hidden="true" loading="lazy">
  <span class="ryfw__glow" aria-hidden="true"></span>
  {/* 1. soon: until Sat 28/11 09:00 */}
  <article class="ryf" data-ryf-state="soon" hidden={state !== 'soon'}>
    <img class="ryf__logo" src="/learn/3df_knot.webp" alt="" width="120" height="120">
    <p class="ryf__tag"><i></i>Opens Saturday 28 November</p>
    <h2 class="ryf__t">The <span>3D</span> Future</h2>
    <p class="ryf__sub">Our community, where we show you how we build {what} from the first prompt to the client who pays</p>
    <ul class="ryfm__li ryf__chk"><li>Every reel taken apart, step by step</li><li>The project files we use</li><li>Live calls with us</li></ul>
    <p class="ryfm__k">Save your spot, it's free</p>
    {href ? <a class="ryf__btn ryf__btn--card ryf__btn--link" href={href}>Save my spot →</a> : <button type="button" class="ryf__btn ryf__btn--card" data-ryf-open>Save my spot →</button>}
  </article>
  {/* 2. open: from 28/11 09:00, the join card (24/11: the doors never close) */}
  <article class="ryf" data-ryf-state="open" hidden={state !== 'open'}>
    <img class="ryf__logo" src="/learn/3df_knot.webp" alt="" width="120" height="120">
    <h2 class="ryf__t">The <span>3D</span> Future</h2>
    <p class="ryf__sub">The club where you learn to build the 3D that sells</p>
    <ul class="ryfm__li ryf__chk"><li>Step-by-step video courses on our builds</li><li>Six builds from our reels, with files, prompts and Claude skills</li><li>My comments on your builds every Monday</li></ul>
    {!href && <p class="ryf__lock">You bought this guide, so your price stays €9 a month, even after the first 100</p>}
    {/* 26/11 (Nico: «non si deve sapere quante persone sono dentro»): no seats counter here any more */}
    {/* TODO: the Stripe subscription link (€9/month) goes here */}
    <a class="ryf__btn ryf__btn--card ryf__btn--join" href={href || '#join'} data-ryf-join data-after={cta ? '' : href ? 'Join for €19/month' : ''}>{cta || (href && after ? 'Join for €19/month' : 'Join for €9/month')}</a>
    <p class="ryf__note">Cancel in one tap</p>
  </article>
</section>
{!href && <div class="ryfm" data-ryf-modal hidden>
  <form class="ryfm__box" data-ryf-form novalidate>
    <button type="button" class="ryfm__x" aria-label="Close" data-ryf-close>×</button>
    <img class="ryf__logo ryf__logo--s" src="/learn/3df_knot.webp" alt="" width="64" height="64">
    <p class="ryf__tag"><i></i><span>Opens Saturday 28 November</span></p>
    <h3 class="ryfm__t">The <span>3D</span> Future</h3>
    <p class="ryfm__sub">Our community, where we show you how we build {what} from the first prompt to the client who pays</p>
    <ul class="ryfm__li"><li>Every reel taken apart, step by step</li><li>The project files we use</li><li>Live calls with us</li></ul>
    <p class="ryfm__k">Save your spot, it's free</p>
    <input class="ryfm__in" name="name" placeholder="Your first name" autocomplete="given-name" maxlength="60" required>
    <input class="ryfm__in" name="email" type="email" placeholder="Your best email" autocomplete="email" maxlength="120" required>
    <input name="company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
    <button class="ryf__btn" type="submit" data-ryf-send>Put me on the list →</button>
    <p class="ryfm__err" data-ryf-err role="alert"></p>
    <p class="ryfm__ok" data-ryf-ok hidden></p>
  </form>
</div>}
<style is:global>
.ryfw{position:relative;isolation:isolate;max-width:720px;margin:0 auto 48px;padding:56px 18px;font-family:Geist,Inter,-apple-system,system-ui,sans-serif}
.ryfw__bg{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;border-radius:36px;opacity:.32;filter:blur(14px) saturate(1.1);-webkit-mask:radial-gradient(75% 70% at 50% 50%,#000 45%,transparent 100%);mask:radial-gradient(75% 70% at 50% 50%,#000 45%,transparent 100%)}
.ryfw__glow{position:absolute;left:50%;top:50%;z-index:-1;width:78%;height:72%;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(closest-side,#2f8bffaa,#0071e355 55%,transparent 100%);filter:blur(30px)}
.ryf{position:relative;margin:0 auto;max-width:560px;padding:30px 24px 26px;border-radius:28px;text-align:center;color:#fff;background:linear-gradient(160deg,#ffffff24,#ffffff08 55%,#0a1a3a33);border:1px solid #ffffff30;-webkit-backdrop-filter:blur(26px) saturate(1.4);backdrop-filter:blur(26px) saturate(1.4);box-shadow:inset 0 1px #ffffff55,inset 0 0 0 1px #8fc2ff1a,0 40px 80px -40px #000c}
.ryf__logo{display:block;width:96px;height:96px;margin:0 auto 6px;filter:drop-shadow(0 14px 26px #0b3d8a99)}
.ryf__logo--s{width:56px;height:56px;margin-bottom:10px}
.ryf__tag{display:inline-flex;align-items:center;gap:8px;margin:0;padding:6px 12px;border-radius:999px;background:#2f8bff26;border:1px solid #6fb2ff66;font:600 12px/1 Geist,Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#cfe5ff}
.ryf__tag i{width:7px;height:7px;border-radius:50%;background:#5ab8ff;box-shadow:0 0 0 3px #5ab8ff44}
.ryf__t{margin:14px 0 0;font:700 clamp(40px,8vw,62px)/1.02 Geist,Inter,sans-serif;letter-spacing:-.035em;color:#fff}
.ryf__t span{background:linear-gradient(180deg,#bfe0ff 0%,#5ab8ff 45%,#0071e3 100%);-webkit-background-clip:text;background-clip:text;color:transparent;padding-right:.1em;margin-right:-.1em}
.ryf__sub{margin:14px auto 0;max-width:470px;font:500 16.5px/1.45 Geist,Inter,sans-serif;color:#d5e3f5}
.ryf__li{list-style:none;margin:18px auto 0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.ryf__li li{padding:8px 12px;border-radius:999px;background:#ffffff12;border:1px solid #ffffff24;font:500 14px Geist,Inter,sans-serif;color:#fff}
.ryf__btn{display:flex;align-items:center;justify-content:center;width:100%;max-width:420px;height:56px;margin:22px auto 0;border:0;border-radius:999px;background:linear-gradient(180deg,#2f8bff,#0071e3);color:#fff;font:600 17px Geist,Inter,sans-serif;cursor:pointer;box-shadow:inset 0 1px #ffffff55,0 18px 36px -14px #0071e3}
.ryf__btn:disabled{opacity:.6}
/* 18/11 (Nico): the card uses the words and the layout of the pop-up */
.ryf__chk{max-width:420px;margin:18px auto 0}
.ryf .ryfm__k{margin:20px 0 0}
.ryf .ryf__btn--card{margin-top:12px}
.ryf__note{margin:10px 0 0;font:500 13px Geist,Inter,sans-serif;color:#9fb6d3}
.ryfm{position:fixed;inset:0;z-index:300;display:grid;place-items:center;padding:20px;overflow-y:auto;background:#020814aa;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);font-family:Geist,Inter,sans-serif}
.ryfm[hidden]{display:none}
.ryfm__box{position:relative;width:min(420px,100%);padding:28px 22px 22px;border-radius:24px;text-align:center;color:#fff;background:linear-gradient(160deg,#16305acc,#0a1630ee);border:1px solid #ffffff2a;box-shadow:inset 0 1px #ffffff40,0 30px 80px -20px #0071e399}
.ryfm__x{position:absolute;right:10px;top:10px;width:36px;height:36px;border:0;border-radius:50%;background:#ffffff14;color:#fff;font:400 22px/1 Geist,Inter,sans-serif;cursor:pointer}
.ryfm__t{margin:12px 0 0;font:700 36px/1.05 Geist,Inter,sans-serif;letter-spacing:-.035em}
.ryfm__t span{background:linear-gradient(180deg,#bfe0ff 0%,#5ab8ff 45%,#0071e3 100%);-webkit-background-clip:text;background-clip:text;color:transparent;padding-right:.1em;margin-right:-.1em}
.ryfm__sub{margin:10px auto 0;max-width:330px;font:500 15px/1.45 Geist,Inter,sans-serif;color:#d5e3f5}
.ryfm__li{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:7px;text-align:left}
.ryfm__li li{position:relative;padding:9px 12px 9px 34px;border-radius:12px;background:#ffffff0d;border:1px solid #ffffff1f;font:500 14px Geist,Inter,sans-serif;color:#fff}
.ryfm__li li::before{content:"✓";position:absolute;left:12px;top:50%;transform:translateY(-50%);font:700 13px Geist,Inter,sans-serif;color:#5ab8ff}
.ryfm__k{margin:18px 0 12px;font:600 15px Geist,Inter,sans-serif;color:#fff}
.ryfm__in{display:block;width:100%;box-sizing:border-box;height:52px;margin:0 0 10px;padding:0 16px;border-radius:14px;border:1px solid #ffffff2e;background:#ffffff10;color:#fff;font:500 16px Geist,Inter,sans-serif;outline:none}
.ryfm__in::placeholder{color:#9fb6d3}
.ryfm__in:focus{border-color:#5ab8ff;box-shadow:0 0 0 3px #2f8bff44}
.ryfm .ryf__btn{margin-top:8px}
.ryfm__err{min-height:18px;margin:8px 0 0;font:500 13px Geist,Inter,sans-serif;color:#ff8f8f}
.ryfm__ok{margin:6px 0 0;font:600 17px/1.4 Geist,Inter,sans-serif;color:#fff}
/* 20/11: the join card (state 2), the night ground on the light pages */
.ryf[hidden]{display:none}
/* the checklist of the card centred under the title (.ryfm__li, written later, took its margin: list off to the left on desktop) */
.ryf .ryf__chk{margin:18px auto 0}
.ryf__lock{max-width:420px;margin:18px auto 0;padding:12px 14px;text-wrap:balance;border-radius:14px;background:#2f8bff1f;border:1px solid #6fb2ff55;font:600 14.5px/1.4 Geist,Inter,sans-serif;color:#e4f0ff}
.ryf__seats{max-width:420px;margin:18px auto 0}
.ryf__seats p{margin:0;font:600 15px Geist,Inter,sans-serif;color:#fff}
.ryf__seats b{font-weight:700;color:#8fd0ff}
.ryf__bar{display:block;height:6px;margin:9px auto 0;border-radius:999px;background:#ffffff1a;overflow:hidden}
.ryf__bar i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#5ab8ff,#0071e3)}
.ryf .ryf__btn--join{margin-top:16px;text-decoration:none}
.ryf .ryf__btn--link{text-decoration:none}
.ryf .ryf__note{margin-top:10px}
.ryfw--panel{overflow:hidden;border-radius:36px;background:radial-gradient(120% 80% at 50% 0%,#10254a,#060c1a 72%);box-shadow:0 40px 80px -40px #0b3d8a99}
.ryfw--panel .ryfw__bg{opacity:.45}
@media (max-width:620px){.ryfw--panel{border-radius:28px}.ryfw--panel .ryfw__bg{border-radius:28px}}
@media (max-width:620px){.ryfw{padding:40px 10px}.ryf{padding:26px 18px 22px}.ryf__logo{width:84px;height:84px}}
</style>
<script is:inline>
{ const box = document.querySelector('[data-ryf]'), m = document.querySelector('[data-ryf-modal]'), f = document.querySelector('[data-ryf-form]')
  // the state by the date (Europe/Rome instants in data-open / data-founders-end); ?at=<ISO date> previews another moment
  let state = 'soon'
  if (box) {
    const q = new URLSearchParams(location.search)
    let now = Date.now()
    const at = Date.parse((q.get('at') || '').replace(' ', '+'))
    if (!isNaN(at)) now = at
    state = now < Date.parse(box.dataset.open) ? 'soon' : 'open'
    const after = now >= Date.parse(box.dataset.foundersEnd) // 24/11: only the founders' €9 and gifts end, the doors stay open
    box.querySelectorAll('[data-ryf-state]').forEach(a => { a.hidden = a.dataset.ryfState !== state })
    const jb = box.querySelector('[data-ryf-join]')
    if (jb && jb.dataset.after) jb.textContent = after ? jb.dataset.after : 'Join for €9/month'
  }
  if (m && f) {
    const open = () => { m.hidden = false; setTimeout(() => f.name.focus(), 50) }, close = () => { m.hidden = true }
    document.querySelectorAll('[data-ryf-open]').forEach(b => b.addEventListener('click', open))
    m.querySelector('[data-ryf-close]').addEventListener('click', close)
    m.addEventListener('click', e => { if (e.target === m) close() })
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && !m.hidden) close() })
    f.addEventListener('submit', async e => {
      e.preventDefault()
      const err = f.querySelector('[data-ryf-err]'), ok = f.querySelector('[data-ryf-ok]'), btn = f.querySelector('[data-ryf-send]')
      const name = f.name.value.trim(), email = f.email.value.trim()
      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { err.textContent = 'Write your name and a valid email'; return }
      err.textContent = ''; btn.disabled = true; btn.textContent = 'Saving…'
      try {
        const r = await fetch('/api/optin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ free: 'waitlist-3d-future', name, email, page: 'thanks-' + location.pathname.split('/').pop(), company: f.company.value }) })
        if (!r.ok) throw new Error()
        f.querySelectorAll('input,[data-ryf-send]').forEach(x => x.hidden = true)
        ok.hidden = false; ok.textContent = 'You’re on the list, ' + name + '. We’ll email you on 27 November.'
        document.querySelectorAll('[data-ryf-open]').forEach(b => { b.textContent = '✓ You’re on the list'; b.disabled = true })
      } catch (_) { btn.disabled = false; btn.textContent = 'Put me on the list →'; err.textContent = 'Something went wrong, try again' }
    })
  } }
</script>
