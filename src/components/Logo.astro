---
// The SVGs are cut to the ink: the box is the logo, nothing to crop.
interface Props {
  light?: boolean;
  /** Load the white version right away (pages that open over a dark image). */
  lightNow?: boolean;
  class?: string;
}
const { light = false, lightNow = false, class: cls } = Astro.props;
---

<span class:list={['logo', cls]} role="img" aria-label="Omnya Lab">
  <img class="logo__img logo__img--dark" src="/brand/OmnyaLab_Logo_Black.svg" alt="" width="831" height="175" />
  {light && lightNow && <img class="logo__img logo__img--light" src="/brand/OmnyaLab_Logo_White.svg" alt="" width="831" height="175" />}
  {light && !lightNow && <img class="logo__img logo__img--light" data-src="/brand/OmnyaLab_Logo_White.svg" alt="" width="831" height="175" />}
</span>
