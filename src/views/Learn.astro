---
import EndCta from '../components/EndCta.astro';
// Learn: a full-screen hero where the 3D model and the final image share one camera
// (on phones the scroll wipes the 3D into the photo under the title; on desktop the line
// sweeps once on arrival, then it is yours to drag; the views sit in the hero), who it is for,
// the three playbooks as real book covers, the three fanned out as the bundle, the private
// lessons, the studio band, the community and the questions people ask before buying.
// /learn/<word> is the same page for people coming from a reel: the free PDF first, then
// that word's playbook first. Every button goes through /go/<id> (lib/learn.ts).
import Base from '../layouts/Base.astro';
import Duo from '../components/Duo.astro';
import Arrow from '../components/Arrow.astro';
import BookCover from '../components/BookCover.astro';
import TowerOffer from '../components/TowerOffer.astro';
import { projects } from '../lib/data';
import { srcset } from '../lib/media';
import { goHref, words, prices, type ProductId } from '../lib/learn';
import { t, langFromPath, localize } from '../i18n';

interface Props {
  word?: string;
  /** /the-blueprint (2/11): the free PDF first, one page for every reel */
  blueprint?: boolean;
  /** /the-tower-blueprint (3/11): the same page for the tower reels, Burtville in the hero, Playbook 03 first */
  tower?: boolean;
  /** /casa-cresta-blueprint (4/11): the Blueprint for the Casa Cresta reels, English only */
  cresta?: boolean;
}
const { word, blueprint = false, tower = false, cresta: crestaPage = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const L = T.learn;
const X = L.tw;
const w = words.find((x) => x.word === word);
const free = !!w || blueprint || tower || crestaPage;
const samar = projects.find((p) => p.id === '16_samar')!;

// Book covers: our own pictures with a light grade; Playbook 01 fades from our 3D to the photo
const covers: Record<string, { real: { mobile: string; srcset: string; pos?: string }; white?: { mobile: string; srcset: string; pos?: string }; c1: string; c2: string }> = {
  'white-to-real': {
    real: { mobile: '/learn/burt_towers_real_mobile.webp', srcset: '/learn/burt_towers_real_mobile.webp 760w, /learn/burt_towers_real.webp 1920w', pos: '55% 50%' },
    white: { mobile: '/learn/burt_towers_white_mobile.webp', srcset: '/learn/burt_towers_white_mobile.webp 760w, /learn/burt_towers_white.webp 1920w', pos: '55% 50%' },
    c1: '#ffe2c4', c2: '#a9c9ef',
  },
  reel: { real: { mobile: '/learn/dev_sunset_mobile.webp', srcset: '/learn/dev_sunset_mobile.webp 960w, /learn/dev_sunset.webp 1920w', pos: '42% 50%' }, c1: '#ffe0b0', c2: '#ff9d7c' },
  'before-it-exists': { real: { mobile: '/learn/dev_elan_mobile.webp', srcset: '/learn/dev_elan_mobile.webp 806w, /learn/dev_elan.webp 1611w', pos: '50% 40%' }, c1: '#ffd2a6', c2: '#aab8ff' },
};

// The playbook of the commented word goes first
const focus = tower ? 'before-it-exists' : w?.focus;
const books = focus ? [...L.books].sort((a, b) => (a.id === focus ? -1 : b.id === focus ? 1 : 0)) : L.books;

// Casa Cresta: the same camera in the 3D model and in the final image
// /learn opens on Burtville (towers, night, living room); the reel pages keep Casa Cresta
const cresta = free && !tower;
const set = cresta ? 'cresta' : 'burt';
const place = cresta ? 'Casa Cresta' : 'Burtville';
const views = cresta ? ['front', 'pool', 'living'] : ['towers', 'night', 'living'];
const rooms = cresta ? L.compareRooms : L.compareRoomsB;
const pic = (v: string, kind: 'white' | 'real') => ({
  desk: `/learn/${set}_${v}_${kind}.webp`,
  mobile: `/learn/${set}_${v}_${kind}_mobile.webp`,
});
const go = (id: ProductId) => goHref(id, lang, w?.word);
const eur = (n: number) => (lang === 'it' ? `${n} €` : `€${n}`);
// what the pack costs on top of this playbook (7/11 prices: 01 €79 = the pack, 02 €49, 03 €39)
const diff = (id: string) => prices.bundle - (prices[id as keyof typeof prices] ?? prices.bundle);
const buyData = (b: { id: string; a: string; b: string; price: string }) => ({
  'data-buy': '',
  'data-name': `${b.a} ${b.b}`,
  'data-price': b.price,
  'data-diff': String(diff(b.id)),
  'data-diff-eur': eur(diff(b.id)),
  'data-go': go(b.id as ProductId),
  'data-bundle-go': go('bundle'),
  'data-bundle-price': L.bundleB,
  'data-cover': `/studio/book_${b.id}_${lang}_mobile.webp`,
});
const commImgs = ['/learn/cresta_living_real_mobile.webp', '/learn/dev_lobby_mobile.webp', '/learn/dev_dusk_mobile.webp'];
---

<Base page="learn" title={tower ? L.towerA : crestaPage ? `${L.crestaA} ${L.crestaB}` : blueprint ? L.freeA : w ? `${L.heroA} ${L.heroB} · ${w.label}` : `${L.heroA} ${L.heroB}`} seoTitle={!tower && !crestaPage && !blueprint && !w ? T.seo.learn.title : undefined} description={L.description} noindex={!!w}>
  <!-- Hero: the 3D model over the final image, full screen -->
    {
    tower && (
      <section class="twhero" data-header="light" data-header-media aria-labelledby="learn-title">
        <picture>
          <source media="(max-width: 699px)" srcset="/learn/samar_tower_mobile.webp" />
          <img class="twhero__img" src="/learn/samar_tower.webp" width="1920" height="1071" alt="SAMAR, Dubai Marina: the tower at sunset over the marina" fetchpriority="high" decoding="async" />
        </picture>
        <div class="twhero__in wrap">
          <h1 class="t-display twhero__title" id="learn-title" data-split="intro">{X.heroA}</h1>
          <p class="t-sub twhero__sub" data-fade>{X.sub}</p>
          <div class="twhero__ctas" data-fade>
            <a class="twbtn twbtn--white" href={go('free-tower')} target="_blank" rel="noopener" data-tw-dl>{X.download} <Arrow /></a>
            <a class="twbtn twbtn--blue tw-shine" href="#full"><span data-tw-deal>{X.offer}</span><span data-tw-after hidden>{X.bookAlt.split(',')[0]}</span> <Arrow /></a>
          </div>
        </div>
      </section>
    )
  }
  {tower && <TowerOffer variant="top" />}
  {
    !tower && (
<section class="lhero" data-header="light" data-header-media aria-labelledby="learn-title" data-lhero>
    <div class="lhero__stick">
      <div class="cmp" data-cmp style="--x: 100%">
        <picture>
          <source media="(max-width: 699px)" srcset={pic(views[0], 'real').mobile} data-cmp-real-m />
          <img class="cmp__img" src={pic(views[0], 'real').desk} width="1920" height="1080" alt={`${L.compareReal}: ${place}, ${rooms[0]}`} fetchpriority="high" decoding="async" data-cmp-real />
        </picture>
        <div class="cmp__top" aria-hidden="true">
          <picture>
            <source media="(max-width: 699px)" srcset={pic(views[0], 'white').mobile} data-cmp-white-m />
            <img class="cmp__img" src={pic(views[0], 'white').desk} width="1920" height="1080" alt="" decoding="async" data-cmp-white />
          </picture>
        </div>
        <span class="cmp__shade" aria-hidden="true"></span>
        <span class="cmp__tag cmp__tag--l" aria-hidden="true">{L.compareWhite}</span>
        <span class="cmp__tag cmp__tag--r" aria-hidden="true">{L.compareReal}</span>
        <span class="cmp__line" aria-hidden="true"><span class="cmp__knob"><Arrow /><Arrow /></span></span>
        <input class="cmp__range" type="range" min="0" max="100" value="50" aria-label={L.compareHandle} data-cmp-range />
      </div>

      <div class="lhero__in wrap">
        {
          w && (
            <p class="lword" data-fade>
              <span class="lword__pill">{L.wordA} {w.label}</span>
            </p>
          )
        }
        {
          free ? (
            <h1 class="t-display lhero__title lhero__title--free" id="learn-title" data-split="intro">{tower ? L.towerA : crestaPage ? L.crestaA : L.freeA}{' '}<span class="mute">{crestaPage ? L.crestaB : L.freeB}</span></h1>
          ) : (
            <h1 class="t-display lhero__title" id="learn-title" data-split="intro">{L.heroA}{' '}<span class="mute">{L.heroB}</span></h1>
          )
        }
        <div class="lhero__row">
          <p class:list={['t-sub lhero__sub', { 'lhero__sub--main': !free }]} data-fade>{free ? (tower ? L.towerSub : crestaPage ? L.crestaSub : L.freeSub) : L.heroSub}</p>
          <div class="lhero__ctas" data-fade>
            {
              free ? (
                <a class="btn btn--fill" href={go(tower ? 'free-tower' : 'free')}>{tower ? L.towerCta : crestaPage ? L.crestaCta : L.freeCta} <Arrow /></a>
              ) : (
                <a class="btn btn--fill" href="#books">{L.heroBooks} <Arrow /></a>
              )
            }
            <a class="btn btn--light lhero__second" href={free ? '#books' : '#lessons'}>{free ? L.heroBooks : L.heroLesson} <Arrow /></a>
          </div>
        </div>
        <div class="cmp__rooms" role="group" aria-label={L.compareHandle} data-fade>
          {
            views.map((v, i) => (
              <button
                type="button"
                class="cmp__room"
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-room={v}
                data-white={pic(v, 'white').desk}
                data-white-m={pic(v, 'white').mobile}
                data-real={pic(v, 'real').desk}
                data-real-m={pic(v, 'real').mobile}
                data-alt={`${L.compareReal}: ${place}, ${rooms[i]}`}
              >
                {rooms[i]}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>
    )
  }

  <!-- Who it is for -->
  <!-- The shelf: three playbooks as book covers -->
  <section class="lbooks wrap" id="books" aria-labelledby={tower ? undefined : "books-title"} aria-label={tower ? L.bundleTitleA + " " + L.bundleTitleB : undefined}>
    {
      !tower && (
        <div class="lsec__head">
          <h2 class="t-h2" id="books-title" data-split>{L.booksA}{' '}<span class="mute">{L.booksB}</span></h2>
        </div>
      )
    }
    <!-- The bundle first (7/11): the three books fanned out, the real price struck -->
    <div class:list={['lbundle', { 'lbundle--first': !tower }]} data-fade>
      <a class="lfan" href={go('bundle')} aria-label={`${L.buy}: ${L.bundleTitleA} ${L.bundleTitleB}, ${eur(79)}`}>
        {
          L.books.map((b, i) => (
            <span class={`lfan__book lfan__book--${i + 1}`}>
              <BookCover real={covers[b.id].real} white={covers[b.id].white} label={`${L.playbook} ${b.n}`} a={b.a} b={b.b} c1={covers[b.id].c1} c2={covers[b.id].c2} sizes="(min-width: 900px) 18vw, 40vw" />
            </span>
          ))
        }
      </a>
      <div class="lbundle__copy">
        <p class="t-small lbundle__label">{L.best}</p>
        <p class="t-h2 lbundle__title">{L.bundleTitleA} <span class="mute">{L.bundleTitleB}</span></p>
        <p class="lbundle__price"><span class="lbundle__now">{eur(79)}</span><s class="lbundle__was">{eur(167)}</s></p>
        <p class="lbundle__save">{L.thanks.save} {eur(88)}</p>
        <p class="lbundle__text">{L.bundleText}</p>
        <a class="btn btn--fill lbundle__cta" href={go('bundle')}>{L.bundleCta} <Arrow /></a>
        {!tower && <a class="lbundle__down" href="#one">{L.oneDown}</a>}
      </div>
    </div>
    {
      !tower && (
        <>
    <!-- Then the three playbooks one by one, at full price (same sizes as before) -->
    <div class="lone" id="one">
      <h3 class="lone__title">{L.oneA} <span class="mute">{L.oneB}</span></h3>
    </div>
    <ul class="lshelf" data-hbar>
      {
        books.map((b) => (
          <li class="lbook" data-fade>
            <a class="lcover" href={go(b.id as ProductId)} aria-label={`${L.buy}: ${b.a} ${b.b}, ${b.price}`} {...buyData(b)}>
              <BookCover real={covers[b.id].real} white={covers[b.id].white} label={`${L.playbook} ${b.n}`} a={b.a} b={b.b} c1={covers[b.id].c1} c2={covers[b.id].c2} />
            </a>
            <div class="lbook__meta">
              <p class="t-small lbook__for">{b.for}</p>
              <p class="lbook__price">{b.price}</p>
            </div>
            <p class="lbook__lead">{b.lead}</p>
            <details class="lbook__more">
              <summary class="t-small">{L.inside}<span aria-hidden="true">+</span></summary>
              <ul class="lbook__items">
                {b.items.map((it) => <li>{it}</li>)}
              </ul>
            </details>
            <a class="btn lbook__buy" href={go(b.id as ProductId)} {...buyData(b)}>{L.buy} <Arrow /></a>
          </li>
        ))
      }
    </ul>
        </>
      )
    }
  </section>

  <!-- Private lessons: two pastel cards on paper, Build marked as our pick -->
  <section class="lles" id="lessons" aria-labelledby="lessons-title">
    <div class="lles__in wrap">
      <h2 class="t-h2 lles__title" id="lessons-title" data-split>{L.lessonsA}{' '}<span class="mute">{L.lessonsB}</span></h2>
      <div class="lles__grid">
        {
          L.lessons.map((l, i) => (
            <article class:list={['lles__card', { 'is-pick': i === 1 }]} data-fade>
              {i === 1 && <p class="t-small lles__pick">{T.pricing.recommended}</p>}
              <header class="lles__head">
                <h3 class="t-h3">{l.name}</h3>
                <p class="t-small lles__time">{l.time}</p>
              </header>
              <p class="lles__price">{l.price}</p>
              <ul class="lles__items">
                {l.items.map((it) => <li>{it}</li>)}
              </ul>
              <a class:list={['btn', { 'btn--fill': i === 1 }]} href={go(l.id as ProductId)}>{L.book} {l.name} <Arrow /></a>
            </article>
          ))
        }
      </div>
      <p class="t-small lles__note" data-fade>{L.lessonsNote}</p>
    </div>
  </section>

  <!-- Community -->
  <section class="lcomm wrap" aria-labelledby="comm-title">
    <div class="lcomm__copy">
      <h2 class="t-h1" id="comm-title" data-split>{L.communityA}</h2>
      <p class="lcomm__sub" data-fade>{L.communityB} <img class="lcomm__skool" src="/learn/skool-logo.svg" alt="Skool" width="2783" height="905" loading="lazy" /></p>
      <p class="t-sub lcomm__text" data-fade>{L.communityText}</p>
      <a class="btn btn--fill" href={go('community')} data-fade>{L.communityCta} <Arrow /></a>
    </div>
    <ul class="lcomm__cards" aria-hidden="true">
      {
        L.communityCards.map((c, i) => (
          <li class={`lcard lcard--${i + 1}`}>
            <img data-src={commImgs[i]} alt="" decoding="async" />
            <span>{c}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- "Are you sure?" (7/11): before paying for one playbook, the pack for the same or a little more -->
  <dialog class="buy sure" data-buy-box aria-labelledby="buy-title" data-same={L.sure.same} data-more={L.sure.more} data-one={L.sure.one}>
    <button type="button" class="buy__x sure__x" data-close aria-label={L.sure.close}></button>
    <div class="sure__in">
      <span class="lfan sure__fan" aria-hidden="true">
        {
          L.books.map((b, i) => (
            <span class={`lfan__book lfan__book--${i + 1}`}>
              <BookCover real={covers[b.id].real} white={covers[b.id].white} label={`${L.playbook} ${b.n}`} a={b.a} b={b.b} c1={covers[b.id].c1} c2={covers[b.id].c2} sizes="120px" />
            </span>
          ))
        }
      </span>
      <p class="t-small sure__k" data-name></p>
      <p class="sure__t" id="buy-title">{L.sure.title}</p>
      <p class="sure__p" data-text></p>
      <a class="btn btn--fill sure__go" data-all href={go('bundle')}>{L.sure.all} <Arrow /></a>
      <a class="btn sure__no" data-pay href="#"></a>
    </div>
  </dialog>

  <!-- Back to the service: we make it, the first image free -->
  <!-- Before you buy -->
  <section class="lfaq wrap" aria-labelledby="faq-title">
    <h2 class="t-h2 lfaq__title" id="faq-title" data-split>{L.faqA}{' '}<span class="mute">{L.faqB}</span></h2>
    <div class="lfaq__list" data-fade>
      {
        L.faq.map(([q, a], i) => (
          <details class="lfaq__item" open={i === 0}>
            <summary>
              <span class="t-sub">{q}</span>
              <span class="lfaq__plus" aria-hidden="true"></span>
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
    <a class="btn btn--fill lfaq__cta" href="#books">{L.heroBooks} <Arrow /></a>
  </section>

  {tower && <TowerOffer variant="end" />}

  <EndCta />
</Base>
