---
// F2 (1/11): the offer as the title, the address under it, four columns of links, no downloads.
import { contact, sampleLinks } from '../lib/contact';
import SampleCta from './SampleCta.astro';
import { t, langFromPath, localize } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const F = T.footer;
interface Props {
  /** 10/11: a page can give its own WhatsApp message (after a payment: help with what was bought, not the free image request) */
  wa?: string;
}
const wa = Astro.props.wa || sampleLinks(lang).whatsapp;
const year = new Date().getFullYear();
const pages = [
  ['/work', T.nav.work],
  ['/studio', T.nav.studio],
  ['/pricing', T.nav.pricing],
  ['/learn', T.nav.learn],
  ['/contact', T.nav.contact],
] as const;
---

<footer class="ftr" data-header="light">
  <div class="ftr__in" data-ftr>
    <p class="ftr__kicker"><span>{F.kickerA}</span> <span>{F.kickerB}</span></p>
    <a class="ftr__mail" href={`mailto:${contact.email}`}><span class="u">{contact.email}</span></a>

    <div class="ftr__grid">
      <div>
        <h2>{F.pages}</h2>
        <ul>{pages.map(([h, n]) => <li><a class="u" href={localize(h, lang)}>{n}</a></li>)}</ul>
      </div>
      <div>
        <h2>{F.learn}</h2>
        <ul>
          <li><a class="u" href={`${localize('/learn', lang)}#books`}>{F.playbooks}</a></li>
          <li><a class="u" href={`${localize('/learn', lang)}#lessons`}>{F.lessons}</a></li>
          <li><a class="u" href={`${localize('/learn', lang)}#comm-title`}>{F.community}</a></li>
        </ul>
      </div>
      <div>
        <h2>{F.contact}</h2>
        <ul>
          <li><a class="u" href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a class="u" href={wa} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a class="u" href={`${localize('/contact', lang)}#book`}>{F.book}</a></li>
        </ul>
      </div>
      <div>
        <h2>{F.studio}</h2>
        <ul>
          <li>{T.places}</li>
          <li><a class="u" href={contact.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a class="u" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
      <div class="ftr__cta">
        <SampleCta light />
      </div>
    </div>

    <div class="ftr__bottom">
      <span>© {year} Omnya Lab®</span>
      <span>{contact.legal} · {T.footer.vat} {contact.vat}</span>
      <span class="ftr__legal"><a class="u" href={localize('/privacy-policy', lang)}>{T.footer.privacy}</a> · <a class="u" href={localize('/terms', lang)}>{T.footer.terms}</a></span>
    </div>
  </div>
</footer>
