---
// The page after a purchase, built like a one-time-offer page: the steps on top (paid, one
// offer, your download), one offer in the middle that can't be missed (the real price struck,
// the saving, what you get, one big yes), a quiet "no thanks" that reveals a smaller offer,
// and the download at the end. Prices are real; see lib/learn.ts.
// 10/11 (Nico): no free image after a payment. A product may have no second offer: then there is
// no "no thanks" button and no second card.
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import FunnelUpgrade from '../components/FunnelUpgrade.astro';
import { goHref, thanks, booking, everythingUpgrade, type ProductId } from '../lib/learn';
import { t, langFromPath, localize } from '../i18n';

interface Props {
  id: string;
}
const lang = langFromPath(Astro.url.pathname);
const L = t(lang).learn;
const X = L.thanks;
const flow = thanks[Astro.props.id as ProductId]!;
type Offer = { a: string; b: string; price: string; was: string; text: string; cta: string };
type Extra = { strike: string; save: string; items: string[] };
const offers = X.offers as Record<string, Offer>;
const extra = X.extra as Record<string, Extra>;
const oto = offers[flow.oto];
const otoX = extra[flow.oto];
const down = flow.down ? offers[flow.down] : null;
const downX = flow.down ? extra[flow.down] : null;

// What each offer looks like: a lesson on a real project, the books, the studio's work, the community
// 10/11 (Nico): the community card says what it is. The Skool logo (the official one, as on skool.com) sits on a
// lighter, more colourful ground with "Private community", and one line under the name says it is our private
// community on Skool and that the way in is the waiting list.
const visual = (id: string) => {
  if (id === 'rest-30' || id === 'rest-50' || id === 'rest-02' || id === 'rest-03') return { kind: 'books' as const };
  if (id === 'session-reader') return { kind: 'pic' as const, src: '/learn/dev_rooftop.webp', badge: L.lessons[0].time };
  if (id === 'build-upgrade') return { kind: 'pic' as const, src: '/learn/burt_night_real_mobile.webp', badge: L.lessons[1].time };
  return { kind: 'skool' as const };
};
const v = visual(flow.oto);
// Step 2 (10/11, ready but off): after a Full guide, "Everything we teach" for the difference (€53). The card is in
// the page only when lib/learn.ts has the Stripe link (everythingUpgrade), it starts hidden, and the script shows it
// only after api/files.js has confirmed the payment of a Full guide (never for who already has the pack).
// It is drawn as the next step of the funnel the buyer came from, in that funnel's colour (components/FunnelUpgrade.astro).
const up = !!everythingUpgrade && Astro.props.id.startsWith('full-');
const vd = flow.down ? visual(flow.down) : null;
const bookIds = ['white-to-real', 'reel', 'before-it-exists'];
const book = booking[Astro.props.id as ProductId];
// 10/11: no PDF link is written in this page. The script asks api/files.js, which checks the payment with Stripe
// (?session_id= from the checkout) and only then gives the buttons; in every other case the kind line below.
// 10/11: when that payment also holds The Towers Scene File (the zip added in the cart of the Full Towers Blueprint),
// its download comes next to the PDF and the hidden line under the buttons says what it is; otherwise nothing changes.
// 10/11 (Nico): on this page the round WhatsApp button and the WhatsApp link in the footer no longer open
// "I'd like to request a free sample": who is here has just paid, so the message is a plain help one, with what they bought.
const fulls: Record<string, string> = { 'full-tower': 'Full Tower Blueprint', 'full-3d': 'Full 3D Blueprint', 'full-city': 'Full City Blueprint', 'full-build': 'Full Build Blueprint', 'full-towers': 'Full Towers Blueprint' };
const bought = (() => {
  const id = Astro.props.id;
  const it = lang === 'it';
  const b = L.books.find((x) => x.id === id);
  if (b) return `${it ? 'il playbook' : 'the playbook'} ${b.a} ${b.b}`;
  const l = L.lessons.find((x) => x.id === id);
  if (l) return `${it ? 'la lezione' : 'the'} ${l.name}${it ? '' : ' lesson'}`;
  if (id === 'bundle') return it ? 'i tre playbook' : 'the three playbooks';
  if (id === 'everything') return 'Everything we teach';
  return `${it ? 'il' : 'the'} ${fulls[id] || 'PDF'}`;
})();
const ask = 'https://wa.me/393792220465?text=' + encodeURIComponent(lang === 'it' ? `Ciao Nico, ho appena comprato ${bought} e ho una domanda: ` : `Hi Nico, I just bought ${bought} and I have a question: `);
const help = 'https://wa.me/393792220465?text=' + encodeURIComponent(lang === 'it' ? 'Ciao Nico, ho pagato ma non trovo i miei PDF. La mail che ho usato è: ' : 'Hi Nico, I paid but I can’t find my PDFs. The email I used is: ');
---

<Base page="thanks" title={X.title} noindex wa={ask}>
  {
    lang === 'en' && (
      <script is:inline>
        try { if (localStorage.getItem('omnya-lang') === 'it') location.replace('/it' + location.pathname + location.search); } catch (e) {}
      </script>
    )
  }
  <section class="oto wrap">
    <ol class="oto__steps" aria-label={X.title}>
      {X.steps.map((s, i) => <li class:list={{ 'is-done': i === 0, 'is-now': i === 1 }}><span>{i === 0 ? '✓' : i + 1}</span>{s}</li>)}
    </ol>

    <header class="oto__head">
      <p class="oto__done" data-fade>{X.headA}</p>
      <h1 class="t-h2 oto__title" data-split="intro">{X.only} <span class="mute">{X.headB}</span></h1>
      <span class="oto__down" aria-hidden="true">↓</span>
    </header>

    {up && <FunnelUpgrade id={Astro.props.id} lang={lang} />}

    <article class:list={['oto__card', { 'oto__card--skool': v.kind === 'skool' }]} data-fade>
      <div class="oto__visual">
        {
          v.kind === 'books' ? (
            <div class="oto__books">
              {bookIds.map((b, i) => <img class={`oto__book oto__book--${i + 1}`} src={`/studio/book_${b}_${lang}_mobile.webp`} alt="" width="540" height="720" />)}
            </div>
          ) : v.kind === 'pic' ? (
            <figure class="oto__pic">
              <img src={v.src} alt="" />
              <span class="oto__badge">{v.badge}</span>
            </figure>
          ) : (
            <div class="oto__skool"><img src="/learn/skool-logo.svg" alt="Skool" width="2783" height="905" /><span class="oto__skool-tag">{X.skoolTag}</span></div>
          )
        }
      </div>
      <div class="oto__body">
        <h2 class="t-h2 oto__name">{oto.a} <span class="mute">{oto.b}</span></h2>
        {v.kind === 'skool' && <p class="oto__what">{X.skoolLine}</p>}
        <p class="oto__price">
          <span class="oto__now">{oto.price}</span>
          {otoX.strike && <s class="oto__was">{otoX.strike}</s>}
        </p>
        <ul class="oto__items">{otoX.items.map((it) => <li>{it}</li>)}</ul>
        <a class="btn btn--fill oto__yes" href={goHref(flow.oto, lang)}>{oto.cta} <Arrow /></a>
        {down && <button type="button" class="oto__no" data-oto-no>{X.no}</button>}
      </div>
    </article>
  </section>

  {
    down && downX && vd && (
  <section class="oto-down wrap" id="down" data-oto-down aria-labelledby="down-title">
    <article class:list={['oto__card', 'oto__card--small', { 'oto__card--skool': vd.kind === 'skool' }]}>
      <div class="oto__visual">
        {
          vd.kind === 'books' ? (
            <div class="oto__books">
              {bookIds.map((b, i) => <img class={`oto__book oto__book--${i + 1}`} src={`/studio/book_${b}_${lang}_mobile.webp`} alt="" width="540" height="720" loading="lazy" />)}
            </div>
          ) : vd.kind === 'pic' ? (
            <figure class="oto__pic">
              <img src={vd.src} alt="" loading="lazy" />
              <span class="oto__badge">{vd.badge}</span>
            </figure>
          ) : (
            <div class="oto__skool"><img src="/learn/skool-logo.svg" alt="Skool" width="2783" height="905" loading="lazy" /><span class="oto__skool-tag">{X.skoolTag}</span></div>
          )
        }
      </div>
      <div class="oto__body">
        <p class="t-small oto__or">{X.or}</p>
        <h2 class="t-h3 oto__name" id="down-title">{down.a} <span class="mute">{down.b}</span></h2>
        {vd.kind === 'skool' && <p class="oto__what">{X.skoolLine}</p>}
        <p class="oto__price oto__price--small">
          <span class="oto__now">{down.price}</span>
          {downX.strike && <s class="oto__was">{downX.strike}</s>}
        </p>
        <ul class="oto__items">{downX.items.map((it) => <li>{it}</li>)}</ul>
        <a class="btn oto__yes" href={goHref(flow.down!, lang)}>{down.cta} <Arrow /></a>
      </div>
    </article>
  </section>
    )
  }

  <!-- What they paid for: the PDFs to download (only after the server has checked the payment), or the link to pick the time of the lesson -->
  <section class="oto-dl wrap" id="download" data-dl={flow.kind === 'pdf' ? lang : undefined}>
    {
      flow.kind === 'pdf' ? (
        <>
          <p class="t-sub" data-dl-text data-ok={X.paidPdf} data-ok-scene={X.paidScene} data-only-scene={X.paidSceneOnly} data-closed={X.closed}>{X.checking}</p>
          <div class="oto-dl__btns" data-dl-btns>
            <template data-dl-file><a class="btn btn--fill" download><span></span> <Arrow /></a></template>
            <template data-dl-help>
              <a class="btn btn--fill" href={help} target="_blank" rel="noopener">WhatsApp <Arrow /></a>
              <a class="btn" href="mailto:info@omnyalab.com">info@omnyalab.com</a>
            </template>
          </div>
          <p class="oto-dl__note" data-dl-note hidden>{X.sceneNote}</p>
          <p class="oto-dl__note">{X.fixA} <a class="u" href="mailto:info@omnyalab.com">{X.fixB}</a> {X.fixC} <a class="u" href={localize('/terms', lang)}>{X.terms}</a></p>
        </>
      ) : (
        <>
          <p class="t-sub">{X.paidLesson}</p>
          <div class="oto-dl__btns">{book && <a class="btn btn--fill" href={localize(book, lang)}>{X.pick} <Arrow /></a>}</div>
        </>
      )
    }
  </section>
</Base>

<style is:global>
  /* 10/11 (Nico): no free image after a payment. On this page the site's own "Get a free image" buttons
     (header, menu and footer, all [data-sample]) stay hidden too; everywhere else they are as before. */
  html:has(main .oto) [data-sample] { display: none !important; }
</style>
