---
// /city/@username (vercel.json rewrites every /city/<name> here; the script reads the name from the address).
// "View my home": the house in 3D on its lot, turning with a finger; number, district, neighbour, share.
// 7/11/2026 (board approved by Nico, cozy yellow, no blue): the page fades in once the house is found;
// MOVE UP (sticker, button, "Get a top spot" cards) opens the place picker (penthouse, top villa, fountain, €0.99 on Stripe);
// the cozy book on the city and the card next to the house sell the Full City Guide (€1.99 until Sunday) or Everything (€39).
import CityHead from '../../components/CityHead.astro';
import { cityUpgrades, cityWhatsApp } from '../../lib/city';
import { fullCityDeal } from '../../lib/learn';

const up: Record<string, any> = Object.fromEntries(cityUpgrades.map((o) => [o.id, o]));
// 7/11 (Nico): townhouses on the water €0.99 (tranches 6/6/8) and seafront villas €2.99 (2 at a time), our own Stripe Checkout;
// the yacht and the island (one of each, auction) only say "View" and open their page.
Object.assign(up, {
  // Payment Links (7/11, from Nico's Stripe, like the others): limit 20 and 10, product names matched by api/stripe-webhook.js
  town: { title: 'A townhouse on the water', price: '€0.99', was: '€19', checkout: 'https://buy.stripe.com/7sY00iacRh2M3hAaix8so0x' },
  sea: { title: 'A seafront villa', price: '€2.99', was: '€29', checkout: 'https://buy.stripe.com/cNi7sKgBfeUE9FY2Q58so0y' },
  yacht: { title: 'The Yacht', view: '/city/yacht' },
  island: { title: 'The Island', view: '/city/island' },
});
const book = `<span class="bk4" aria-hidden="true"><span class="b"><span class="k"></span><span class="p"></span><span class="tp"></span><span class="s"><i>OMNYA CITY</i></span><span class="f"></span></span></span>`;
const places = [
  { id: 'town', img: '/city/up/town.jpg', name: 'On the water', pick: 'A townhouse on the water', line: 'The Residences, garden on the beach', card: 'A townhouse on the beach of The Residences, the sea in front.' },
  { id: 'sea', img: '/city/up/sea.jpg', name: 'Seafront villa', pick: 'A seafront villa', line: 'Pool on the beach, by the marina', card: 'A villa on the beach by the marina, the pool facing the sea.' },
  { id: 'yacht', img: '/city/up/yacht.jpg', name: 'Yacht of ???', pick: 'Yacht of ???', line: 'Only one in the city · auction', card: 'The only yacht in the city. Its name will be yours.', gold: true },
  { id: 'island', img: '/city/up/island.jpg', name: 'Island of ???', pick: 'Island of ???', line: 'Only one in the city · auction', card: 'A villa alone on its own island. Only one.', gold: true },
  { id: 'penthouse', img: '/city/up/penthouse.jpg', name: 'The penthouse', line: 'Top floor of a tower in The Residences', card: 'Top floor of a tower in The Residences, the whole city below.' },
  { id: 'villa', img: '/city/up/villa.jpg', name: 'A top villa', pick: 'A top villa in Omnyawood', line: 'Pool and view, under the letters', card: 'Omnyawood, the top terrace under the letters, with the pool.' },
  { id: 'fountain', img: '/city/up/fountain.jpg', name: 'By the fountain', pick: 'A house by the fountain', line: 'Downtown, one of the first 8 houses', card: 'Downtown, one of the first 8 houses of the city.' },
];
const pickBook = `<div class="pick" data-g="book">
  <label class="on" data-go="/go/full-city?k=city" data-p="1.99"><i></i><div>The Full City Guide<span>every prompt to build a 3D city like this</span></div><strong data-full>€1.99<s>€19</s></strong></label>
  <label data-go="/go/everything?k=city" data-p="39"><i></i><div>Everything we teach<span>3 Full Guides + 3 playbooks</span><em class="tag">Only here</em></div><strong>€39<s>€164</s></strong></label>
</div>`;
---

<!doctype html>
<html lang="en">
  <head>
    <CityHead title="My house in Omnya City" description="Every follower gets a free house in our 3D city. This one is mine." path="/city" noindex />
  </head>
  <body class="wait">
    <div class="house">
      <div class="stage">
        <canvas id="c" aria-label="The house in 3D"></canvas>
        <header class="top">
          <a href="/city" style="pointer-events:auto">← The city</a>
        </header>
        <button class="gb" type="button" data-open="book" aria-label="The Full City Guide" set:html={book} />
        <span class="hint" id="hint">Drag to turn it</span>
      </div>

      <div class="duo">
      <article class="card" id="card">
        <div class="loading" id="loading"><i></i>Finding the house…</div>
        <div id="found" hidden>
          <button class="mv" type="button" data-open="move" data-up>MOVE UP ↑</button>
          <p class="k" style="margin:0 0 4px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--roof)">Omnya City</p>
          <h1 class="lil" id="name"></h1>
          <div class="facts">
            <div><small>House</small><b id="num"></b></div>
            <div><small>District</small><b id="dist"></b></div>
            <div><small>Neighbour</small><b id="nb"></b></div>
          </div>
          <div class="row">
            <button class="btn" id="share" type="button">Share my house</button>
            <button class="btn up" type="button" data-open="move" data-up>Move up<span class="lg">&nbsp;my house</span>&nbsp;↑</button>
          </div>
        </div>
        <div id="none" class="empty" hidden>
          <h1 class="lil" id="none-name" style="font-size:34px"></h1>
          <p class="s" style="color:var(--mute)">No house here yet. Comment <b>HOUSE</b> under our reel on <a href="https://www.instagram.com/omnyalab/">@omnyalab</a> and we'll DM you the link to reserve one.</p>
          <a class="btn" href="/city" style="margin-top:14px">See the city</a>
        </div>
      </article>
      <article class="card ux buy">
        <span class="stamp">FULL GUIDE</span>
        <div class="buy__in">
          <button class="buy__bk" type="button" data-open="book" aria-label="The Full City Guide" set:html={book} />
          <div class="buy__tx">
            <p class="kick" data-kick>2,000 followers offer · until Sunday</p>
            <h2>Build a city like this</h2>
            <p class="sub">Every prompt we gave Claude to build Omnya City.</p>
          </div>
        </div>
        <Fragment set:html={pickBook} />
        <a class="btn bookgo" href="/go/full-city?k=city">Get it · €1.99</a>
      </article>
      </div>

      <section class="ux sec" id="up" hidden>
        <button class="stamp" type="button" data-open="move">MOVE UP ↑</button>
        <h2>Get a top spot</h2>
        <p class="sub">Your free house is <b data-where></b>. From €0.99 it moves to one of the best places in the city, and stays yours.</p>
        <div class="three">
          {places.map((p, i) => (
            <button class={`pl${i === 0 ? ' hot' : ''}${p.gold ? ' gold' : ''}`} type="button" data-open={up[p.id].view ? undefined : 'move'} data-pick={p.id} data-place={p.id} data-view={up[p.id].view}>
              <img class="im" src={p.img} alt="" loading="lazy" width="800" height="622" />
              <div class="bd">
                <span class="cnt" data-left={p.id}></span>
                <div class="bar"><i data-bar={p.id}></i></div>
                <b>{p.name}</b>
                <p>{p.card}</p>
                {up[p.id].view
                  ? <div class="pr"><span><strong>???</strong></span><em>View</em></div>
                  : <div class="pr"><span><strong>{up[p.id].price}</strong><s>{up[p.id].was}</s></span><em>Move here</em></div>}
              </div>
            </button>
          ))}
        </div>
      </section>

      <footer class="foot">
        <a href="/city">See the whole city →</a>
      </footer>
    </div>

    <div class="ux dim" id="move" hidden>
      <button class="x" type="button" data-close aria-label="Close">×</button>
      <div class="card" role="dialog" aria-modal="true" aria-label="Get a top spot">
        <span class="stamp">MOVE UP ↑</span>
        <div class="shot" id="shot" style="background-image:url(/city/up/penthouse.jpg)"><span class="left" id="shotname">The penthouse</span></div>
        <p class="kick" data-where-kick></p>
        <h2>Get a top spot</h2>
        <p class="sub">Your house can move to one of the <b>best places in the city</b>. Same name, new address.</p>
        <div class="pick" data-g="move">
          {places.map((p, i) => (
            <label class={`${i === 0 ? 'on' : ''}${p.gold ? ' gold' : ''}`} data-place={p.id} data-img={p.img} data-name={p.name} data-href={up[p.id].view || up[p.id].buy || up[p.id].checkout || cityWhatsApp} data-stripe={up[p.id].checkout ? '1' : ''} data-buy={up[p.id].buy ? '1' : ''} data-btn={up[p.id].view ? 'View it' : `Move my house · ${up[p.id].price}`} data-title={up[p.id].title}>
              <i></i><div>{p.pick || p.name}<span>{p.line}<span data-left-line={p.id}></span></span>{(i === 0 || p.id === 'sea') && <em class="tag" data-left-tag={p.id}></em>}</div>{up[p.id].view ? <strong class="view">View</strong> : <strong>{up[p.id].price}<s>{up[p.id].was}</s></strong>}
            </label>
          ))}
        </div>
        <a class="btn" id="movego" href={up.town.checkout} target="_blank" rel="noopener">Move my house · €0.99</a>
        <button class="no" type="button" data-close>No thanks, I'll keep my free house</button>
      </div>
    </div>

    <div class="ux dim" id="book" hidden>
      <button class="x" type="button" data-close aria-label="Close">×</button>
      <div class="card" role="dialog" aria-modal="true" aria-label="Build a city like this">
        <span class="stamp">FULL GUIDE</span>
        <Fragment set:html={book} />
        <p class="kick" data-kick>2,000 followers offer · until Sunday</p>
        <h2>Build a city like this</h2>
        <p class="sub">Every prompt we gave Claude to build Omnya City: the houses, the map and the links in the DMs.</p>
        <Fragment set:html={pickBook} />
        <a class="btn bookgo" href="/go/full-city?k=city">Get it · €1.99</a>
        <button class="no" type="button" data-close>No thanks</button>
      </div>
    </div>
    <script is:inline define:vars={{ dealUntil: fullCityDeal.until }}>window.__cityDeal = dealUntil;</script>
    <script type="module" src="/city/house.js"></script>
  </body>
</html>
