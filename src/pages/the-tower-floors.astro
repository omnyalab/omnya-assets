---
// /the-tower-floors (6/11): the funnel for the tower floors reel (DfaH3QkN4qs, word AI): the floor plan,
// the floor in 3D and the rooms. A copy of /the-tower-blueprint (same style, same free and Full PDFs,
// same fullTowerDeal), with the copy about the floors: the levels on the tower, the plan of one level,
// its 3D, room by room, and the buyer picking floor and apartment (Full Blueprint chapters 05-07).
// English only, no site header. Short link: /floors.
import Base from '../layouts/Base.astro';
import { goHref, fullTowerDeal } from '../lib/learn';

const free = goHref('free-tower', 'en');
const full = goHref('full-tower', 'en');
const sample = goHref('sample', 'en');
const bundle = goHref('bundle', 'en');
import OptIn from '../components/OptIn.astro';
---

<Base page="learn" header={false} title="How to sell every floor of a tower with AI" description="Steal our floor method: from the tower to the plan of one level, its 3D and every room, free in five steps, and the Full Tower Blueprint with every prompt.">
<div class="x3">
<OptIn slug="the-tower-floors" free="free-tower" word="Floor" cover="/learn/tw_cover_free.webp" hero="/learn/tw_hero.webp" heroMobile="/learn/tw_hero_mobile.webp" />
<section class="x3-hero" id="top">
  <picture class="x3-hero__bg"><source media="(max-width:899px)" srcset="/learn/tw_hero_mobile.webp"><img src="/learn/tw_hero.webp" width="2400" height="1339" fetchpriority="high" alt="SAMAR, the tower at sunset over the marina"></picture>
  <div class="x3-in">
    <div>
      <p class="x3-kick">Free blueprint</p>
      <h1 class="x3-T">Steal our<br><span class="x3-box">floor</span><br>method</h1>
      <p class="x3-lead"><b>From the tower to the plan of one level, its 3D and every room inside, in five steps.</b> Free.</p>
      <div class="x3-ctas"><a class="x3-btn x3-btn--blue" href={free} target="_blank" rel="noopener">Download the free blueprint →</a><a class="x3-btn x3-btn--line" href="#full">Get the Full one</a></div>
    </div>
    <img class="x3-hero__cover" src="/learn/tw_cover_free.webp" width="700" height="1244" alt="The free blueprint cover">
  </div>
</section>

<section class="x3-mhero" aria-label="Free blueprint">
  <div class="x3-mhero__strap">Free blueprint</div>
  <div class="x3-mhero__ph">
    <p class="x3-mhero__how">Steal our</p>
    <p class="x3-T" aria-hidden="true"><span class="x3-box">floor</span><br>method</p>
    <img class="x3-mhero__book" src="/learn/tw_book.webp" width="526" height="731" alt="The Full Tower Blueprint">
  </div>
  <div class="x3-in">
    <p class="x3-mhero__pb">5 steps, free</p>
    <p class="x3-mhero__for">From the floor plan to every room</p>
    <div class="x3-ctas"><a class="x3-btn x3-btn--blue" href={free} target="_blank" rel="noopener">Download the free blueprint →</a><a class="x3-btn x3-btn--line" href="#full">Get the Full one</a></div>
  </div>
</section>
<section class="x3-deal" id="full">
  <div class="x3-deal__glow" aria-hidden="true"></div>
  <div class="x3-in">
    <div class="x3-card">
      <span class="x3-card__tab" data-deal>1,000 followers offer · 90% off</span>
      <div class="x3-card__book"><div class="x3-card__halo" aria-hidden="true"></div><img src="/learn/tw_book.webp" width="526" height="731" alt="The Full Tower Blueprint, the book"></div>
      <div class="x3-card__body">
        <p class="x3-kick">Everything you get</p>
        <h2 class="x3-T">How to sell<br>every<br><span class="x3-box">floor</span><br>with AI</h2>
        <ul class="x3-vs">
          <li><i></i><div><b>The Full Tower Blueprint</b><span>thirteen chapters, from the tower photo to the site you send buyers</span></div><em>Included</em></li>
          <li><i></i><div><b>Tracing the floors</b><span>every level becomes a shape on the video that lights up and opens</span></div><em>Included</em></li>
          <li><i></i><div><b>The apartment on the floor</b><span>the plan of each level, units to click, sold ones in grey</span></div><em>Included</em></li>
          <li><i></i><div><b>Every prompt, word for word</b><span>for the tower, the flight into the floor and the rooms</span></div><em>Included</em></li>
          <li><i></i><div><b>The fast way</b><span>a prompt that hands the whole PDF to Claude Code</span></div><em>Included</em></li>
        </ul>
        <div class="x3-pay">
          <div class="x3-pay__price" data-deal><small>Today</small><b>€1.99</b><s>€19</s><span>−90%</span></div><div class="x3-pay__price" data-after hidden><b>€19</b></div>
          <a class="x3-cta" href={full}><span>Get the Full Blueprint</span><i>→</i></a>
        </div>
        <p class="x3-pay__note"><span data-deal>Until Sunday 8 November at midnight, then it goes back to €19. </span>The PDF arrives right after payment.</p>
      </div>
    </div>
  </div>
</section>

<section class="pk" id="pack">
  <div class="pk__glow" aria-hidden="true"></div>
  <div class="x3-in">
    <div class="x3-card">
      <span class="x3-card__tab">The whole studio · save €88</span>
      <div class="arc">
        <div class="arc__fan"><div class="arc__halo" aria-hidden="true"></div>
          <img class="arc__b arc__b--1" src="/learn/pk_pb01.webp" width="640" height="905" loading="lazy" alt="Playbook 01, From 3D to real photo">
          <img class="arc__b arc__b--3" src="/learn/pk_pb03.webp" width="640" height="905" loading="lazy" alt="Playbook 03, Sell it before it exists">
          <img class="arc__b arc__b--2" src="/learn/pk_pb02.webp" width="640" height="905" loading="lazy" alt="Playbook 02, The reel they comment on"></div>
        <div class="arc__x"><div><img src="/learn/pk_prompts.webp" width="640" height="905" loading="lazy" alt="The full prompt files"><img src="/learn/pk_checklist.webp" width="640" height="905" loading="lazy" alt="The checklist before every delivery"></div><span>+2 only in the pack</span></div>
      </div>
      <div class="x3-card__body">
        <p class="x3-kick">Got the tower? Take the rest</p>
        <h2 class="x3-T">The whole<br><span class="x3-box">studio</span><br>method</h2>
        <ul class="x3-vs">
          <li><i></i><div><b>01 · From 3D to real photo</b><span>the grey model becomes the image the client approves</span></div><em class="pr">€79</em></li>
          <li><i></i><div><b>02 · The reel they comment on</b><span>our most watched format, with the real cost of every clip</span></div><em class="pr">€49</em></li>
          <li><i></i><div><b>03 · Sell it before it exists</b><span>the 8 images and the film an off-plan launch needs</span></div><em class="pr">€39</em></li>
          <li class="xtra"><i></i><div><b>The prompt files + the checklist</b><span>every prompt we use, and what we check before any delivery</span></div><em class="only">Only here</em></li>
        </ul>
        <div class="x3-pay">
          <div class="x3-pay__price"><small>All three</small><b>€79</b><s>€167</s><span>−53%</span></div>
          <a class="x3-cta" href={bundle}><span>Get the pack</span><i>→</i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="x3-sec">
  <div class="x3-in">
    <p class="x3-kick">Plan, 3D, room</p>
    <h2 class="x3-T">One level,<br><span class="x3-box">every room</span></h2>
    <p class="x3-lead">The plan fixes where every wall and window goes, the 3D of the whole level turns it into space, and every room photo starts from that space, so the living room, the bedroom and the bathroom all belong to the same floor.</p>
    <div class="x3-pairs">
      <figure class="x3-pair"><div class="x3-pair__ab"><img src="/learn/tw_plan_L10.webp" alt="" loading="lazy"><img src="/learn/tw_model_L10.webp" alt="" loading="lazy"><span class="x3-tag x3-tag--a">Plan</span><span class="x3-tag x3-tag--b">3D</span></div><figcaption>The level in 3D · Claude</figcaption></figure>
      <figure class="x3-pair"><div class="x3-pair__ab"><img src="/learn/tw_model_L10.webp" alt="" loading="lazy"><img src="/learn/tw_living_in.webp" alt="" loading="lazy"><span class="x3-tag x3-tag--a">3D</span><span class="x3-tag x3-tag--b">Room</span></div><figcaption>The living room · Higgsfield</figcaption></figure>
      <figure class="x3-pair"><div class="x3-pair__ab"><img src="/learn/tw_living_in.webp" alt="" loading="lazy"><img src="/learn/tw_bath.webp" alt="" loading="lazy"><span class="x3-tag x3-tag--a">Start</span><span class="x3-tag x3-tag--b">End</span></div><figcaption>To the bathroom · Kling</figcaption></figure>
    </div>
  </div>
</section>

<section class="x3-sec" id="free">
  <div class="x3-in x3-free">
    <div>
      <p class="x3-kick">The free blueprint</p>
      <h2 class="x3-T">From the tower<br><span class="x3-box">to the floor</span></h2>
      <ol class="x3-steps">
        <li class="x3-step"><img src="/learn/tw_site.webp" alt="" loading="lazy"><div><b><i>01</i>Every level on the tower</b><span>Each floor becomes a shape on the tower video: move over it and it lights up with its number, size and view.</span></div></li>
        <li class="x3-step"><img src="/learn/tw_plan_L10.webp" alt="" loading="lazy"><div><b><i>02</i>The plan of one level</b><span>The architect's plan, cleaned into a flat drawing: every unit on that floor, every wall and every window.</span></div></li>
        <li class="x3-step"><img src="/learn/tw_model_L10.webp" alt="" loading="lazy"><div><b><i>03</i>The level in 3D</b><span>The same plan as a 3D of the whole floor, so every room has its real size and its windows before any image.</span></div></li>
        <li class="x3-step"><img src="/learn/tw_living_in.webp" alt="" loading="lazy"><div><b><i>04</i>Room by room</b><span>On Kling, every clip starts on the exact last frame of the one before, from the terrace to the bathroom.</span></div></li>
        <li class="x3-step"><img src="/learn/tw_terrace_living.webp" alt="" loading="lazy"><div><b><i>05</i>They pick and fly in</b><span>The buyer chooses the floor, then the apartment, and the camera flies in through the glass.</span></div></li>
      </ol>
      <div class="x3-ctas"><a class="x3-btn x3-btn--white" href={free} target="_blank" rel="noopener">Download the free blueprint →</a></div>
    </div>
    <img class="x3-free__cover" src="/learn/tw_cover_free.webp" width="700" height="1244" alt="The free blueprint cover">
  </div>
</section>

<section class="x3-sec">
  <div class="x3-in x3-two">
    <div>
      <p class="x3-kick">It's for you if</p>
      <h2 class="x3-T">Your floors are still<br><span class="x3-box">a plan</span></h2>
      <ul class="x3-ticks">
        <li>You sell apartments in a tower that isn't built yet.</li>
        <li>You want buyers to choose their floor and walk through the rooms, without a 3D studio.</li>
        <li>You already use Claude or Higgsfield and want the whole method in one place.</li>
      </ul>
    </div>
    <div>
      <p class="x3-kick">Questions</p>
      <h2 class="x3-T">Before<br><span class="x3-box">you start</span></h2>
      <div class="x3-faq">
        <details><summary>Do I need SketchUp or 3ds Max?</summary><p>No. You start from the floor plans you already have, and Claude writes the site with you.</p></details>
        <details><summary>What if a floor has more than one apartment?</summary><p>The buyer picks the unit on the plan of that level before flying in. Reserved and sold units stay grey, and the Full Blueprint shows how.</p></details>
        <details><summary>Do I need a video for every apartment?</summary><p>No. One showcase apartment per unit type is enough: every floor uses the same flight and the panel changes.</p></details>
        <details><summary>When do I get it?</summary><p>Right after payment, on the next page.</p></details>
        <details><summary>Can you make it for my project?</summary><p>Yes. Send us the plans or a model, and the first image is free.</p></details>
      </div>
    </div>
  </div>
</section>

<section class="x3-sec x3-end">
  <div class="x3-in">
    <p class="x3-kick">Still a plan on your screen?</p>
    <h2 class="x3-T">Sell<br><span class="x3-box">every floor</span></h2>
    <div class="x3-ctas"><a class="x3-btn x3-btn--blue" href={full}>Get the Full Blueprint<span data-deal> · €1.99</span> →</a><a class="x3-btn x3-btn--line" href={free} target="_blank" rel="noopener">Start with the free one</a></div>
    <p class="x3-small">Or send us your plans, <a href={sample}>the first image is free</a>.</p>
  </div>
</section>
<p class="x3-foot">OMNYA LAB</p>
</div>
<script is:inline define:vars={{ until: fullTowerDeal.until }}>
  // After Sunday the €19 version shows by itself
  if (Date.now() >= Date.parse(until)) {
    document.querySelectorAll('.x3 [data-deal]').forEach((el) => (el.hidden = true));
    document.querySelectorAll('.x3 [data-after]').forEach((el) => (el.hidden = false));
  }
</script>
</Base>

<style is:global>
@font-face{font-family:Montserrat;src:url(/fonts/montserrat-latin.woff2) format("woff2");font-weight:500 900;font-display:swap}
.x3{--bg:#05070a;--bg2:#0d1117;--ink:#fff;--mute:rgba(255,255,255,.66);--line:rgba(255,255,255,.14);--blue:#2997ff;--blue2:#0071e3;background:var(--bg);color:var(--ink);font-family:Montserrat,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;overflow:hidden;overflow:clip}
:where(.x3) *{box-sizing:border-box}
:where(.x3) img,:where(.x3) video{display:block;max-width:100%;height:auto}
:where(.x3) a{color:inherit}
.x3-in{max-width:1180px;margin:0 auto;padding:0 max(16px,4vw)}

/* strap */
.x3-strap{position:relative;z-index:20;display:block;text-decoration:none;background:var(--blue);color:#fff;text-align:center;font-weight:800;font-size:13px;letter-spacing:.18em;text-transform:uppercase;padding:13px 16px}
.x3-strap a{text-decoration:none}

/* big titles, the cover language */
.x3-T{margin:0;font-weight:900;text-transform:uppercase;line-height:.92;letter-spacing:-.01em;text-wrap:balance}
.x3-T .x3-box{display:inline-block;white-space:nowrap;font-size:.72em;margin-top:.16em;border:.075em solid #fff;padding:.1em .32em .04em;font-weight:700;letter-spacing:.14em;text-indent:.14em;line-height:1}
.x3-T .b{color:var(--blue)}
.x3-kick{margin:0 0 14px;font-weight:800;font-size:clamp(14px,1.3vw,17px);letter-spacing:.2em;text-transform:uppercase;color:var(--blue)}
.x3-lead{margin:22px 0 0;font-weight:500;font-size:clamp(17px,1.5vw,20px);line-height:1.5;color:var(--mute);max-width:620px}
.x3-lead b{color:#fff;font-weight:700}

/* buttons */
.x3-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.x3-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:58px;padding:0 28px;border-radius:999px;font-weight:800;font-size:16px;letter-spacing:.06em;text-transform:uppercase;text-decoration:none}
.x3-btn--blue{background:var(--blue);color:#fff;box-shadow:0 18px 40px -18px rgba(41,151,255,.9)}
.x3-btn--white{background:#fff;color:#05070a}
.x3-btn--line{border:2px solid rgba(255,255,255,.5);color:#fff}
.x3-small{margin:14px 0 0;font-weight:600;font-size:14px;color:var(--mute)}
.x3-small a{color:#fff}

/* hero */
.x3-hero{position:relative;min-height:min(92vh,900px);display:flex;align-items:flex-end;overflow:hidden}
.x3-hero__bg,.x3-hero__bg img{position:absolute;inset:0;width:100%;height:100%}
.x3-hero__bg img{object-fit:cover;object-position:55% 50%}
.x3-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,7,10,.82) 0%,rgba(5,7,10,.45) 45%,rgba(5,7,10,0) 70%),linear-gradient(180deg,rgba(5,7,10,.6) 0%,rgba(5,7,10,0) 30%,rgba(5,7,10,0) 60%,rgba(5,7,10,.9) 88%,var(--bg) 100%)}
@media (max-width:899px){.x3-hero::after{background:linear-gradient(180deg,rgba(5,7,10,.55) 0%,rgba(5,7,10,.1) 25%,rgba(5,7,10,.35) 45%,rgba(5,7,10,.92) 75%,var(--bg) 100%)}}
.x3-hero .x3-in{position:relative;z-index:2;width:100%;padding-top:120px;padding-bottom:64px;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end}
.x3-hero .x3-kick{display:inline-block;background:var(--blue);color:#fff;padding:8px 14px;border-radius:999px;margin-bottom:20px}
.x3-hero .x3-T{font-size:clamp(58px,7.2vw,112px)}
.x3-hero__cover{width:230px;transform:rotate(3deg);border-radius:6px;box-shadow:0 40px 80px -20px rgba(0,0,0,.9),0 0 0 1px rgba(255,255,255,.08)}
.labels{position:absolute;z-index:2;top:22%;left:0;right:0;display:flex;justify-content:space-between;padding:0 max(16px,4vw);pointer-events:none}
.labels span{background:rgba(5,7,10,.6);backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:999px;padding:8px 16px;font-weight:700;font-size:13px;letter-spacing:.14em;text-transform:uppercase}

/* sections */
.x3-sec{padding:clamp(72px,10vw,130px) 0;border-top:1px solid var(--line)}
.x3-sec .x3-T{font-size:clamp(40px,5.4vw,78px)}
.sec--blue{background:var(--blue2)}
.sec--blue .x3-kick{color:#fff;opacity:.8}

/* pairs */
.x3-pairs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:48px}
.x3-pair{margin:0}
.x3-pair__ab{position:relative;aspect-ratio:4/5;border-radius:18px;overflow:hidden;background:#111}
.x3-pair__ab img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.x3-pair__ab img+img{clip-path:inset(0 0 0 50%)}
.x3-pair__ab::after{content:"";position:absolute;top:0;bottom:0;left:50%;width:3px;margin-left:-1.5px;background:#fff}
.x3-tag{position:absolute;z-index:2;bottom:14px;background:rgba(5,7,10,.65);backdrop-filter:blur(8px);border-radius:999px;padding:6px 12px;font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase}
.x3-tag--a{left:14px}.x3-tag--b{right:14px}
.x3-pair figcaption{margin-top:12px;font-weight:700;font-size:15px;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}

/* free block */
.x3-free{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:clamp(32px,6vw,90px);align-items:center}
.x3-free__cover{width:100%;max-width:360px;border-radius:8px;box-shadow:0 50px 90px -30px rgba(0,0,0,.95),0 0 0 1px rgba(255,255,255,.08);transform:rotate(-2deg)}
.x3-steps{list-style:none;margin:40px 0 0;padding:0;display:grid;gap:14px}
.x3-step{display:grid;grid-template-columns:120px 1fr;gap:18px;align-items:center;background:var(--bg2);border:1px solid var(--line);border-radius:18px;padding:12px}
.x3-step img{width:120px;height:90px;object-fit:cover;border-radius:10px}
.x3-step b{display:block;font-weight:800;font-size:17px;text-transform:uppercase;letter-spacing:.02em}
.x3-step b i{font-style:normal;color:var(--blue);margin-right:8px}
.x3-step span{display:block;margin-top:6px;font-weight:500;font-size:15px;line-height:1.45;color:var(--mute)}

/* offer */
.offer{display:grid;grid-template-columns:420px minmax(0,1fr);gap:clamp(32px,6vw,90px);align-items:center}
.book{position:relative;width:100%;max-width:420px;perspective:1600px}
.book__f{position:relative;transform:rotateY(-18deg) rotateX(2deg);transform-style:preserve-3d;border-radius:4px 8px 8px 4px;box-shadow:30px 50px 80px -20px rgba(0,0,0,.95)}
.book__f img{border-radius:4px 8px 8px 4px}
.book__f::before{content:"";position:absolute;top:1%;bottom:1%;right:-18px;width:20px;background:repeating-linear-gradient(90deg,#f1efe9 0 2px,#d9d5cc 2px 3px);transform:rotateY(70deg);transform-origin:left;border-radius:0 3px 3px 0}
.stack{list-style:none;margin:32px 0 0;padding:0;border-top:1px solid rgba(255,255,255,.3)}
.stack li{display:grid;grid-template-columns:28px 1fr;gap:12px;padding:16px 0;border-bottom:1px solid rgba(255,255,255,.3)}
.stack li::before{content:"✓";font-weight:900;font-size:18px}
.stack b{display:block;font-weight:800;font-size:17px;text-transform:uppercase;letter-spacing:.02em}
.stack span{display:block;margin-top:4px;font-weight:500;font-size:15px;opacity:.82}
.price{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-top:30px}
.price b{font-weight:900;font-size:clamp(52px,6vw,72px);letter-spacing:-.02em;line-height:1}
.price s{font-weight:700;font-size:26px;opacity:.6}
.price i{font-style:normal;background:#fff;color:var(--blue2);font-weight:900;font-size:15px;letter-spacing:.08em;padding:7px 12px;border-radius:999px}
.x3-deal{margin:10px 0 0;font-weight:700;font-size:15px;letter-spacing:.02em}

/* for you, faq */
.x3-two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,6vw,90px)}
.x3-ticks{list-style:none;margin:36px 0 0;padding:0}
.x3-ticks li{position:relative;padding:18px 0 18px 40px;border-bottom:1px solid var(--line);font-weight:600;font-size:18px;line-height:1.4}
.x3-ticks li::before{content:"";position:absolute;left:0;top:22px;width:22px;height:22px;border-radius:50%;background:var(--blue)}
.x3-faq{margin-top:36px}
.x3-faq details{border-bottom:1px solid var(--line)}
.x3-faq summary{cursor:pointer;list-style:none;padding:20px 40px 20px 0;position:relative;font-weight:800;font-size:17px;text-transform:uppercase;letter-spacing:.02em}
.x3-faq summary::-webkit-details-marker{display:none}
.x3-faq summary::after{content:"+";position:absolute;right:4px;top:14px;font-size:28px;color:var(--blue)}
.x3-faq details[open] summary::after{content:"−"}
.x3-faq p{margin:0 0 22px;font-weight:500;font-size:16px;line-height:1.55;color:var(--mute)}

/* offer card, funnel style */
