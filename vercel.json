    },
    "api/instagram.js": {
      "maxDuration": 60
    },
    "api/igtick.js": {
      "maxDuration": 60
    },
    "api/file.js": {
      "includeFiles": "private/learn/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/city/:action",
      "destination": "/api/city?action=:action"
    },
    {
      "source": "/city/:item(yacht|island)",
      "destination": "/city/auction/index.html"
    },
    {
      "source": "/city/:user",
