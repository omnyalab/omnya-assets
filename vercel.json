  "headers": [
    {
      "source": "/view/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/city/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/contract/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/whatsapp.js": {
      "maxDuration": 120
    },
    "api/instagram.js": {
      "maxDuration": 60
    },
    "api/igtick.js": {
      "maxDuration": 60
    },
    "api/drip.js": {
      "maxDuration": 60
    },
    "api/file.js": {
      "includeFiles": "private/learn/**"
    },
    "api/club.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/m/:t",
      "destination": "/api/drip?c=:t"
    },
    {
      "source": "/api/city/:action",
      "destination": "/api/city?action=:action"
    },
    {
      "source": "/api/club/:action",
      "destination": "/api/club?action=:action"
    },
    {
      "source": "/city/:item(yacht|island)",
      "destination": "/city/auction/index.html"
    },
    {
      "source": "/city/:user",
      "destination": "/city/house/index.html"
    },
    {
      "source": "/centrale",
      "destination": "/api/centrale"
    },
    {
      "source": "/centrale/:f*",
      "destination": "/api/centrale?f=:f*"
    },
    {
      "source": "/contract/:slug",
      "destination": "/contract/view/index.html"
    }
  ]
