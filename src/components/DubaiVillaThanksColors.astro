---
// 25/11 (Nico): the Dubai Villa thanks page (/learn/thanks/full-villa) in the colours of its funnel.
// Made by scripts/new-funnel from the Riyadh violet block of views/Thanks.astro. is:inline: only on that page.
---
<style is:inline>
  /* 17/11 (Nico): after paying for the Dubai Villa guide the page is in the colours of that funnel (villa orange, white text) */
  :root{--bg:#130b06;--ink:#ffffff;--mute:#cdaf9c;--mute-lg:#b19684;--line:#3c2b20}
  html,body{background:radial-gradient(900px 600px at 50% -8%,#d3540033,#0000 70%),#130b06!important;color:#fff}
  .oto .btn--fill,.oto-dl .btn--fill{background:#d35400!important;border-color:#d35400!important;color:#fff!important}
  .oto__steps .is-done span,.oto__steps .is-now span{background:#d35400!important;color:#fff!important;border-color:#d35400!important}
  .hdr .logo__img--dark{filter:invert(1)}
  .hdr::before{background:#130b06e6!important;border-bottom-color:#3c2b20!important}
  .hdr{color:#fff!important}
  .wa-fab{background:#d35400!important;color:#fff!important}
  html[data-page='thanks'] .oto-dl{background:linear-gradient(160deg,#ffffff1a,#ffffff08)!important;border:1px solid #ffffff26!important;-webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px);color:#fff!important;box-shadow:0 40px 80px -40px #d35400aa,inset 0 1px #ffffff33!important}
  html[data-page='thanks'] .oto-dl *{color:#fff}
  html[data-page='thanks'] .oto-dl .t-sub{color:#fff!important;-webkit-text-fill-color:#fff!important}
  html[data-page='thanks'] .oto-dl .oto-dl__note,html[data-page='thanks'] .oto-dl .oto-dl__note *{color:#cdaf9c!important}
  html[data-page='thanks'] .oto-dl .btn:not(.btn--fill){background:#ffffff14!important;border-color:#ffffff33!important;color:#fff!important}
  html[data-page='thanks'] .oto__down{background:#d35400!important}
  html[data-page='thanks'] .oto__head{display:none}
  html[data-page='thanks'] .oto__card{background:#24140a!important;border:1px solid #3c2b20;box-shadow:0 40px 70px -40px #d3540088!important;color:#fff}
  html[data-page='thanks'] .oto__card *{color:#fff}
  html[data-page='thanks'] .oto__card .t-sub,html[data-page='thanks'] .oto__card p{color:#dfc5b5}

</style>
